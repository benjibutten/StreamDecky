{
  "version": "2.0.0",
  "options": {
    "shell": {
      "executable": "pwsh",
      "args": [
        "-NoProfile",
        "-Command"
      ]
    }
  },
  "tasks": [
    {
      "label": "build StreamDecky (safe)",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/StreamDecky/StreamDecky.csproj",
        "-c",
        "Debug",
        "--disable-build-servers",
        "/nr:false"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "run StreamDecky (safe)",
      "type": "shell",
      "command": "Start-Process",
      "args": [
        "-FilePath",
        "${workspaceFolder}/StreamDecky/bin/Debug/net10.0-windows/StreamDecky.exe",
        "-WorkingDirectory",
        "${workspaceFolder}/StreamDecky"
      ],
      "dependsOn": "build StreamDecky (safe)",
      "problemMatcher": []
    }
  ]
}