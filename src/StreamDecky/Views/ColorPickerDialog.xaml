<Window x:Class="StreamDecky.Views.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose Color"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#1E1E2E"
        WindowStyle="None"
        PreviewKeyDown="Window_PreviewKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"
                      ResizeBorderThickness="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Background" Value="#2D2D44"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#3B3B5C" BorderThickness="1">
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="#16162A" Height="32">
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="Choose Color" Foreground="#CCCCCC" FontSize="13"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <Button DockPanel.Dock="Right" Content="✕" Click="Cancel_Click"
                            AutomationProperties.Name="Close"
                            Width="40" Height="32" FontSize="13"
                            Foreground="#999" Background="Transparent" BorderThickness="0" Cursor="Hand"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#C42B1C"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </DockPanel>
            </Border>

            <StackPanel Margin="16,14,16,16">
                <StackPanel Orientation="Horizontal">
                    <!-- Saturation runs left to right and brightness top to bottom, over the pure hue. -->
                    <Border CornerRadius="6" ClipToBounds="True" Width="280" Height="180" Cursor="Cross"
                            MouseLeftButtonDown="SaturationValue_MouseDown"
                            MouseMove="SaturationValue_MouseMove"
                            MouseLeftButtonUp="Area_MouseUp">
                        <Grid x:Name="SaturationValueArea" Width="280" Height="180">
                            <Rectangle x:Name="HueLayer" Fill="Red"/>
                            <Rectangle>
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="White" Offset="0"/>
                                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle>
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#00000000" Offset="0"/>
                                        <GradientStop Color="Black" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Canvas IsHitTestVisible="False">
                                <Ellipse x:Name="SaturationValueMarker" Width="14" Height="14"
                                         Stroke="White" StrokeThickness="2">
                                    <Ellipse.Effect>
                                        <DropShadowEffect ShadowDepth="0" BlurRadius="3" Opacity="0.8"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Canvas>
                        </Grid>
                    </Border>

                    <Border CornerRadius="6" ClipToBounds="True" Width="20" Height="180" Margin="12,0,0,0" Cursor="Hand"
                            MouseLeftButtonDown="Hue_MouseDown"
                            MouseMove="Hue_MouseMove"
                            MouseLeftButtonUp="Area_MouseUp">
                        <Grid x:Name="HueArea" Width="20" Height="180">
                            <Rectangle>
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FF0000" Offset="0"/>
                                        <GradientStop Color="#FFFF00" Offset="0.1667"/>
                                        <GradientStop Color="#00FF00" Offset="0.3333"/>
                                        <GradientStop Color="#00FFFF" Offset="0.5"/>
                                        <GradientStop Color="#0000FF" Offset="0.6667"/>
                                        <GradientStop Color="#FF00FF" Offset="0.8333"/>
                                        <GradientStop Color="#FF0000" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Canvas IsHitTestVisible="False">
                                <Border x:Name="HueMarker" Width="20" Height="6" CornerRadius="3"
                                        BorderBrush="White" BorderThickness="2">
                                    <Border.Effect>
                                        <DropShadowEffect ShadowDepth="0" BlurRadius="3" Opacity="0.8"/>
                                    </Border.Effect>
                                </Border>
                            </Canvas>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="RecentSection" Visibility="Collapsed" Margin="0,12,0,0">
                    <TextBlock Text="Recent" Foreground="#AAA" FontSize="12" Margin="0,0,0,6"/>
                    <WrapPanel x:Name="RecentColors" Width="312" HorizontalAlignment="Left"/>
                </StackPanel>

                <WrapPanel x:Name="Presets" Width="312" HorizontalAlignment="Left" Margin="0,12,0,0"/>

                <Grid Margin="0,12,0,0" Width="312" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Hex" Foreground="#AAA" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="HexBox" Grid.Column="1"
                             Background="#2D2D44" Foreground="White" FontSize="13" Padding="8,5"
                             BorderBrush="#444" BorderThickness="1" CaretBrush="White"
                             MaxLength="9"
                             TextChanged="HexBox_TextChanged"/>
                    <!-- Old colour on the left, new on the right, so the change is easy to judge. -->
                    <Border Grid.Column="2" Margin="10,0,0,0" CornerRadius="4" ClipToBounds="True"
                            BorderBrush="#444" BorderThickness="1" Height="30">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="OriginalSwatch" Width="36" ToolTip="Current color"/>
                            <Border x:Name="NewSwatch" Width="36" ToolTip="New color"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Content="Cancel" Click="Cancel_Click" Style="{StaticResource DialogButton}" Margin="0,0,8,0"/>
                    <Button Content="OK" Click="Ok_Click" Style="{StaticResource DialogButton}" Background="#6C5CE7" IsDefault="True"/>
                </StackPanel>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
