<Window x:Class="StreamDecky.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:StreamDecky.Helpers"
        Title="Settings"
        Width="420" Height="580"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E2E"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" 
                      ResizeBorderThickness="0" 
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <helpers:StringToBrushConverter x:Key="StringToBrush"/>
        <helpers:HasTextToVisibilityConverter x:Key="HasTextVisibility"/>

        <Style x:Key="ThinScrollBarThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#55FFFFFF" CornerRadius="3" Margin="1"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThinScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ThinScrollBarThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="6"/>
                    <Setter Property="MinHeight" Value="6"/>
                    <Setter Property="Width" Value="Auto"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DarkScrollViewer" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <ScrollContentPresenter/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       HorizontalAlignment="Right"
                                       Style="{StaticResource ThinScrollBar}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                       Margin="0,0,-14,0"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Custom Title Bar -->
        <Border DockPanel.Dock="Top" Background="#16162A" Height="32" MouseLeftButtonDown="SettingsTitleBar_MouseDown">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="12,0,0,0">
                    <Path Data="{StaticResource SettingsIconGeometry}" Fill="#CCCCCC"
                          Width="14" Height="14" Stretch="Uniform"
                          VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Settings" Foreground="#CCCCCC" FontSize="13"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="✕" Click="SettingsClose_Click"
                        Width="40" Height="32" FontSize="13"
                        Foreground="#999" Background="Transparent" BorderThickness="0" Cursor="Hand"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#C42B1C"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </DockPanel>
        </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource DarkScrollViewer}">
    <StackPanel Margin="24">
        <TextBlock Text="OVERLAY" Foreground="#666" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>

        <TextBlock Text="Background Color" Foreground="#AAA" FontSize="12" Margin="0,0,0,4"/>
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="30"/>
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding OverlayBackgroundColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                     Background="#2D2D44" Foreground="White" FontSize="13" Padding="8,6"
                     BorderBrush="#444" BorderThickness="1"/>
            <Border Grid.Column="1" 
                    Background="{Binding OverlayBackgroundColor, Converter={StaticResource StringToBrush}}"
                    CornerRadius="4" Margin="4,0,0,0"
                    BorderBrush="#444" BorderThickness="1"
                    Cursor="Hand"
                    MouseLeftButtonDown="OverlayBgColorPicker_Click"/>
        </Grid>

        <TextBlock Text="Background Image" Foreground="#AAA" FontSize="12" Margin="0,0,0,4"/>
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Background="#2D2D44" BorderBrush="#444" BorderThickness="1" CornerRadius="4" Padding="8,6">
                <TextBlock Text="{Binding OverlayBackgroundImagePath}" 
                           Foreground="#888" FontSize="12"
                           TextTrimming="CharacterEllipsis"/>
            </Border>
            <Button Grid.Column="1" Content="📂 Browse" 
                    Click="BgImageBrowse_Click"
                    Background="#2D2D44" Foreground="White"
                    FontSize="12" Padding="10,5" Margin="4,0,0,0"
                    BorderThickness="0" Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#3D3D54"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
            <Button Grid.Column="2" Content="✕" 
                    Click="BgImageClear_Click"
                    Background="#2D2D44" Foreground="#888"
                    FontSize="12" Padding="8,5" Margin="4,0,0,0"
                    BorderThickness="0" Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#3D3D54"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <TextBlock Text="Button Size" Foreground="#AAA" FontSize="12" Margin="0,0,0,4"/>
        <DockPanel Margin="0,0,0,14">
            <TextBlock DockPanel.Dock="Right" 
                       Text="{Binding ButtonSize, StringFormat={}{0:0}}" 
                       Foreground="#888" FontSize="12" Width="30" TextAlignment="Right" VerticalAlignment="Center"/>
            <Slider Value="{Binding ButtonSize, Mode=TwoWay}" 
                    Minimum="60" Maximum="200" 
                    TickFrequency="5" IsSnapToTickEnabled="True"/>
        </DockPanel>

        <TextBlock Text="Button Spacing" Foreground="#AAA" FontSize="12" Margin="0,0,0,4"/>
        <DockPanel Margin="0,0,0,14">
            <TextBlock DockPanel.Dock="Right" 
                       Text="{Binding ButtonSpacing, StringFormat={}{0:0}}" 
                       Foreground="#888" FontSize="12" Width="30" TextAlignment="Right" VerticalAlignment="Center"/>
            <Slider Value="{Binding ButtonSpacing, Mode=TwoWay}" 
                    Minimum="2" Maximum="30" 
                    TickFrequency="1" IsSnapToTickEnabled="True"/>
        </DockPanel>

        <TextBlock Text="Button Overlay Opacity" Foreground="#AAA" FontSize="12" Margin="0,0,0,4"/>
        <DockPanel Margin="0,0,0,14">
            <TextBlock DockPanel.Dock="Right"
                   Text="{Binding ButtonOverlayOpacity, StringFormat={}{0:0.00}}"
                   Foreground="#888" FontSize="12" Width="40" TextAlignment="Right" VerticalAlignment="Center"/>
            <Slider Value="{Binding ButtonOverlayOpacity, Mode=TwoWay}"
                Minimum="0.2" Maximum="1"
                TickFrequency="0.05"
                IsSnapToTickEnabled="False"/>
        </DockPanel>

                <Expander Header="Profile Grid — All Pages"
              IsExpanded="True"
              Margin="0,0,0,14"
              Background="#2D2D44"
              Foreground="White"
              BorderBrush="#444"
              BorderThickness="1"
              Padding="8,6">
            <StackPanel Margin="0,8,0,0">
            <TextBlock Text="{Binding LayoutSummary}" Foreground="#DDD" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="Only the selected profile. Changes apply to all of its regular pages and virtual layouts."
                   Foreground="#888" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,8"/>

            <DockPanel Margin="0,0,0,4">
                <TextBlock Text="Rows" Foreground="#AAA" FontSize="12" VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="-" Command="{Binding DecreaseRowsCommand}"
                    Width="22" Height="22"
                    Background="#1E1E2E" Foreground="#DDD"
                    BorderBrush="#444" BorderThickness="1"
                    Cursor="Hand"/>
                <Border Background="#1E1E2E" BorderBrush="#444" BorderThickness="1"
                    CornerRadius="3" Margin="4,0" MinWidth="34" Height="22">
                    <TextBlock Text="{Binding Rows}" Foreground="#DDD" FontSize="12"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>
                <Button Content="+" Command="{Binding IncreaseRowsCommand}"
                    Width="22" Height="22"
                    Background="#1E1E2E" Foreground="#DDD"
                    BorderBrush="#444" BorderThickness="1"
                    Cursor="Hand"/>
                </StackPanel>
            </DockPanel>
            <Slider Value="{Binding Rows, Mode=TwoWay}"
                Minimum="{Binding MinRows}"
                Maximum="{Binding MaxRows}"
                TickFrequency="1"
                IsSnapToTickEnabled="True"
                Margin="0,0,0,8"/>

            <DockPanel Margin="0,0,0,4">
                <TextBlock Text="Columns" Foreground="#AAA" FontSize="12" VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="-" Command="{Binding DecreaseColumnsCommand}"
                    Width="22" Height="22"
                    Background="#1E1E2E" Foreground="#DDD"
                    BorderBrush="#444" BorderThickness="1"
                    Cursor="Hand"/>
                <Border Background="#1E1E2E" BorderBrush="#444" BorderThickness="1"
                    CornerRadius="3" Margin="4,0" MinWidth="34" Height="22">
                    <TextBlock Text="{Binding Columns}" Foreground="#DDD" FontSize="12"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>
                <Button Content="+" Command="{Binding IncreaseColumnsCommand}"
                    Width="22" Height="22"
                    Background="#1E1E2E" Foreground="#DDD"
                    BorderBrush="#444" BorderThickness="1"
                    Cursor="Hand"/>
                </StackPanel>
            </DockPanel>
            <Slider Value="{Binding Columns, Mode=TwoWay}"
                Minimum="{Binding MinColumns}"
                Maximum="{Binding MaxColumns}"
                TickFrequency="1"
                IsSnapToTickEnabled="True"/>
            </StackPanel>
        </Expander>

        <!-- Separator -->
        <Border Height="1" Background="#333" Margin="0,0,0,16"/>

        <!-- Hotkey Section -->
        <TextBlock Text="HOTKEY" Foreground="#666" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>

        <TextBlock Text="Toggle Overlay" Foreground="#AAA" FontSize="12" Margin="0,0,0,4"/>
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Background="#2D2D44" BorderBrush="#444" BorderThickness="1" CornerRadius="4" Padding="8,6">
                <TextBlock Text="{Binding HotkeyDisplayText}" 
                           Foreground="#6C5CE7" 
                           FontSize="13" 
                           FontWeight="Bold"/>
            </Border>
            <Button x:Name="RecordHotkeyButton" 
                    Grid.Column="1" 
                    Content="⌨ Record" 
                    Click="RecordHotkey_Click"
                    Background="#2D2D44" Foreground="White"
                    FontSize="12" Padding="10,5" Margin="4,0,0,0"
                    BorderThickness="0" Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#3D3D54"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <!-- Separator -->
        <Border Height="1" Background="#333" Margin="0,0,0,16"/>

        <!-- Gamepad Section -->
        <TextBlock Text="GAMEPAD OVERLAY (OPTIONAL)" Foreground="#666" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>
        <CheckBox IsChecked="{Binding GamepadSupportEnabled, Mode=TwoWay}"
                  Content="Enable gamepad support (XInput)"
                  Foreground="#CCC" FontSize="13" Margin="0,0,0,8" Cursor="Hand"/>
        <TextBlock Text="Overlay activation combo"
                   Foreground="#AAA" FontSize="12" Margin="0,0,0,4"/>
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Background="#2D2D44" BorderBrush="#444" BorderThickness="1" CornerRadius="4" Padding="8,6">
                <TextBlock Text="{Binding GamepadToggleDisplayText}"
                           Foreground="#A7D3FF"
                           FontSize="13"
                           FontWeight="SemiBold"/>
            </Border>
            <Button x:Name="RecordGamepadComboButton"
                    Grid.Column="1"
                    Content="🎮 Record"
                    Click="RecordGamepadCombo_Click"
                    Background="#2D2D44"
                    Foreground="White"
                    FontSize="12"
                    Padding="10,5"
                    Margin="4,0,0,0"
                    BorderThickness="0"
                    Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#3D3D54"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
        <TextBlock Text="Click Record, press your desired gamepad button combo, then release to save it."
                   Foreground="#777" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"/>
        <TextBlock Text="Overlay controls: D-pad navigation, left stick fallback, A activates selected shortcut, LB/RB switches regular pages."
                   Foreground="#777" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <!-- Separator -->
        <Border Height="1" Background="#333" Margin="0,0,0,16"/>

        <!-- Startup Section -->
        <TextBlock Text="STARTUP" Foreground="#666" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>
        <CheckBox IsChecked="{Binding StartWithWindows, Mode=TwoWay}" 
                  Content="Start with Windows" 
                  Foreground="#CCC" FontSize="13" Margin="0,0,0,10" Cursor="Hand"/>

        <!-- Separator -->
        <Border Height="1" Background="#333" Margin="0,0,0,16"/>

        <!-- Typing Section -->
        <TextBlock Text="TYPING" Foreground="#666" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>
        <CheckBox IsChecked="{Binding NaturalTypingEnabled, Mode=TwoWay}"
                  Content="Natural simulate typing (experimental)"
                  Foreground="#CCC" FontSize="13" Margin="0,0,0,4" Cursor="Hand"/>
        <TextBlock Text="Adds burst/pause cadence in SimulateTyping mode. Keep off for max consistency."
                   Foreground="#777" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <!-- Separator -->
        <Border Height="1" Background="#333" Margin="0,0,0,16"/>

        <!-- Text Helper Section -->
        <TextBlock Text="TEXT HELPER (OVERLAY WIDGET)" Foreground="#666" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>
        <TextBlock Text="A dyslexia-friendly box in the overlay: write a line, press Ctrl+Enter (or Fix spelling) to let DeepSeek correct it, then copy it. Copy always works, corrected or not."
                   Foreground="#777" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <CheckBox IsChecked="{Binding TextHelperDarkTextArea, Mode=TwoWay}"
                  Content="Dark writing area"
                  Foreground="#CCC" FontSize="13" Margin="0,0,0,4" Cursor="Hand"/>
        <TextBlock Text="Off gives a warm off-white box, which most people with dyslexia read more easily. On matches the dark overlay instead."
                   Foreground="#777" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <TextBlock Text="Text Font" Foreground="#AAA" FontSize="12" Margin="0,0,0,4"/>
        <ComboBox IsEditable="True"
                  Text="{Binding TextHelperFontFamily, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                  ItemsSource="{Binding TextHelperFontOptions}"
                  Background="#2D2D44" Foreground="Black"
                  FontSize="13" Padding="6,4"
                  Margin="0,0,0,4"/>
        <TextBlock Text="Any installed font works — the listed ones just read well with dyslexia."
                   Foreground="#777" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <TextBlock Text="Text Size" Foreground="#AAA" FontSize="12" Margin="0,0,0,4"/>
        <DockPanel Margin="0,0,0,14">
            <TextBlock DockPanel.Dock="Right"
                       Text="{Binding TextHelperFontSize, StringFormat={}{0:0}}"
                       Foreground="#888" FontSize="12" Width="30" TextAlignment="Right" VerticalAlignment="Center"/>
            <Slider Value="{Binding TextHelperFontSize, Mode=TwoWay}"
                    Minimum="12" Maximum="30"
                    TickFrequency="1" IsSnapToTickEnabled="True"/>
        </DockPanel>

        <TextBlock Text="DeepSeek API Key" Foreground="#AAA" FontSize="12" Margin="0,0,0,4"/>
        <PasswordBox x:Name="DeepSeekApiKeyBox"
                     Loaded="DeepSeekApiKeyBox_Loaded"
                     PasswordChanged="DeepSeekApiKeyBox_PasswordChanged"
                     LostKeyboardFocus="DeepSeekApiKeyBox_LostKeyboardFocus"
                     Background="#2D2D44" Foreground="White" CaretBrush="White"
                     FontSize="13" Padding="8,6"
                     BorderBrush="#444" BorderThickness="1"
                     Margin="0,0,0,4"/>
        <TextBlock Text="Get a key at platform.deepseek.com. The key is saved when you click away from this box. It is encrypted for your Windows account in app-settings.json and is never included in a profile export. Spell checking sends the text in the widget to DeepSeek."
                   Foreground="#777" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <Button Content="Test Key"
                    Command="{Binding TestDeepSeekConnectionCommand}"
                    ToolTip="Sends one short sentence to DeepSeek to confirm the key and model work"
                    Background="#2D2D44" Foreground="White"
                    FontSize="12" Padding="12,6"
                    BorderThickness="0" Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#3D3D54"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
        <TextBlock Text="{Binding DeepSeekTestStatus}"
                   FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"
                   Visibility="{Binding DeepSeekTestStatus, Converter={StaticResource HasTextVisibility}}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#7BC48A"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDeepSeekTestError}" Value="True">
                            <Setter Property="Foreground" Value="#E36B6B"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <TextBlock Text="Model" Foreground="#AAA" FontSize="12" Margin="0,0,0,4"/>
        <TextBox Text="{Binding DeepSeekModel, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                 Background="#2D2D44" Foreground="White" CaretBrush="White"
                 FontSize="13" Padding="8,6"
                 BorderBrush="#444" BorderThickness="1"
                 Margin="0,0,0,4"/>
        <TextBlock Text="Default is deepseek-v4-flash. Change it only if DeepSeek renames or retires the model."
                   Foreground="#777" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <TextBlock Text="Thinking" Foreground="#AAA" FontSize="12" Margin="0,0,0,4"/>
        <ComboBox SelectedItem="{Binding SelectedSpellCheckThinkingOption, Mode=TwoWay}"
                  ItemsSource="{Binding SpellCheckThinkingOptions}"
                  Background="#2D2D44" Foreground="Black"
                  FontSize="13" Padding="6,4"
                  Margin="0,0,0,4"/>
        <TextBlock Text="DeepSeek reasons at high effort unless told otherwise, which costs seconds and tokens that fixing spelling does not need. Off is both the fastest and the cheapest, and is the default here. Raise it only if you find corrections coming back wrong."
                   Foreground="#777" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <DockPanel Margin="0,0,0,4">
            <TextBlock Text="Spell-Fix Prompt" Foreground="#AAA" FontSize="12" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right"
                    Content="Reset to default"
                    Command="{Binding ResetSpellCheckPromptCommand}"
                    IsEnabled="{Binding IsSpellCheckPromptCustomised}"
                    HorizontalAlignment="Right"
                    Background="#2D2D44" Foreground="#DDD"
                    FontSize="11" Padding="8,3"
                    BorderThickness="0" Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#3D3D54"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </DockPanel>
        <TextBox Text="{Binding SpellCheckPrompt, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 Height="150"
                 Background="#2D2D44" Foreground="White" CaretBrush="White"
                 FontSize="12" Padding="8,6"
                 BorderBrush="#444" BorderThickness="1"
                 Margin="0,0,0,4">
            <TextBox.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}"/>
            </TextBox.Resources>
        </TextBox>
        <TextBlock Text="This is the instruction sent with every spell fix. The text from the widget is sent separately, so keep the prompt about how to correct it."
                   Foreground="#777" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <!-- Separator -->
        <Border Height="1" Background="#333" Margin="0,0,0,16"/>

        <!-- Import/Export Section -->
        <TextBlock Text="IMPORT / EXPORT" Foreground="#666" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>
        <StackPanel Orientation="Horizontal">
            <Button Content="Import Profile (.json)"
                    Click="ImportProfile_Click"
                    ToolTip="Adds the file as a new profile. Your existing profiles are not changed."
                    Background="#3D5A3A" Foreground="White"
                    FontSize="12" Padding="12,7"
                    BorderThickness="0" Cursor="Hand"
                    HorizontalAlignment="Left"
                    Margin="0,0,8,0">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#4A6D49"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>

            <Button Content="Export Active Profile (.json)"
                    Click="ExportProfile_Click"
                    Background="#2D2D44" Foreground="White"
                    FontSize="12" Padding="12,7"
                    BorderThickness="0" Cursor="Hand"
                    HorizontalAlignment="Left">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#3D3D54"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
        <TextBlock Text="Import adds the file as a new profile and switches to it, so the editor will look different afterwards. Nothing is overwritten — your other profiles stay in the profile selector. Export writes the active profile only."
                   Foreground="#777" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/>
    </StackPanel>
    </ScrollViewer>
    </DockPanel>
</Window>
