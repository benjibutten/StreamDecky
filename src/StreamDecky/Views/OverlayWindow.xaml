<Window x:Class="StreamDecky.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:StreamDecky.Helpers"
        WindowStyle="None"
        AllowsTransparency="True"
        WindowState="Maximized"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        KeyDown="Window_KeyDown"
        Background="Transparent">

    <Window.Resources>
        <helpers:StringToBrushConverter x:Key="StringToBrush"/>
        <helpers:DoubleToCornerRadiusConverter x:Key="DoubleToCornerRadius"/>
        <helpers:SpacingToThicknessConverter x:Key="SpacingToThickness"/>
        <helpers:HasTextToVisibilityConverter x:Key="HasTextVisibility"/>
        <helpers:PathToImageSourceConverter x:Key="PathToImageSource"/>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <helpers:StringEqualsConverter x:Key="StringEquals"/>
        <helpers:ButtonShapeToGeometryConverter x:Key="ShapeToGeometry"/>
        <helpers:CellImageBrushConverter x:Key="CellImageBrush"/>
        <helpers:AdaptiveButtonSizeConverter x:Key="AdaptiveButtonSize"/>
        <helpers:CellClusterCornerRadiusConverter x:Key="CellClusterCornerRadius"/>
        <helpers:CornerClipConverter x:Key="CornerClip"/>

        <Style x:Key="TopMiniButton"
                TargetType="Button">
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Foreground"
                    Value="#F2F2F2"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Padding"
                    Value="6,2"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="#34FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="#46FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                    Value="False">
                                <Setter TargetName="Bd"
                                        Property="Opacity"
                                        Value="0.35"/>
                                <Setter Property="Foreground"
                                        Value="#88F2F2F2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuickFilterClearButton"
               TargetType="Button">
            <Setter Property="Foreground" Value="#AFC3D6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Opacity" Value="0.72"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#E5EEF7"/>
                                <Setter Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuickFilterChipToggleButton"
                TargetType="ToggleButton">
            <Setter Property="Background"
                    Value="#2AFFFFFF"/>
            <Setter Property="Foreground"
                    Value="#E6EEF8"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Padding"
                    Value="10,4"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Margin"
                    Value="0,0,6,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="#3AFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="#4A6EA0"/>
                                <Setter Property="Foreground"
                                        Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Music widget icon geometries (Material Design icon paths, shared with MicMixer) -->
        <Geometry x:Key="MusicIconPlay">M8,5.14V19.14L19,12.14L8,5.14Z</Geometry>
        <Geometry x:Key="MusicIconPause">M14,19H18V5H14M6,19H10V5H6V19Z</Geometry>
        <Geometry x:Key="MusicIconStop">M18,18H6V6H18V18Z</Geometry>
        <Geometry x:Key="MusicIconSkipPrev">M6,18V6H8V18H6M9.5,12L18,6V18L9.5,12Z</Geometry>
        <Geometry x:Key="MusicIconSkipNext">M16,18H18V6H16M6,18L14.5,12L6,6V18Z</Geometry>
        <Geometry x:Key="MusicIconTimedPlay">M13,2.05C18.05,2.55 22,6.82 22,12C22,17.18 18.05,21.45 13,21.95V19.93C16.95,19.44 20,16.08 20,12C20,7.92 16.95,4.56 13,4.07V2.05M11,2.05V4.07C9.43,4.27 8,4.89 6.77,5.82L5.36,4.36C7,3.11 8.87,2.3 11,2.05M4.36,5.36L5.82,6.77C4.89,8 4.27,9.43 4.07,11H2.05C2.3,8.87 3.11,7 4.36,5.36M2.05,13H4.07C4.27,14.57 4.89,16 5.82,17.23L4.36,18.64C3.11,17 2.3,15.13 2.05,13M6.77,18.18C8,19.11 9.43,19.73 11,19.93V21.95C8.87,21.7 7,20.89 5.36,19.64L6.77,18.18M16,12L10,16V8L16,12Z</Geometry>
        <Geometry x:Key="MusicIconSingleTrack">M14,17H12V9H10V7H14V17M19,3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3M19,19H5V5H19V19Z</Geometry>
        <Geometry x:Key="MusicIconLink">M3.9,12C3.9,10.29 5.29,8.9 7,8.9H11V7H7A5,5 0 0,0 2,12A5,5 0 0,0 7,17H11V15.1H7C5.29,15.1 3.9,13.71 3.9,12M8,13H16V11H8V13M17,7H13V8.9H17C18.71,8.9 20.1,10.29 20.1,12C20.1,13.71 18.71,15.1 17,15.1H13V17H17A5,5 0 0,0 22,12A5,5 0 0,0 17,7Z</Geometry>
        <Geometry x:Key="MusicIconClose">M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z</Geometry>
        <Geometry x:Key="MusicIconRefresh">M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z</Geometry>
        <Geometry x:Key="MusicIconChevronDown">M7.41,8.58L12,13.17L16.59,8.58L18,10L12,16L6,10L7.41,8.58Z</Geometry>
        <Geometry x:Key="MusicIconChevronUp">M7.41,15.41L12,10.83L16.59,15.41L18,14L12,8L6,14L7.41,15.41Z</Geometry>
        <Geometry x:Key="MusicIconPlus">M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z</Geometry>
        <Geometry x:Key="MusicIconNote">M12,3V13.55A4,4 0 0,0 10,13A4,4 0 0,0 6,17A4,4 0 0,0 10,21A4,4 0 0,0 14,17V7H18V3H12Z</Geometry>
        <Geometry x:Key="MusicIconHeadphones">M12,1C7,1 3,5 3,10V17A3,3 0 0,0 6,20H9V12H5V10A7,7 0 0,1 12,3A7,7 0 0,1 19,10V12H15V20H18A3,3 0 0,0 21,17V10C21,5 17,1 12,1Z</Geometry>
        <Geometry x:Key="MusicIconSlash">M3,4.27L4.27,3L21,19.73L19.73,21L3,4.27Z</Geometry>
        <Geometry x:Key="MusicIconMinimize">M20,14H4V10H20V14Z</Geometry>
        <Geometry x:Key="MusicIconRestore">M4,8H8V4H20V16H16V20H4V8M16,8V14H18V6H10V8H16M6,12V18H14V12H6Z</Geometry>
        <Geometry x:Key="FormsIconClipboard">M19,3H14.82C14.4,1.84 13.3,1 12,1C10.7,1 9.6,1.84 9.18,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M12,3A1,1 0 0,1 13,4A1,1 0 0,1 12,5A1,1 0 0,1 11,4A1,1 0 0,1 12,3M7,7H17V9H7V7M7,11H17V13H7V11M7,15H13V17H7V15Z</Geometry>
        <Geometry x:Key="FormsIconCopy">M19,21H8V7H19M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1Z</Geometry>
        <Geometry x:Key="FormsIconCheck">M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z</Geometry>

        <Style x:Key="FormsKeyboardFocusVisual" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Control">
                        <Border BorderBrush="#C9E5FF"
                                BorderThickness="2"
                                CornerRadius="7"
                                Margin="-3"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MusicTransportButton"
                TargetType="Button">
            <Setter Property="Background"
                    Value="#2AFFFFFF"/>
            <Setter Property="Foreground"
                    Value="#E6EEF8"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Width"
                    Value="34"/>
            <Setter Property="Height"
                    Value="30"/>
            <Setter Property="FontSize"
                    Value="13"/>
            <Setter Property="Padding"
                    Value="0"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="#3AFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="#46FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                    Value="False">
                                <Setter TargetName="Bd"
                                        Property="Opacity"
                                        Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MusicPrimaryTransportButton"
                TargetType="Button"
                BasedOn="{StaticResource MusicTransportButton}">
            <Setter Property="Background"
                    Value="#6C5CE7"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="Width"
                    Value="44"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="#7C6CF7"/>
                            </Trigger>
                            <Trigger Property="IsPressed"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="#5C4CD7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                    Value="False">
                                <Setter TargetName="Bd"
                                        Property="Opacity"
                                        Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MusicFolderChipButton"
                TargetType="Button">
            <Setter Property="Background"
                    Value="#2AFFFFFF"/>
            <Setter Property="Foreground"
                    Value="#E6EEF8"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Padding"
                    Value="10,4"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Margin"
                    Value="0,0,6,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="#3AFFFFFF"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="#4A6EA0"/>
                                <Setter Property="Foreground"
                                        Value="White"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Minimal scrollbar used inside the music widget. The transparent
             track avoids the bright native WPF gutter against the dark panel. -->
        <Style x:Key="MusicScrollPageButton"
                TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle"
                    Value="True"/>
            <Setter Property="Focusable"
                    Value="False"/>
            <Setter Property="IsTabStop"
                    Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Rectangle Fill="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ControlTemplate x:Key="MusicScrollThumb"
                TargetType="Thumb">
            <Border x:Name="ThumbBackground"
                    Background="#708B7CF7"
                    CornerRadius="3"/>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver"
                        Value="True">
                    <Setter TargetName="ThumbBackground"
                            Property="Background"
                            Value="#A0A89BFF"/>
                </Trigger>
                <Trigger Property="IsDragging"
                        Value="True">
                    <Setter TargetName="ThumbBackground"
                            Property="Background"
                            Value="#D0B9A8F5"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="MusicScrollBar"
                TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle"
                    Value="True"/>
            <Setter Property="Width"
                    Value="6"/>
            <Setter Property="MinWidth"
                    Value="6"/>
            <Setter Property="Margin"
                    Value="3,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource MusicScrollPageButton}"
                                                  Command="ScrollBar.PageUpCommand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource MusicScrollPageButton}"
                                                  Command="ScrollBar.PageDownCommand"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Template="{StaticResource MusicScrollThumb}"
                                           Margin="1,3"
                                           MinHeight="24"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Full screen overlay background with slight transparency -->
    <Grid Background="#20808080">

        <!-- Top bar with close button -->
        <DockPanel VerticalAlignment="Top"
                Margin="20,15,20,0"
                Panel.ZIndex="10">
            <Button Content="✕ Close (Esc)"
                    DockPanel.Dock="Right"
                    Click="CloseButton_Click"
                    Background="#44FFFFFF"
                    Foreground="White"
                    BorderThickness="0"
                    Padding="16,8"
                    FontSize="14"
                    Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter Property="Background"
                                        Value="#66FFFFFF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Border DockPanel.Dock="Right"
                    Margin="0,0,8,0"
                    Padding="6,4"
                    Background="#22000000"
                    CornerRadius="6">
                <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">
                    <TextBlock Text="Areas"
                               Foreground="#DCDCDC"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="4,0,8,0"/>
                    <Button Content="◀"
                            Command="{Binding PreviousNotePageCommand}"
                            IsEnabled="{Binding CanGoToPreviousNotePage}"
                            FontSize="12"
                            Style="{StaticResource TopMiniButton}"/>
                    <TextBlock Text="{Binding NotePageIndicator}"
                               Foreground="#ECECEC"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="6,0"/>
                    <Button Content="▶"
                            Command="{Binding NextNotePageCommand}"
                            IsEnabled="{Binding CanGoToNextNotePage}"
                            FontSize="12"
                            Style="{StaticResource TopMiniButton}"/>
                </StackPanel>
            </Border>

            <Button DockPanel.Dock="Right"
                    Command="{Binding ToggleFormsPanelCommand}"
                    ToolTip="Show or hide the forms panel"
                    Foreground="#EEEEEE"
                    BorderThickness="0"
                    Padding="12,8"
                    Margin="0,0,8,0"
                    FontSize="13"
                    Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background"
                                Value="#2F000000"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding FormsPanelVisible}"
                                                Value="True">
                                            <Setter TargetName="Bd"
                                                    Property="Background"
                                                    Value="#4A6EA0"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver"
                                                Value="True">
                                            <Setter TargetName="Bd"
                                                    Property="Background"
                                                    Value="#4A000000"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource FormsIconClipboard}"
                          Width="11"
                          Height="11"
                          Stretch="Uniform"
                          Fill="#EEEEEE"
                          VerticalAlignment="Center"
                          Margin="0,0,6,0"/>
                    <TextBlock Text="Forms"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button DockPanel.Dock="Right"
                    Command="{Binding ToggleMusicWidgetCommand}"
                    ToolTip="Show or hide the MicMixer music widget"
                    Foreground="#EEEEEE"
                    BorderThickness="0"
                    Padding="12,8"
                    Margin="0,0,8,0"
                    FontSize="13"
                    Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background"
                                Value="#2F000000"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding MusicWidgetVisible}"
                                                Value="True">
                                            <Setter TargetName="Bd"
                                                    Property="Background"
                                                    Value="#4A6EA0"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver"
                                                Value="True">
                                            <Setter TargetName="Bd"
                                                    Property="Background"
                                                    Value="#4A000000"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource MusicIconNote}"
                          Width="11"
                          Height="11"
                          Stretch="Uniform"
                          Fill="#EEEEEE"
                          VerticalAlignment="Center"
                          Margin="0,0,6,0"/>
                    <TextBlock Text="Music"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button Content="＋ Note"
                    DockPanel.Dock="Right"
                    Command="{Binding AddStickyNoteCommand}"
                    Background="#2F000000"
                    Foreground="#EEEEEE"
                    BorderThickness="0"
                    Padding="12,8"
                    Margin="0,0,8,0"
                    FontSize="13"
                    Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter Property="Background"
                                        Value="#4A000000"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <StackPanel DockPanel.Dock="Right"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="0,0,12,0">
                <Path Data="M1,0 H3 A1,1,0,0,1,4,1 V3 A1,1,0,0,1,3,4 H1 A1,1,0,0,1,0,3 V1 A1,1,0,0,1,1,0 Z M6,0 H8 A1,1,0,0,1,9,1 V3 A1,1,0,0,1,8,4 H6 A1,1,0,0,1,5,3 V1 A1,1,0,0,1,6,0 Z M1,5 H3 A1,1,0,0,1,4,6 V8 A1,1,0,0,1,3,9 H1 A1,1,0,0,1,0,8 V6 A1,1,0,0,1,1,5 Z M6,5 H8 A1,1,0,0,1,9,6 V8 A1,1,0,0,1,8,9 H6 A1,1,0,0,1,5,8 V6 A1,1,0,0,1,6,5 Z"
                      Fill="#AAAAAA"
                        Width="16"
                        Height="16"
                        Stretch="Uniform"
                        Margin="0,0,8,0"/>
                <TextBlock Text="StreamDecky"
                           Foreground="#AAAAAA"
                           FontSize="16"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>
                <TextBlock Text=" • "
                           Foreground="#7F8FA2"
                           FontSize="14"
                           VerticalAlignment="Center"
                           Margin="6,0,4,0"/>
                <TextBlock Text="{Binding ActiveProfileName}"
                           Foreground="#B7C7D8"
                           FontSize="12"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>
            </StackPanel>

            <Border/>
        </DockPanel>

        <!-- Draggable button grid container -->
        <Border x:Name="ButtonGridContainer"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="Transparent"
                Padding="0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="GridTranslate"
                                    X="{Binding GridOffsetX, Mode=TwoWay}"
                                    Y="{Binding GridOffsetY, Mode=TwoWay}"/>
            </Border.RenderTransform>

            <StackPanel>
                <!-- Drag handle (visible only on hover) -->
                <Border x:Name="DragHandle"
                        CornerRadius="6,6,0,0"
                        Padding="0,6"
                        Cursor="SizeAll"
                        MouseLeftButtonDown="DragHandle_MouseLeftButtonDown"
                        MouseMove="DragHandle_MouseMove"
                        MouseLeftButtonUp="DragHandle_MouseLeftButtonUp">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background"
                                    Value="Transparent"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver"
                                        Value="True">
                                    <Setter Property="Background"
                                            Value="#22FFFFFF"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center"
                            Orientation="Horizontal">
                        <Border Width="40"
                                Height="4"
                                CornerRadius="2">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background"
                                            Value="Transparent"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=DragHandle}"
                                                Value="True">
                                            <Setter Property="Background"
                                                    Value="#44FFFFFF"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Deck button grid -->
                <Border x:Name="GridClipBorder"
                        Background="Transparent"
                        CornerRadius="12"
                        Padding="0"
                        Opacity="{Binding ButtonOverlayOpacity}">
                    <Grid>
                        <Grid.Clip>
                            <MultiBinding Converter="{StaticResource CornerClip}"
                                    ConverterParameter="12">
                                <Binding Path="ActualWidth"
                                        ElementName="GridClipBorder"/>
                                <Binding Path="ActualHeight"
                                        ElementName="GridClipBorder"/>
                            </MultiBinding>
                        </Grid.Clip>
                        <ItemsControl ItemsSource="{Binding Buttons}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="{Binding Columns}"
                                            Rows="{Binding Rows}"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- CellBg fills the entire UniformGrid cell, slight overlap kills hairline gaps -->
                                    <Border x:Name="CellBg"
                                            Margin="-1"
                                            ClipToBounds="True"
                                            Background="{Binding DataContext.OverlayBackgroundColor, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource StringToBrush}}">
                                        <Border.CornerRadius>
                                            <MultiBinding Converter="{StaticResource CellClusterCornerRadius}"
                                                    ConverterParameter="14">
                                                <Binding Path="Index"/>
                                                <Binding Path="DataContext.Columns"
                                                        RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                <Binding Path="DataContext.Rows"
                                                        RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                <Binding Path="DataContext.Buttons"
                                                        RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                <Binding Path="DataContext.ButtonVisualVersion"
                                                        RelativeSource="{RelativeSource AncestorType=Window}"/>
                                            </MultiBinding>
                                        </Border.CornerRadius>
                                        <Grid>
                                            <!-- Global background image portion for this cell -->
                                            <Border x:Name="BgImageLayer">
                                                <Border.Background>
                                                    <MultiBinding Converter="{StaticResource CellImageBrush}">
                                                        <Binding Path="DataContext.OverlayBackgroundImagePath"
                                                                RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                        <Binding Path="Index"/>
                                                        <Binding Path="DataContext.Columns"
                                                                RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                        <Binding Path="DataContext.Rows"
                                                                RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                        <Binding Path="DataContext.OverlayBackgroundImageVersion"
                                                                RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                    </MultiBinding>
                                                </Border.Background>
                                                <Border.CornerRadius>
                                                    <MultiBinding Converter="{StaticResource CellClusterCornerRadius}"
                                                            ConverterParameter="14">
                                                        <Binding Path="Index"/>
                                                        <Binding Path="DataContext.Columns"
                                                                RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                        <Binding Path="DataContext.Rows"
                                                                RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                        <Binding Path="DataContext.Buttons"
                                                                RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                        <Binding Path="DataContext.ButtonVisualVersion"
                                                                RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                    </MultiBinding>
                                                </Border.CornerRadius>
                                            </Border>
                                            <!-- Button content with spacing margin -->
                                            <Button x:Name="CellButton"
                                                    Margin="{Binding DataContext.ButtonSpacing, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SpacingToThickness}}"
                                                    Click="DeckButton_Click"
                                                    Tag="{Binding}"
                                                    Cursor="Hand">
                                                <Button.Width>
                                                    <MultiBinding Converter="{StaticResource AdaptiveButtonSize}"
                                                            ConverterParameter="180,220,22">
                                                        <Binding Path="DataContext.ButtonSize"
                                                                RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                        <Binding Path="DataContext.ButtonSpacing"
                                                                RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                        <Binding Path="DataContext.Columns"
                                                                RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                        <Binding Path="DataContext.Rows"
                                                                RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                        <Binding Path="ActualWidth"
                                                                RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                        <Binding Path="ActualHeight"
                                                                RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                    </MultiBinding>
                                                </Button.Width>
                                                <Button.Height>
                                                    <MultiBinding Converter="{StaticResource AdaptiveButtonSize}"
                                                            ConverterParameter="180,220,22">
                                                        <Binding Path="DataContext.ButtonSize"
                                                                RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                        <Binding Path="DataContext.ButtonSpacing"
                                                                RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                        <Binding Path="DataContext.Columns"
                                                                RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                        <Binding Path="DataContext.Rows"
                                                                RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                        <Binding Path="ActualWidth"
                                                                RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                        <Binding Path="ActualHeight"
                                                                RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                    </MultiBinding>
                                                </Button.Height>
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Grid>
                                                                        <!-- Regular background (non-shaped) -->
                                                                        <Border x:Name="RegularBg"
                                                                                CornerRadius="{Binding CornerRadius, Converter={StaticResource DoubleToCornerRadius}}"
                                                                                BorderThickness="2"
                                                                                BorderBrush="Transparent"
                                                                                Background="{Binding BackgroundColor, Converter={StaticResource StringToBrush}}">
                                                                            <Grid>
                                                                                <Grid.Clip>
                                                                                    <MultiBinding Converter="{StaticResource CornerClip}">
                                                                                        <Binding Path="ActualWidth"
                                                                                                RelativeSource="{RelativeSource Self}"/>
                                                                                        <Binding Path="ActualHeight"
                                                                                                RelativeSource="{RelativeSource Self}"/>
                                                                                        <Binding Path="CornerRadius"/>
                                                                                    </MultiBinding>
                                                                                </Grid.Clip>
                                                                                <Image Source="{Binding ImagePath, Converter={StaticResource PathToImageSource}, ConverterParameter=256}"
                                                                                       Stretch="UniformToFill"
                                                                                       Visibility="{Binding ImagePath, Converter={StaticResource HasTextVisibility}}"/>
                                                                                <StackPanel VerticalAlignment="Center"
                                                                                        HorizontalAlignment="Center">
                                                                                    <TextBlock Text="{Binding IconText}"
                                                                                               FontSize="24"
                                                                                               HorizontalAlignment="Center"
                                                                                               Foreground="{Binding TextColor, Converter={StaticResource StringToBrush}}"
                                                                                               Visibility="{Binding IconText, Converter={StaticResource HasTextVisibility}}"/>
                                                                                    <TextBlock Text="{Binding DisplayTitle}"
                                                                                               FontSize="13"
                                                                                               TextWrapping="Wrap"
                                                                                               TextAlignment="Center"
                                                                                               HorizontalAlignment="Center"
                                                                                               Foreground="{Binding TextColor, Converter={StaticResource StringToBrush}}"
                                                                                               Margin="4,2,4,0"/>
                                                                                </StackPanel>
                                                                            </Grid>
                                                                        </Border>
                                                                        <!-- Shape background (shaped buttons) -->
                                                                        <Grid x:Name="ShapeGrid"
                                                                                Visibility="Collapsed">
                                                                            <Path x:Name="ShapeBg"
                                                                                  Data="{Binding Shape, Converter={StaticResource ShapeToGeometry}}"
                                                                                  Fill="{Binding BackgroundColor, Converter={StaticResource StringToBrush}}"
                                                                                  Stretch="Fill"
                                                                                  StrokeThickness="2"
                                                                                  Stroke="Transparent"/>
                                                                            <StackPanel VerticalAlignment="Center"
                                                                                    HorizontalAlignment="Center"
                                                                                    Margin="15">
                                                                                <TextBlock Text="{Binding IconText}"
                                                                                           FontSize="24"
                                                                                           HorizontalAlignment="Center"
                                                                                           Foreground="{Binding TextColor, Converter={StaticResource StringToBrush}}"
                                                                                           Visibility="{Binding IconText, Converter={StaticResource HasTextVisibility}}"/>
                                                                                <TextBlock Text="{Binding DisplayTitle}"
                                                                                           FontSize="13"
                                                                                           TextWrapping="Wrap"
                                                                                           TextAlignment="Center"
                                                                                           HorizontalAlignment="Center"
                                                                                           Foreground="{Binding TextColor, Converter={StaticResource StringToBrush}}"
                                                                                           Margin="4,2,4,0"/>
                                                                            </StackPanel>
                                                                        </Grid>
                                                                    </Grid>
                                                                    <ControlTemplate.Triggers>
                                                                        <DataTrigger Binding="{Binding HasShape}"
                                                                                Value="True">
                                                                            <Setter TargetName="RegularBg"
                                                                                    Property="Visibility"
                                                                                    Value="Collapsed"/>
                                                                            <Setter TargetName="ShapeGrid"
                                                                                    Property="Visibility"
                                                                                    Value="Visible"/>
                                                                        </DataTrigger>
                                                                        <Trigger Property="IsMouseOver"
                                                                                Value="True">
                                                                            <Setter TargetName="RegularBg"
                                                                                    Property="BorderBrush"
                                                                                    Value="#88FFFFFF"/>
                                                                            <Setter TargetName="ShapeBg"
                                                                                    Property="Stroke"
                                                                                    Value="#88FFFFFF"/>
                                                                        </Trigger>
                                                                        <Trigger Property="IsPressed"
                                                                                Value="True">
                                                                            <Setter TargetName="RegularBg"
                                                                                    Property="Opacity"
                                                                                    Value="0.8"/>
                                                                            <Setter TargetName="ShapeBg"
                                                                                    Property="Opacity"
                                                                                    Value="0.8"/>
                                                                        </Trigger>
                                                                        <DataTrigger Binding="{Binding IsSelected}"
                                                                                Value="True">
                                                                            <Setter TargetName="RegularBg"
                                                                                    Property="BorderBrush"
                                                                                    Value="#6C5CE7"/>
                                                                            <Setter TargetName="RegularBg"
                                                                                    Property="BorderThickness"
                                                                                    Value="3"/>
                                                                            <Setter TargetName="ShapeBg"
                                                                                    Property="Stroke"
                                                                                    Value="#6C5CE7"/>
                                                                            <Setter TargetName="ShapeBg"
                                                                                    Property="StrokeThickness"
                                                                                    Value="3"/>
                                                                        </DataTrigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsConfigured}"
                                                Value="False">
                                            <Setter TargetName="CellBg"
                                                    Property="Background"
                                                    Value="Transparent"/>
                                            <Setter TargetName="BgImageLayer"
                                                    Property="Visibility"
                                                    Value="Collapsed"/>
                                            <Setter TargetName="CellButton"
                                                    Property="Visibility"
                                                    Value="Hidden"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </Grid>
                </Border>

                <!-- Subtle page navigator near buttons -->
                <Border Margin="2,9,0,0"
                        HorizontalAlignment="Left"
                        Padding="8,4"
                        Background="#16000000"
                        CornerRadius="7"
                        Visibility="{Binding HasMultiplePages, Converter={StaticResource BoolToVisibility}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Opacity"
                                    Value="0.58"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver"
                                        Value="True">
                                    <Setter Property="Opacity"
                                            Value="1"/>
                                    <Setter Property="Background"
                                            Value="#34000000"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                        <Button Content="◀"
                                Click="OverlayPrevPage_Click"
                                Background="Transparent"
                                Foreground="#F2F2F2"
                                FontSize="13"
                                Padding="8,3"
                                BorderThickness="0"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="4"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver"
                                                            Value="True">
                                                        <Setter TargetName="Bd"
                                                                Property="Background"
                                                                Value="#48FFFFFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                        <TextBlock Text="{Binding PageIndicator}"
                                Foreground="#F2F2F2"
                                FontSize="12"
                                   VerticalAlignment="Center"
                                Margin="8,0"/>
                        <Button Content="▶"
                                Click="OverlayNextPage_Click"
                                Background="Transparent"
                                Foreground="#F2F2F2"
                                FontSize="13"
                                Padding="8,3"
                                BorderThickness="0"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="4"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver"
                                                            Value="True">
                                                        <Setter TargetName="Bd"
                                                                Property="Background"
                                                                Value="#48FFFFFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Sticky notes layer (per page) -->
        <ItemsControl ItemsSource="{Binding StickyNotes}"
                      Margin="0"
                      Panel.ZIndex="8">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left"
                            Value="{Binding X}"/>
                    <Setter Property="Canvas.Top"
                            Value="{Binding Y}"/>
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Width="{Binding Width}"
                            Height="{Binding DisplayHeight}"
                            Opacity="{Binding DataContext.ButtonOverlayOpacity, RelativeSource={RelativeSource AncestorType=Window}}"
                            Background="{Binding Color, Converter={StaticResource StringToBrush}}"
                            CornerRadius="10"
                            BorderBrush="#20000000"
                            BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14"
                                    ShadowDepth="5"
                                    Opacity="0.3"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="28"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="#17000000"
                                    CornerRadius="10,10,0,0"
                                    Cursor="SizeAll"
                                    MouseLeftButtonDown="StickyNoteHandle_MouseLeftButtonDown"
                                    MouseMove="StickyNoteHandle_MouseMove"
                                    MouseLeftButtonUp="StickyNoteHandle_MouseLeftButtonUp">
                                <DockPanel LastChildFill="True"
                                        Margin="6,0,6,0">
                                    <StackPanel DockPanel.Dock="Right"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                        <Button Tag="#F8E784"
                                                Click="StickyNoteColor_Click"
                                                Background="#F8E784"
                                                BorderBrush="#44000000"
                                                BorderThickness="1"
                                                Width="14"
                                                Height="14"
                                                Margin="0,0,4,0"
                                                Cursor="Hand"/>
                                        <Button Tag="#F7B3A9"
                                                Click="StickyNoteColor_Click"
                                                Background="#F7B3A9"
                                                BorderBrush="#44000000"
                                                BorderThickness="1"
                                                Width="14"
                                                Height="14"
                                                Margin="0,0,4,0"
                                                Cursor="Hand"/>
                                        <Button Tag="#AEE2FF"
                                                Click="StickyNoteColor_Click"
                                                Background="#AEE2FF"
                                                BorderBrush="#44000000"
                                                BorderThickness="1"
                                                Width="14"
                                                Height="14"
                                                Margin="0,0,4,0"
                                                Cursor="Hand"/>
                                        <Button Tag="#D4F7B0"
                                                Click="StickyNoteColor_Click"
                                                Background="#D4F7B0"
                                                BorderBrush="#44000000"
                                                BorderThickness="1"
                                                Width="14"
                                                Height="14"
                                                Margin="0,0,8,0"
                                                Cursor="Hand"/>
                                        <Button Click="StickyNoteMinimize_Click"
                                                Background="Transparent"
                                                Foreground="#4C4C4C"
                                                BorderThickness="0"
                                                FontSize="11"
                                                Padding="0"
                                                Width="18"
                                                Height="18"
                                                Margin="0,0,4,0"
                                                Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Content"
                                                            Value="_"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMinimized}"
                                                                Value="True">
                                                            <Setter Property="Content"
                                                                    Value="[]"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="✕"
                                                Click="StickyNoteRemove_Click"
                                                Background="Transparent"
                                                Foreground="#4C4C4C"
                                                BorderThickness="0"
                                                FontSize="11"
                                                Padding="0"
                                                Width="18"
                                                Height="18"
                                                Cursor="Hand"/>
                                    </StackPanel>
                                    <Grid VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}"
                                                   Foreground="#4A4A4A"
                                                   FontWeight="SemiBold"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding IsEditingTitle, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"/>
                                        <TextBox Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                 Tag="StickyNoteTitleEditor"
                                                 Foreground="#2D2D2D"
                                                 FontSize="11"
                                                 FontWeight="SemiBold"
                                                 BorderThickness="0"
                                                 Padding="2,0"
                                                 Background="#17FFFFFF"
                                                 VerticalContentAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 Visibility="{Binding IsEditingTitle, Converter={StaticResource BoolToVisibility}}"
                                                 LostKeyboardFocus="StickyNoteTitleEditor_LostKeyboardFocus"
                                                 KeyDown="StickyNoteTitleEditor_KeyDown"/>
                                    </Grid>
                                </DockPanel>
                            </Border>

                            <TextBox Grid.Row="1"
                                     Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     MouseDoubleClick="StickyNoteText_MouseDoubleClick"
                                     Visibility="{Binding IsMinimized, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Foreground="#2D2D2D"
                                     Margin="10,8,10,10"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Hidden"
                                     HorizontalScrollBarVisibility="Disabled"
                                     FontSize="{Binding DataContext.StickyNoteFontSize, RelativeSource={RelativeSource AncestorType=Window}}"/>

                            <!-- Invisible resize hit areas centered on both outer bottom corners. -->
                            <Border Grid.RowSpan="2"
                                    Width="14"
                                    Height="14"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"
                                    Margin="-7,0,0,-7"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="SizeNESW"
                                    Visibility="{Binding IsMinimized, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"
                                    MouseLeftButtonDown="StickyNoteResizeHandle_MouseLeftButtonDown"
                                    MouseMove="StickyNoteResizeHandle_MouseMove"
                                    MouseLeftButtonUp="StickyNoteResizeHandle_MouseLeftButtonUp"/>
                            <Border Grid.RowSpan="2"
                                    Width="14"
                                    Height="14"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,-7,-7"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="SizeNWSE"
                                    Panel.ZIndex="20"
                                    Visibility="{Binding IsMinimized, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"
                                    MouseLeftButtonDown="StickyNoteResizeRightHandle_MouseLeftButtonDown"
                                    MouseMove="StickyNoteResizeRightHandle_MouseMove"
                                    MouseLeftButtonUp="StickyNoteResizeRightHandle_MouseLeftButtonUp"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border x:Name="QuickTextPanel"
                Width="{Binding QuickTextPanelWidth, Mode=TwoWay}"
            Height="{Binding QuickTextPanelHeight, Mode=TwoWay}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="0"
                Panel.ZIndex="9"
                Visibility="{Binding HasAnyQuickTextItems, Converter={StaticResource BoolToVisibility}}"
                Background="{Binding OverlayBackgroundColor, Converter={StaticResource StringToBrush}}"
                Opacity="{Binding ButtonOverlayOpacity}"
                BorderBrush="#44FFFFFF"
                BorderThickness="1"
                CornerRadius="10">
            <Border.RenderTransform>
                <TranslateTransform X="{Binding QuickTextPanelX, Mode=TwoWay}"
                                    Y="{Binding QuickTextPanelY, Mode=TwoWay}"/>
            </Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Rectangle Grid.RowSpan="2"
                           Opacity="0.78"
                           Visibility="{Binding OverlayBackgroundImagePath, Converter={StaticResource HasTextVisibility}}">
                    <Rectangle.Fill>
                        <ImageBrush ImageSource="{Binding OverlayBackgroundImagePath, Converter={StaticResource PathToImageSource}}"
                                    Stretch="UniformToFill"/>
                    </Rectangle.Fill>
                </Rectangle>

                <Border Grid.RowSpan="2"
                        Background="#A810141D"
                        CornerRadius="10"/>

                <Border Grid.Row="0"
                        Background="#28000000"
                        CornerRadius="10,10,0,0">
                    <StackPanel Margin="10,8,10,8">
                        <Border Background="Transparent"
                                Cursor="SizeAll"
                                Padding="0,0,0,7"
                                MouseLeftButtonDown="QuickTextPanelHandle_MouseLeftButtonDown"
                                MouseMove="QuickTextPanelHandle_MouseMove"
                                MouseLeftButtonUp="QuickTextPanelHandle_MouseLeftButtonUp">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right"
                                           Text="Drag to reorder"
                                           Foreground="#71859A"
                                           FontSize="9"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="Clipboard List"
                                           Foreground="#EAF2FA"
                                           FontSize="13"
                                           FontWeight="SemiBold"/>
                            </DockPanel>
                        </Border>

                        <TextBlock Text="COLLECTIONS"
                                   Foreground="#70859A"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,4"/>
                        <ItemsControl ItemsSource="{Binding QuickTextCollections}"
                                      Margin="0,0,0,4">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Name}"
                                            Click="OverlayQuickTextCollection_Click"
                                            PreviewMouseLeftButtonDown="QuickTextCollection_DragStart"
                                            PreviewMouseMove="QuickTextCollection_DragMove"
                                            Drop="QuickTextCollection_Drop"
                                            AllowDrop="True"
                                            ToolTip="Drag to reorder collections"
                                            BorderThickness="0"
                                            Padding="10,4"
                                            Margin="0,0,6,6"
                                            Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#26394B"/>
                                                <Setter Property="Foreground" Value="#D8E5F1"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="CollectionBorder"
                                                                    Background="{TemplateBinding Background}"
                                                                    CornerRadius="6"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{StaticResource StringEquals}">
                                                                <Binding Path="Id"/>
                                                                <Binding Path="OverlaySelectedQuickTextCollectionId" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <Setter Property="Background" Value="#3C6387"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <DockPanel Margin="0,0,0,4">
                            <Button DockPanel.Dock="Right"
                                    Content="Clear"
                                    Click="ClearOverlayQuickTextTags_Click"
                                    Style="{StaticResource QuickFilterClearButton}"
                                    ToolTip="Deselect all tag filters"/>
                            <TextBlock Text="TAGS"
                                       Foreground="#70859A"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding OverlayQuickTextCategories, RelativeSource={RelativeSource AncestorType=Window}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton Content="{Binding Category.Name}"
                                            Style="{StaticResource QuickFilterChipToggleButton}"
                                            IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                            PreviewMouseLeftButtonDown="QuickTextCategory_DragStart"
                                            PreviewMouseMove="QuickTextCategory_DragMove"
                                            Drop="QuickTextCategory_Drop"
                                            AllowDrop="True"
                                            ToolTip="Select multiple tags or drag to reorder"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1"
                        Margin="10,8,10,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Quick copy text directly to the clipboard · ✎ = temporary editing (not saved)"
                               Foreground="#C4D3E4"
                               FontSize="11"
                               Margin="0,0,0,8"/>

                    <Grid Grid.Row="1"
                            Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <TextBox Text="{Binding OverlayQuickTextSearchQuery, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=220}"
                                     Foreground="#EFF4FA"
                                     Background="#26000000"
                                     BorderBrush="#3CFFFFFF"
                                     BorderThickness="1"
                                     Padding="8,5"
                                     FontSize="12"
                                     ToolTip="Search all categories"/>
                            <TextBlock Text="Sök i alla kategorier…"
                                       Foreground="#71859A"
                                       Margin="9,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding OverlayQuickTextSearchQuery, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource HasTextVisibility}, ConverterParameter=Invert}"/>
                        </Grid>

                        <Button Grid.Column="1"
                                Click="ClearOverlayQuickTextSearch_Click"
                                Content="✕"
                                Margin="6,0,0,0"
                                Padding="8,4"
                                Foreground="#DCE7F2"
                                Background="#2A000000"
                                BorderThickness="0"
                                FontSize="11"
                                Cursor="Hand"
                                Visibility="{Binding OverlayQuickTextSearchQuery, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource HasTextVisibility}}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="4"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver"
                                                            Value="True">
                                                        <Setter TargetName="Bd"
                                                                Property="Background"
                                                                Value="#3C000000"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <TextBlock Grid.Row="2"
                               Text="No texts matched the current filter or search."
                               Foreground="#8B9FB5"
                               FontSize="12"
                               TextWrapping="Wrap"
                                         VerticalAlignment="Top"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                                         Margin="0,8,0,0"
                               Visibility="{Binding HasOverlayQuickTextItems, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"/>

                    <ScrollViewer Grid.Row="2"
                                  VerticalAlignment="Stretch"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding HasOverlayQuickTextItems, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding OverlayQuickTextItems, RelativeSource={RelativeSource AncestorType=Window}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#22000000"
                                            BorderBrush="#38FFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="6"
                                            Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Row="0"
                                                       Grid.Column="0"
                                                       Text="{Binding CategoryName}"
                                                       Foreground="#7FA8CF"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,6,3"
                                                       Visibility="{Binding OverlayQuickTextSearchQuery, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource HasTextVisibility}}"/>

                                            <TextBlock Grid.Row="1"
                                                       Grid.Column="0"
                                                       Text="{Binding PreviewText}"
                                                       Foreground="#ECF3FA"
                                                       FontSize="{Binding DataContext.QuickTextFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       LineHeight="{Binding DataContext.QuickTextPreviewLineHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       LineStackingStrategy="BlockLineHeight"
                                                       MaxHeight="{Binding DataContext.QuickTextPreviewHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       Margin="0,0,6,0"
                                                       VerticalAlignment="Top"
                                                       Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"/>

                                            <TextBox Grid.Row="1"
                                                     Grid.Column="0"
                                                     Text="{Binding SessionText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Tag="QuickTextInlineEditor"
                                                     KeyDown="QuickTextInlineEditor_KeyDown"
                                                     Foreground="#EFF4FA"
                                                     Background="#26000000"
                                                     BorderBrush="#3CFFFFFF"
                                                     BorderThickness="1"
                                                     Padding="8,6"
                                                     FontSize="{Binding DataContext.QuickTextFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                     TextWrapping="Wrap"
                                                     AcceptsReturn="True"
                                                     VerticalContentAlignment="Top"
                                                     VerticalScrollBarVisibility="Hidden"
                                                     HorizontalScrollBarVisibility="Disabled"
                                                     Height="{Binding DataContext.QuickTextEditorHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                                     Margin="0,0,6,0"
                                                     Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}"/>
                                            <TextBlock Grid.Row="2"
                                                       Grid.Column="0"
                                                       Text="Temporary editing is active for this overlay session"
                                                       Foreground="#92A8BF"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       LineHeight="{Binding DataContext.QuickTextHintLineHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       LineStackingStrategy="BlockLineHeight"
                                                       MaxHeight="{Binding DataContext.QuickTextHintMaxHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       FontSize="10"
                                                       Margin="0,4,6,0"
                                                       Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}"/>

                                            <Grid Grid.Row="0"
                                                  Grid.RowSpan="3"
                                                  Grid.Column="1"
                                                  Margin="0,2,0,0"
                                                  VerticalAlignment="Top">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="70"/>
                                                </Grid.ColumnDefinitions>

                                                <Button Click="QuickTextToggleEdit_Click"
                                                    Background="#2B3E50"
                                                        Foreground="#DCE7F2"
                                                        BorderThickness="0"
                                                        Padding="10,5"
                                                        Margin="0,0,4,0"
                                                        MinWidth="28"
                                                        Cursor="Hand"
                                                        VerticalAlignment="Center"
                                                        ToolTip="Temporary editing (not saved)">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Content"
                                                                    Value="✎"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="Bd"
                                                                                Background="{TemplateBinding Background}"
                                                                                CornerRadius="4"
                                                                                Padding="{TemplateBinding Padding}">
                                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                                    VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver"
                                                                                    Value="True">
                                                                                <Setter TargetName="Bd"
                                                                                        Property="Background"
                                                                                        Value="#355069"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEditing}"
                                                                        Value="True">
                                                                    <Setter Property="Content"
                                                                            Value="✓"/>
                                                                    <Setter Property="Background"
                                                                        Value="#3E6E4D"/>
                                                                    <Setter Property="Foreground"
                                                                            Value="#F2FFF2"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <Button Grid.Column="1"
                                                        Content="Copy"
                                                        Click="QuickTextCopy_Click"
                                                    Background="#3A5A78"
                                                        Foreground="White"
                                                        BorderThickness="0"
                                                        Padding="0,5"
                                                        Cursor="Hand"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding DataContext.HasQuickTextAction, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="Bd"
                                                                                Background="{TemplateBinding Background}"
                                                                                CornerRadius="4"
                                                                                Padding="{TemplateBinding Padding}">
                                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                                    VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver"
                                                                                    Value="True">
                                                                                <Setter TargetName="Bd"
                                                                                        Property="Background"
                                                                                        Value="#476D91"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <Grid Grid.Column="1"
                                                      Visibility="{Binding DataContext.HasQuickTextAction, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Button Grid.Column="0"
                                                            Content="Copy"
                                                            Click="QuickTextCopy_Click"
                                                            Background="#2E5F93"
                                                            Foreground="White"
                                                            BorderThickness="0"
                                                            Padding="0,5"
                                                            Margin="0,0,1,0"
                                                            Cursor="Hand"
                                                            VerticalAlignment="Center">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="Bd"
                                                                                    Background="{TemplateBinding Background}"
                                                                                    CornerRadius="4"
                                                                                    Padding="{TemplateBinding Padding}">
                                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                        VerticalAlignment="Center"/>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver"
                                                                                        Value="True">
                                                                                    <Setter TargetName="Bd"
                                                                                            Property="Background"
                                                                                            Value="#3E76B0"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>

                                                        <Button Grid.Column="1"
                                                            Content="➜"
                                                            Click="QuickTextAction_Click"
                                                            Background="#3D7A37"
                                                            Foreground="White"
                                                            BorderThickness="0"
                                                            Padding="0,5"
                                                            Margin="1,0,0,0"
                                                            Cursor="Hand"
                                                            VerticalAlignment="Center"
                                                            ToolTip="Run the shared clipboard action with the current row text">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="Bd"
                                                                                    Background="{TemplateBinding Background}"
                                                                                    CornerRadius="4"
                                                                                    Padding="{TemplateBinding Padding}">
                                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                        VerticalAlignment="Center"/>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver"
                                                                                        Value="True">
                                                                                    <Setter TargetName="Bd"
                                                                                            Property="Background"
                                                                                            Value="#50A046"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- Invisible resize hit areas centered on both outer bottom corners. -->
                <Border Grid.RowSpan="2"
                        Width="14"
                        Height="14"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Margin="-7,0,0,-7"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="SizeNESW"
                        Panel.ZIndex="20"
                        MouseLeftButtonDown="QuickTextPanelResizeHandle_MouseLeftButtonDown"
                        MouseMove="QuickTextPanelResizeHandle_MouseMove"
                        MouseLeftButtonUp="QuickTextPanelResizeHandle_MouseLeftButtonUp"/>
                <Border Grid.RowSpan="2"
                        Width="14"
                        Height="14"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,-7,-7"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="SizeNWSE"
                        Panel.ZIndex="20"
                        MouseLeftButtonDown="QuickTextPanelResizeRightHandle_MouseLeftButtonDown"
                        MouseMove="QuickTextPanelResizeRightHandle_MouseMove"
                        MouseLeftButtonUp="QuickTextPanelResizeRightHandle_MouseLeftButtonUp"/>
            </Grid>
        </Border>

        <!-- Forms fill-in panel -->
        <Border x:Name="FormsPanel"
                Width="{Binding FormsPanelWidth, Mode=TwoWay}"
                Height="{Binding FormsPanelHeight, Mode=TwoWay}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="0"
                Panel.ZIndex="9"
                Visibility="{Binding FormsPanelVisible, Converter={StaticResource BoolToVisibility}}"
                Background="{Binding OverlayBackgroundColor, Converter={StaticResource StringToBrush}}"
                Opacity="{Binding ButtonOverlayOpacity}"
                BorderBrush="#44FFFFFF"
                BorderThickness="1"
                CornerRadius="10">
            <Border.RenderTransform>
                <TranslateTransform X="{Binding FormsPanelX, Mode=TwoWay}"
                                    Y="{Binding FormsPanelY, Mode=TwoWay}"/>
            </Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.RowSpan="3"
                        Background="#A810141D"
                        CornerRadius="10"/>

                <!-- Header: drag handle + form chips -->
                <Border Grid.Row="0"
                        Background="#28000000"
                        CornerRadius="10,10,0,0">
                    <StackPanel Margin="10,8,10,6">
                        <Border Background="Transparent"
                                Cursor="SizeAll"
                                Padding="0,0,0,7"
                                MouseLeftButtonDown="FormsPanelHandle_MouseLeftButtonDown"
                                MouseMove="FormsPanelHandle_MouseMove"
                                MouseLeftButtonUp="FormsPanelHandle_MouseLeftButtonUp">
                            <DockPanel>
                                <Button DockPanel.Dock="Right"
                                        Content="✕"
                                        Command="{Binding HideFormsPanelCommand}"
                                        Style="{StaticResource TopMiniButton}"
                                        FontSize="11"
                                        ToolTip="Hide the forms panel"/>
                                <Button DockPanel.Dock="Right"
                                        Command="{Binding ToggleFormHistoryCommand}"
                                        ToolTip="Open history. Orange shows open submissions; green shows completed submissions."
                                        Foreground="#D8E5F1"
                                        BorderThickness="0"
                                        FontSize="10"
                                        Padding="8,3"
                                        Margin="0,0,6,0"
                                        Cursor="Hand"
                                        FocusVisualStyle="{StaticResource FormsKeyboardFocusVisual}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="History" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding OverlayFormSubmissionCountScopeText}"
                                                   Foreground="#7890A7"
                                                   FontSize="8"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Margin="5,0,0,0"/>
                                        <Border Background="#493B24"
                                                CornerRadius="7"
                                                Padding="5,1"
                                                Margin="7,0,0,0"
                                                ToolTip="Open submissions">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="5" Height="5" Fill="#F2B84B"
                                                         VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding OpenOverlayFormSubmissionCount}"
                                                           Foreground="#FFD784" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#203D2B"
                                                CornerRadius="7"
                                                Padding="5,1"
                                                Margin="4,0,0,0"
                                                ToolTip="Completed submissions">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource FormsIconCheck}"
                                                      Width="6" Height="6" Stretch="Uniform"
                                                      Fill="#A6E3A1" VerticalAlignment="Center"
                                                      Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding CompletedOverlayFormSubmissionCount}"
                                                           Foreground="#A6E3A1" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#26394B"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd"
                                                                Background="{TemplateBinding Background}"
                                                                CornerRadius="5"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFormHistoryVisible}" Value="True">
                                                    <Setter Property="Background" Value="#3C6387"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <TextBlock Text="Forms"
                                           Foreground="#EAF2FA"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding FormTemplates}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Name}"
                                            Command="{Binding DataContext.SetFormTemplateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            BorderThickness="0"
                                            Padding="10,4"
                                            Margin="0,0,6,6"
                                            Cursor="Hand"
                                            FocusVisualStyle="{StaticResource FormsKeyboardFocusVisual}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#26394B"/>
                                                <Setter Property="Foreground" Value="#D8E5F1"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    CornerRadius="6"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{StaticResource StringEquals}">
                                                                <Binding Path="Id"/>
                                                                <Binding Path="DataContext.OverlayFormTemplate.Id" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <Setter Property="Background" Value="#3C6387"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Fields -->
                <TextBlock Grid.Row="1"
                           Text="No forms configured yet. Create one in the editor under Forms."
                           Foreground="#8FA3B8"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="12"
                           Visibility="{Binding HasFormTemplates, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"/>

                <ScrollViewer Grid.Row="1"
                              Margin="10,6,10,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding IsFormFillViewVisible, Converter={StaticResource BoolToVisibility}}">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource MusicScrollBar}"/>
                    </ScrollViewer.Resources>
                    <ItemsControl ItemsSource="{Binding FormSessionFields}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal"
                                                Focusable="False"
                                                IsHitTestVisible="False"
                                                Margin="0,0,0,3">
                                        <TextBlock Text="{Binding Label}"
                                                   Foreground="#AFC3D6"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text=" *"
                                                   Foreground="#F38BA8"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Visibility="{Binding Field.IsRequired, Converter={StaticResource BoolToVisibility}}"/>
                                    </StackPanel>

                                    <!-- Choice options as chips: click prefills the editable text below -->
                                    <ItemsControl ItemsSource="{Binding Options}"
                                                  Visibility="{Binding IsChoice, Converter={StaticResource BoolToVisibility}}"
                                                  Margin="0,0,0,2">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding Label}"
                                                        Command="{Binding DataContext.ApplyOptionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        BorderThickness="0"
                                                        Padding="8,3"
                                                        Margin="0,0,5,5"
                                                        Cursor="Hand"
                                                        ToolTip="Choice option — press Enter or Space to apply"
                                                        FocusVisualStyle="{StaticResource FormsKeyboardFocusVisual}">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Background" Value="#26394B"/>
                                                            <Setter Property="Foreground" Value="#D8E5F1"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="{TemplateBinding Background}"
                                                                                CornerRadius="5"
                                                                                Padding="{TemplateBinding Padding}">
                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                                    <Setter Property="Background" Value="#527FA8"/>
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                </Trigger>
                                                                <DataTrigger Value="True">
                                                                    <DataTrigger.Binding>
                                                                        <MultiBinding Converter="{StaticResource StringEquals}">
                                                                            <Binding Path="Id"/>
                                                                            <Binding Path="DataContext.SelectedOption.Id" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                                                        </MultiBinding>
                                                                    </DataTrigger.Binding>
                                                                    <Setter Property="Background" Value="#3C6387"/>
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBox x:Name="FormFieldValueBox"
                                             Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Foreground="#EAF2FA"
                                             CaretBrush="#EAF2FA"
                                             FontSize="12"
                                             Padding="7,5"
                                             FocusVisualStyle="{StaticResource FormsKeyboardFocusVisual}">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Background" Value="#232F3D"/>
                                                <Setter Property="BorderBrush" Value="#3A4C5E"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                                        <Setter Property="Background" Value="#2B3D50"/>
                                                        <Setter Property="BorderBrush" Value="#9CCAF2"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>

                                    <!-- Autocomplete suggestions from previous submissions -->
                                    <ItemsControl ItemsSource="{Binding Suggestions}"
                                                  Visibility="{Binding HasSuggestions, Converter={StaticResource BoolToVisibility}}"
                                                  Margin="0,4,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding}"
                                                        Command="{Binding DataContext.ApplySuggestionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Background="#1E2E3E"
                                                        Foreground="#9FB8CE"
                                                        BorderThickness="0"
                                                        FontSize="10"
                                                        Padding="7,2"
                                                        Margin="0,0,5,4"
                                                        Cursor="Hand"
                                                        FocusVisualStyle="{StaticResource FormsKeyboardFocusVisual}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Bd"
                                                                    Background="{TemplateBinding Background}"
                                                                    BorderBrush="#2C4257"
                                                                    BorderThickness="1"
                                                                    CornerRadius="9"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="#2C4257"/>
                                                                </Trigger>
                                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="#3C6387"/>
                                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#9CCAF2"/>
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsMultiline}" Value="True">
                                        <Setter TargetName="FormFieldValueBox" Property="AcceptsReturn" Value="True"/>
                                        <Setter TargetName="FormFieldValueBox" Property="TextWrapping" Value="Wrap"/>
                                        <Setter TargetName="FormFieldValueBox" Property="MinHeight" Value="56"/>
                                        <Setter TargetName="FormFieldValueBox" Property="MaxHeight" Value="120"/>
                                        <Setter TargetName="FormFieldValueBox" Property="VerticalScrollBarVisibility" Value="Auto"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Preview + actions -->
                <StackPanel Grid.Row="2"
                            Margin="10,6,10,10"
                            Visibility="{Binding IsFormFillViewVisible, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="PREVIEW"
                               Foreground="#70859A"
                               FontSize="9"
                               FontWeight="SemiBold"
                               Margin="0,0,0,3"/>
                    <Border Background="#1A2430"
                            BorderBrush="#2C4257"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8"
                            MaxHeight="110"
                            Margin="0,0,0,8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ScrollViewer.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource MusicScrollBar}"/>
                            </ScrollViewer.Resources>
                            <TextBlock Text="{Binding FormPreviewText}"
                                       Foreground="#C6D4E4"
                                       FontSize="11"
                                       FontFamily="Consolas"
                                       TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>
                    <Border Background="#4A2028"
                            BorderBrush="#D65C75"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="8,6"
                            Margin="0,0,0,8"
                            Visibility="{Binding HasFormSessionValidationError, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Cannot save yet"
                                       Foreground="#FFD2DA"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding FormSessionValidationText}"
                                       Foreground="#F6A8B7"
                                       FontSize="10"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Save"
                                Command="{Binding SaveFormResultCommand}"
                                ToolTip="Save to the history, advance counters, and reset the form"
                                Background="#2D5A27"
                                Foreground="White"
                                BorderThickness="0"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Padding="16,6"
                                Margin="0,0,8,0"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#3D7A37"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Bd" Property="Background" Value="#555B60"/>
                                            <Setter Property="Foreground" Value="#AEB3B7"/>
                                            <Setter Property="Cursor" Value="Arrow"/>
                                            <Setter Property="Opacity" Value="0.75"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="Copy"
                                Command="{Binding CopyFormResultCommand}"
                                ToolTip="Copy the result to the clipboard and record the submission"
                                Visibility="{Binding OverlayFormTemplate.ShowCopyButton, Converter={StaticResource BoolToVisibility}}"
                                Background="#2A4D7A"
                                Foreground="White"
                                BorderThickness="0"
                                FontSize="12"
                                Padding="14,6"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#3A6099"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Bd" Property="Background" Value="#555B60"/>
                                            <Setter Property="Foreground" Value="#AEB3B7"/>
                                            <Setter Property="Cursor" Value="Arrow"/>
                                            <Setter Property="Opacity" Value="0.75"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="Send"
                                Click="FormSend_Click"
                                IsEnabled="{Binding CanSubmitFormResult}"
                                ToolTip="Close the overlay and run the form's send action in the previous window"
                                Background="#6B4E1F"
                                Foreground="White"
                                BorderThickness="0"
                                FontSize="12"
                                Padding="14,6"
                                Margin="8,0,0,0"
                                Cursor="Hand"
                                Visibility="{Binding HasFormSendAction, Converter={StaticResource BoolToVisibility}}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#8A6528"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Bd" Property="Background" Value="#555B60"/>
                                            <Setter Property="Foreground" Value="#AEB3B7"/>
                                            <Setter Property="Cursor" Value="Arrow"/>
                                            <Setter Property="Opacity" Value="0.75"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- Submission history: per-field copy with done-checkmarks -->
                <ScrollViewer Grid.Row="1"
                              Grid.RowSpan="2"
                              Margin="10,6,10,10"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding IsFormHistoryVisible, Converter={StaticResource BoolToVisibility}}">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource MusicScrollBar}"/>
                    </ScrollViewer.Resources>
                    <StackPanel>
                        <TextBlock Text="Nothing saved yet. Fill in a form and press Save."
                                   Foreground="#8FA3B8"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasOverlayFormSubmissions, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"/>
                        <ItemsControl ItemsSource="{Binding OverlayFormSubmissions}"
                                      Grid.IsSharedSizeScope="True">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8"
                                            BorderThickness="1"
                                            Padding="10,8"
                                            Margin="0,0,0,8">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#1C2836"/>
                                                <Setter Property="BorderBrush" Value="#2C4257"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                        <Setter Property="Opacity" Value="0.5"/>
                                                        <Setter Property="Background" Value="#16202B"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <!-- Card header -->
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right"
                                                        Command="{Binding CopyAllCommand}"
                                                        Style="{StaticResource TopMiniButton}"
                                                        Padding="6,3"
                                                        ToolTip="Copy the full text">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource FormsIconCopy}"
                                                              Width="10" Height="10" Stretch="Uniform"
                                                              Fill="#9FB8CE" VerticalAlignment="Center"
                                                              Margin="0,0,5,0"/>
                                                        <TextBlock Text="All" Foreground="#9FB8CE" FontSize="10"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <Border DockPanel.Dock="Right"
                                                        Background="#1F3B2A"
                                                        CornerRadius="8"
                                                        Padding="7,2"
                                                        Margin="0,0,6,0"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisibility}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource FormsIconCheck}"
                                                              Width="8" Height="8" Stretch="Uniform"
                                                              Fill="#A6E3A1" VerticalAlignment="Center"
                                                              Margin="0,0,4,0"/>
                                                        <TextBlock Text="Done" Foreground="#A6E3A1" FontSize="9"
                                                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <CheckBox IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                                          ToolTip="Mark as done — checked automatically when every field has been copied"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,8,0"
                                                          Cursor="Hand"/>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TemplateName}"
                                                               Foreground="#EAF2FA"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding CreatedText}"
                                                               Foreground="#5F7489"
                                                               FontSize="10"
                                                               VerticalAlignment="Bottom"
                                                               Margin="8,0,0,1"/>
                                                </StackPanel>
                                            </DockPanel>

                                            <!-- Field rows: hidden once the card is done -->
                                            <StackPanel Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                                                <Border Height="1"
                                                        Background="#22334A"
                                                        Margin="0,7,0,7"
                                                        Visibility="{Binding HasFieldValues, Converter={StaticResource BoolToVisibility}}"/>
                                                <ItemsControl ItemsSource="{Binding FieldValues}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,4">
                                                                <Grid.Style>
                                                                    <Style TargetType="Grid">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsCopied}" Value="True">
                                                                                <Setter Property="Opacity" Value="0.55"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Grid.Style>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="FormHistoryLabel"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0"
                                                                           Text="{Binding LabelText}"
                                                                           Foreground="#70859A"
                                                                           FontSize="10"
                                                                           MaxWidth="120"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           VerticalAlignment="Center"
                                                                           Margin="0,0,8,0"/>
                                                                <Grid Grid.Column="1" Margin="0,0,8,0">
                                                                    <DockPanel MouseLeftButtonDown="FormHistoryFieldValue_MouseLeftButtonDown"
                                                                               Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                                                                        <TextBlock DockPanel.Dock="Right"
                                                                                   Text="✎"
                                                                                   Foreground="#7890A7"
                                                                                   FontSize="10"
                                                                                   Margin="6,0,0,0"
                                                                                   VerticalAlignment="Center"
                                                                                   IsHitTestVisible="False"
                                                                                   ToolTip="Double-click the value to make a quick correction"
                                                                                   Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}"/>
                                                                        <TextBlock Text="{Binding Value}"
                                                                                   Foreground="#D5E2EF"
                                                                                   FontSize="11"
                                                                                   TextWrapping="Wrap"
                                                                                   VerticalAlignment="Center"/>
                                                                    </DockPanel>
                                                                    <TextBox Text="{Binding EditValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                             Background="#26394B"
                                                                             Foreground="#F4F8FC"
                                                                             CaretBrush="#F4F8FC"
                                                                             BorderBrush="#9CCAF2"
                                                                             BorderThickness="1"
                                                                             FontSize="11"
                                                                             Padding="5,3"
                                                                             Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}"
                                                                             IsVisibleChanged="FormHistoryFieldEditBox_IsVisibleChanged"
                                                                             LostKeyboardFocus="FormHistoryFieldEditBox_LostKeyboardFocus"
                                                                             KeyDown="FormHistoryFieldEditBox_KeyDown"/>
                                                                </Grid>
                                                                <Button Grid.Column="2"
                                                                        Command="{Binding CopyCommand}"
                                                                        Style="{StaticResource TopMiniButton}"
                                                                        Padding="6,3"
                                                                        VerticalAlignment="Center"
                                                                        ToolTip="Copy this value — checks it off automatically">
                                                                    <Path Width="11" Height="11" Stretch="Uniform"
                                                                          VerticalAlignment="Center">
                                                                        <Path.Style>
                                                                            <Style TargetType="Path">
                                                                                <Setter Property="Data" Value="{StaticResource FormsIconCopy}"/>
                                                                                <Setter Property="Fill" Value="#9FB8CE"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsCopied}" Value="True">
                                                                                        <Setter Property="Data" Value="{StaticResource FormsIconCheck}"/>
                                                                                        <Setter Property="Fill" Value="#A6E3A1"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Path.Style>
                                                                    </Path>
                                                                </Button>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Invisible resize hit areas centered on both outer bottom corners. -->
                <Border Grid.RowSpan="3"
                        Width="14"
                        Height="14"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Margin="-7,0,0,-7"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="SizeNESW"
                        Panel.ZIndex="20"
                        MouseLeftButtonDown="FormsPanelResizeHandle_MouseLeftButtonDown"
                        MouseMove="FormsPanelResizeHandle_MouseMove"
                        MouseLeftButtonUp="FormsPanelResizeHandle_MouseLeftButtonUp"/>
                <Border Grid.RowSpan="3"
                        Width="14"
                        Height="14"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,-7,-7"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="SizeNWSE"
                        Panel.ZIndex="20"
                        MouseLeftButtonDown="FormsPanelResizeRightHandle_MouseLeftButtonDown"
                        MouseMove="FormsPanelResizeRightHandle_MouseMove"
                        MouseLeftButtonUp="FormsPanelResizeRightHandle_MouseLeftButtonUp"/>
            </Grid>
        </Border>

        <!-- MicMixer music widget -->
        <Border x:Name="MusicWidgetPanel"
                Width="{Binding MusicWidgetWidth, Mode=TwoWay}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Panel.ZIndex="9"
                Visibility="{Binding MusicWidgetVisible, Converter={StaticResource BoolToVisibility}}"
                Background="{Binding OverlayBackgroundColor, Converter={StaticResource StringToBrush}}"
                Opacity="{Binding ButtonOverlayOpacity}"
                BorderBrush="#44FFFFFF"
                BorderThickness="1"
                CornerRadius="10">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Height"
                            Value="{Binding MusicWidgetHeight}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MusicWidgetMinimized}"
                                Value="True">
                            <Setter Property="Height"
                                    Value="Auto"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding MusicWidget.ShowPlayerControls}"
                                Value="False">
                            <Setter Property="Height"
                                    Value="Auto"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.RenderTransform>
                <TranslateTransform X="{Binding MusicWidgetX, Mode=TwoWay}"
                                    Y="{Binding MusicWidgetY, Mode=TwoWay}"/>
            </Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Rectangle Grid.RowSpan="4"
                           Opacity="0.78"
                           Visibility="{Binding OverlayBackgroundImagePath, Converter={StaticResource HasTextVisibility}}">
                    <Rectangle.Fill>
                        <ImageBrush ImageSource="{Binding OverlayBackgroundImagePath, Converter={StaticResource PathToImageSource}}"
                                    Stretch="UniformToFill"/>
                    </Rectangle.Fill>
                </Rectangle>

                <Border Grid.RowSpan="4"
                        Background="#A810141D"
                        CornerRadius="10"/>

                <!-- Header / drag handle -->
                <Border Grid.Row="0"
                        Background="#28000000"
                        CornerRadius="10,10,0,0"
                        Cursor="SizeAll"
                        MouseLeftButtonDown="MusicWidgetHandle_MouseLeftButtonDown"
                        MouseMove="MusicWidgetHandle_MouseMove"
                        MouseLeftButtonUp="MusicWidgetHandle_MouseLeftButtonUp">
                    <DockPanel Margin="10,7,8,7"
                            LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                            <Button Command="{Binding ToggleMusicWidgetMinimizedCommand}"
                                    Style="{StaticResource TopMiniButton}"
                                    Width="22"
                                    Height="20"
                                    Padding="0"
                                    ToolTip="Compact mode – hides the queue and library">
                                <Path Width="10"
                                      Height="10"
                                      Stretch="Uniform"
                                      Fill="#DCE7F2">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Data"
                                                    Value="{StaticResource MusicIconMinimize}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MusicWidgetMinimized}"
                                                        Value="True">
                                                    <Setter Property="Data"
                                                            Value="{StaticResource MusicIconRestore}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Button>
                            <Button Command="{Binding HideMusicWidgetCommand}"
                                    Style="{StaticResource TopMiniButton}"
                                    Width="22"
                                    Height="20"
                                    Padding="0"
                                    Margin="2,0,0,0"
                                    ToolTip="Hide the music widget">
                                <Path Data="{StaticResource MusicIconClose}"
                                      Width="9"
                                      Height="9"
                                      Stretch="Uniform"
                                      Fill="#DCE7F2"/>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                            <Path Data="{StaticResource MusicIconNote}"
                                  Width="12"
                                  Height="12"
                                  Stretch="Uniform"
                                  Fill="#B9A8F5"
                                  VerticalAlignment="Center"
                                  Margin="0,0,7,0"/>
                            <TextBlock Text="MicMixer Music"
                                       Foreground="#EAF2FA"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <Ellipse Width="8"
                                     Height="8"
                                     Margin="9,1,0,0"
                                     VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill"
                                                Value="#8B9FB5"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MusicWidget.ConnectionState}"
                                                    Value="Connected">
                                                <Setter Property="Fill"
                                                        Value="#5FCB8C"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding MusicWidget.ConnectionState}"
                                                    Value="Connecting">
                                                <Setter Property="Fill"
                                                        Value="#E8B45A"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding MusicWidget.ConnectionState}"
                                                    Value="Unavailable">
                                                <Setter Property="Fill"
                                                        Value="#E36B6B"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Disconnected card + connected-state banners -->
                <StackPanel Grid.Row="1">
                    <StackPanel Margin="12,14,12,16"
                            Visibility="{Binding MusicWidget.IsConnected, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                        <TextBlock Text="MicMixer is not running"
                                   Foreground="#EAF2FA"
                                   FontSize="13"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding MusicWidget.ConnectionStatusText}"
                                   Foreground="#8B9FB5"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0"/>
                        <Button Command="{Binding MusicWidget.RetryConnectCommand}"
                                Style="{StaticResource MusicTransportButton}"
                                Width="Auto"
                                Height="Auto"
                                Padding="12,6"
                                FontSize="11.5"
                                HorizontalAlignment="Left"
                                Margin="0,10,0,0"
                                Visibility="{Binding MusicWidget.ShowRetryButton, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource MusicIconRefresh}"
                                      Width="11"
                                      Height="11"
                                      Stretch="Uniform"
                                      Fill="#E6EEF8"
                                      VerticalAlignment="Center"
                                      Margin="0,0,6,0"/>
                                <TextBlock Text="Try again"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel Visibility="{Binding MusicWidget.IsConnected, Converter={StaticResource BoolToVisibility}}">
                        <Border Margin="10"
                                Padding="10,8"
                                Background="#2EFFB157"
                                BorderBrush="#66FFB157"
                                BorderThickness="1"
                                CornerRadius="7"
                                Visibility="{Binding MusicWidget.IsExternalMode, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="MicMixer is in external capture mode, so direct playback control is unavailable."
                                           Foreground="#FFD9A8"
                                           FontSize="11"
                                           TextWrapping="Wrap"/>
                                <Button Content="Switch to library mode"
                                        Command="{Binding MusicWidget.SwitchToLibraryModeCommand}"
                                        Style="{StaticResource MusicTransportButton}"
                                        Width="Auto"
                                        Height="Auto"
                                        Padding="10,5"
                                        FontSize="11"
                                        HorizontalAlignment="Left"
                                        Margin="0,8,0,2"/>
                            </StackPanel>
                        </Border>

                        <Border Margin="10,10,10,0"
                                Padding="10,7"
                                Background="#2EFF6B6B"
                                BorderBrush="#55FF6B6B"
                                BorderThickness="1"
                                CornerRadius="7"
                                Visibility="{Binding MusicWidget.PlaybackBlockedReason, Converter={StaticResource HasTextVisibility}}">
                            <TextBlock Text="{Binding MusicWidget.PlaybackBlockedReason}"
                                       Foreground="#FFB4B4"
                                       FontSize="11"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <TextBlock Margin="12,8,12,0"
                                   FontSize="10.5"
                                   Foreground="#D9B25F"
                                   TextWrapping="Wrap"
                                   Text="Routing is off in MicMixer — the music is only heard locally."
                                   Visibility="{Binding MusicWidget.ShowRoutingHint, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Core player: now playing, seek, transport, volumes -->
                <StackPanel Grid.Row="2"
                        Visibility="{Binding MusicWidget.ShowPlayerControls, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Margin"
                                    Value="12,8,12,4"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MusicWidgetMinimized}"
                                        Value="True">
                                    <Setter Property="Margin"
                                            Value="12,8,12,12"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{Binding MusicWidget.NowPlayingText}"
                               Foreground="#ECF3FA"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding MusicWidget.NowPlayingText}"/>

                    <Grid Margin="0,7,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="MusicSeekSlider"
                                Minimum="0"
                                Maximum="1"
                                IsEnabled="False"
                                VerticalAlignment="Center"
                                IsMoveToPointEnabled="True"
                                Thumb.DragStarted="MusicSeek_DragStarted"
                                Thumb.DragCompleted="MusicSeek_DragCompleted"
                                ValueChanged="MusicSeekSlider_ValueChanged"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding MusicWidget.TrackTimeText}"
                                   Foreground="#8B9FB5"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   MinWidth="78"
                                   TextAlignment="Right"
                                   Margin="8,0,0,0"/>
                    </Grid>

                    <DockPanel Margin="0,8,0,0"
                            LastChildFill="False">
                        <Button DockPanel.Dock="Left"
                                Command="{Binding MusicWidget.PreviousCommand}"
                                Style="{StaticResource MusicTransportButton}"
                                ToolTip="Previous / restart track">
                            <Path Data="{StaticResource MusicIconSkipPrev}"
                                  Width="13"
                                  Height="13"
                                  Stretch="Uniform"
                                  Fill="#E6EEF8"/>
                        </Button>
                        <Button DockPanel.Dock="Left"
                                Command="{Binding MusicWidget.TogglePlayPauseCommand}"
                                Style="{StaticResource MusicPrimaryTransportButton}"
                                Margin="6,0,0,0"
                                ToolTip="Play / pause">
                            <Path Width="13"
                                  Height="13"
                                  Stretch="Uniform"
                                  Fill="White">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Data"
                                                Value="{StaticResource MusicIconPlay}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MusicWidget.IsPlaying}"
                                                    Value="True">
                                                <Setter Property="Data"
                                                        Value="{StaticResource MusicIconPause}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Button>
                        <Button DockPanel.Dock="Left"
                                Command="{Binding MusicWidget.StopPlaybackCommand}"
                                Style="{StaticResource MusicTransportButton}"
                                Margin="6,0,0,0"
                                ToolTip="Stop and deselect the active track">
                            <Path Data="{StaticResource MusicIconStop}"
                                  Width="12"
                                  Height="12"
                                  Stretch="Uniform"
                                  Fill="#E6EEF8"/>
                        </Button>
                        <Button DockPanel.Dock="Left"
                                Command="{Binding MusicWidget.NextCommand}"
                                Style="{StaticResource MusicTransportButton}"
                                Margin="6,0,0,0"
                                ToolTip="Next track">
                            <Path Data="{StaticResource MusicIconSkipNext}"
                                  Width="13"
                                  Height="13"
                                  Stretch="Uniform"
                                  Fill="#E6EEF8"/>
                        </Button>

                        <Button DockPanel.Dock="Left"
                                Command="{Binding MusicWidget.ToggleDelayedPlayCommand}"
                                Margin="12,0,0,0"
                                Width="Auto"
                                Padding="12,0"
                                FontSize="11.5"
                                ToolTip="{Binding MusicWidget.DelayedPlayToolTip}"
                                ToolTipService.ShowDuration="60000">
                            <Button.Style>
                                <Style TargetType="Button"
                                        BasedOn="{StaticResource MusicTransportButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MusicWidget.IsDelayedStartActive}"
                                                Value="True">
                                            <Setter Property="Background"
                                                    Value="#6C5CE7"/>
                                            <Setter Property="Foreground"
                                                    Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource MusicIconTimedPlay}"
                                      Width="13"
                                      Height="13"
                                      Stretch="Uniform"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding MusicWidget.DelayedPlayText}"
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <ToggleButton x:Name="MusicDelayMenuToggle"
                                      DockPanel.Dock="Left"
                                      Width="18"
                                      Height="30"
                                      Margin="2,0,0,0"
                                      Cursor="Hand"
                                      ToolTip="Choose the delay length">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd"
                                            Background="#2AFFFFFF"
                                            CornerRadius="6">
                                        <Path Data="{StaticResource MusicIconChevronDown}"
                                              Width="9"
                                              Height="9"
                                              Stretch="Uniform"
                                              Fill="#E6EEF8"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                Value="True">
                                            <Setter TargetName="Bd"
                                                    Property="Background"
                                                    Value="#3AFFFFFF"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked"
                                                Value="True">
                                            <Setter TargetName="Bd"
                                                    Property="Background"
                                                    Value="#4A6EA0"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup PlacementTarget="{Binding ElementName=MusicDelayMenuToggle}"
                               Placement="Bottom"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               PopupAnimation="Fade"
                               IsOpen="{Binding IsChecked, ElementName=MusicDelayMenuToggle, Mode=TwoWay}">
                            <Border Background="#F0141B26"
                                    BorderBrush="#44FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="8"
                                    Margin="4">
                                <StackPanel>
                                    <TextBlock Text="Delay before start"
                                               Foreground="#C4D3E4"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Margin="2,0,2,6"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="1 s"
                                                Tag="1"
                                                Click="MusicDelayOption_Click"
                                                Style="{StaticResource MusicFolderChipButton}"/>
                                        <Button Content="2 s"
                                                Tag="2"
                                                Click="MusicDelayOption_Click"
                                                Style="{StaticResource MusicFolderChipButton}"/>
                                        <Button Content="3 s"
                                                Tag="3"
                                                Click="MusicDelayOption_Click"
                                                Style="{StaticResource MusicFolderChipButton}"/>
                                        <Button Content="5 s"
                                                Tag="5"
                                                Click="MusicDelayOption_Click"
                                                Style="{StaticResource MusicFolderChipButton}"/>
                                        <Button Content="10 s"
                                                Tag="10"
                                                Click="MusicDelayOption_Click"
                                                Style="{StaticResource MusicFolderChipButton}"
                                                Margin="0,0,0,6"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <Button DockPanel.Dock="Right"
                                Command="{Binding MusicWidget.CycleSingleTrackModeCommand}"
                                Width="34"
                                Height="30"
                                Cursor="Hand"
                                ToolTipService.ShowDuration="60000">
                            <Button.ToolTip>
                                <ToolTip>
                                    <TextBlock Text="Single-track mode: stop when the current track ends instead of auto-advancing. Click to cycle Off → Once → Always."
                                               MaxWidth="260"
                                               TextWrapping="Wrap"/>
                                </ToolTip>
                            </Button.ToolTip>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd"
                                            Background="#2AFFFFFF"
                                            CornerRadius="6">
                                        <Path x:Name="Glyph"
                                              Data="{StaticResource MusicIconSingleTrack}"
                                              Width="13"
                                              Height="13"
                                              Stretch="Uniform"
                                              Fill="#8B9FB5"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                Value="True">
                                            <Setter TargetName="Bd"
                                                    Property="Background"
                                                    Value="#3AFFFFFF"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding MusicWidget.SingleTrackModeText}"
                                                Value="Once">
                                            <Setter TargetName="Bd"
                                                    Property="Background"
                                                    Value="#3A2F63"/>
                                            <Setter TargetName="Bd"
                                                    Property="BorderBrush"
                                                    Value="#8B7CF7"/>
                                            <Setter TargetName="Bd"
                                                    Property="BorderThickness"
                                                    Value="1"/>
                                            <Setter TargetName="Glyph"
                                                    Property="Fill"
                                                    Value="#C9BEFF"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding MusicWidget.SingleTrackModeText}"
                                                Value="Always">
                                            <Setter TargetName="Bd"
                                                    Property="Background"
                                                    Value="#6C5CE7"/>
                                            <Setter TargetName="Glyph"
                                                    Property="Fill"
                                                    Value="White"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DockPanel>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"
                                    SharedSizeGroup="MusicVolumeLabels"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Music"
                                   Foreground="#8B9FB5"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <Slider Grid.Column="1"
                                Minimum="0"
                                Maximum="100"
                                SmallChange="5"
                                LargeChange="10"
                                VerticalAlignment="Center"
                                Value="{Binding MusicWidget.MusicVolumePercent, Mode=TwoWay}"
                                ToolTip="How loud the music is for others (in the mic channel)"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding MusicWidget.MusicVolumePercent, StringFormat={}{0:0} %}"
                                   Foreground="#ECF3FA"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   MinWidth="36"
                                   TextAlignment="Right"
                                   Margin="8,0,0,0"/>

                        <TextBlock Grid.Row="1"
                                   Text="Monitor"
                                   Foreground="#8B9FB5"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="0,6,10,0"
                                   Visibility="{Binding MusicWidget.HasMonitorOutput, Converter={StaticResource BoolToVisibility}}"/>
                        <Slider Grid.Row="1"
                                Grid.Column="1"
                                Minimum="0"
                                Maximum="100"
                                SmallChange="5"
                                LargeChange="10"
                                VerticalAlignment="Center"
                                Margin="0,6,0,0"
                                Value="{Binding MusicWidget.MonitorVolumePercent, Mode=TwoWay}"
                                ToolTip="How loud the music is in your own headphones"
                                Visibility="{Binding MusicWidget.HasMonitorOutput, Converter={StaticResource BoolToVisibility}}"/>
                        <TextBlock Grid.Row="1"
                                   Grid.Column="2"
                                   Text="{Binding MusicWidget.MonitorVolumePercent, StringFormat={}{0:0} %}"
                                   Foreground="#ECF3FA"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   MinWidth="36"
                                   TextAlignment="Right"
                                   Margin="8,6,0,0"
                                   Visibility="{Binding MusicWidget.HasMonitorOutput, Converter={StaticResource BoolToVisibility}}"/>

                        <Button Grid.Column="3"
                                Grid.RowSpan="2"
                                Command="{Binding MusicWidget.ToggleVolumesLinkedCommand}"
                                Width="26"
                                Height="26"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Cursor="Hand"
                                ToolTipService.ShowDuration="60000"
                                Visibility="{Binding MusicWidget.HasMonitorOutput, Converter={StaticResource BoolToVisibility}}">
                            <Button.ToolTip>
                                <ToolTip>
                                    <TextBlock Text="Sync the volumes — drag one slider and the other follows, keeping the difference between them. Mirrors MicMixer's volume link."
                                               MaxWidth="260"
                                               TextWrapping="Wrap"/>
                                </ToolTip>
                            </Button.ToolTip>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd"
                                            Background="Transparent"
                                            CornerRadius="6">
                                        <Path x:Name="LinkGlyph"
                                              Data="{StaticResource MusicIconLink}"
                                              Width="14"
                                              Height="14"
                                              Stretch="Uniform"
                                              Fill="#8B9FB5"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                Value="True">
                                            <Setter TargetName="Bd"
                                                    Property="Background"
                                                    Value="#2AFFFFFF"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding MusicWidget.VolumesLinked}"
                                                Value="True">
                                            <Setter TargetName="Bd"
                                                    Property="Background"
                                                    Value="#3A2F63"/>
                                            <Setter TargetName="LinkGlyph"
                                                    Property="Fill"
                                                    Value="#C9BEFF"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- Music routing toggles, mirroring MicMixer's music card. Monitor only
                         is the quick preview action; Ignore PTT keeps music flowing while
                         push-to-talk holds the voice silent. Off = outlined chip with a
                         slashed icon and an explicit "off" state word; on = filled chip in
                         the same color the MicMixer overlay uses for that mode, so the two
                         UIs speak the same language. Hidden entirely when the connected
                         MicMixer does not advertise the musicRouting capability (older
                         versions reject the commands as unknown). -->
                    <UniformGrid Rows="1"
                                 Columns="2"
                                 Margin="0,8,0,0"
                                 Visibility="{Binding MusicWidget.SupportsMusicRouting, Converter={StaticResource BoolToVisibility}}">
                        <Button Command="{Binding MusicWidget.ToggleMusicMonitorOnlyCommand}"
                                Margin="0,0,3,0"
                                Cursor="Hand"
                                ToolTipService.ShowDuration="60000">
                            <Button.ToolTip>
                                <ToolTip>
                                    <TextBlock Text="Monitor only — preview: while ON, the music is never sent to the mic channel. You hear it in MicMixer's monitoring (and the secondary output still carries it, so the stream hears what you hear). Matches the amber headphones circle in MicMixer's overlay."
                                               MaxWidth="260"
                                               TextWrapping="Wrap"/>
                                </ToolTip>
                            </Button.ToolTip>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd"
                                            Background="Transparent"
                                            BorderBrush="#3AFFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="0,4">
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center">
                                            <Grid Width="11"
                                                  Height="11"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,5,0">
                                                <Path x:Name="Glyph"
                                                      Data="{StaticResource MusicIconHeadphones}"
                                                      Stretch="Uniform"
                                                      Fill="#8B9FB5"/>
                                                <Path x:Name="GlyphSlash"
                                                      Data="{StaticResource MusicIconSlash}"
                                                      Stretch="Uniform"
                                                      Fill="#8B9FB5"/>
                                            </Grid>
                                            <TextBlock x:Name="Label"
                                                       Text="Monitor only"
                                                       FontSize="10.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="#8B9FB5"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock x:Name="StateWord"
                                                       Text="off"
                                                       FontSize="10.5"
                                                       Foreground="#6B7C90"
                                                       VerticalAlignment="Center"
                                                       Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                Value="True">
                                            <Setter TargetName="Bd"
                                                    Property="Background"
                                                    Value="#2AFFFFFF"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding MusicWidget.MusicMonitorOnly}"
                                                Value="True">
                                            <Setter TargetName="Bd"
                                                    Property="Background"
                                                    Value="#4A3308"/>
                                            <Setter TargetName="Bd"
                                                    Property="BorderBrush"
                                                    Value="#FFC66D"/>
                                            <Setter TargetName="Glyph"
                                                    Property="Fill"
                                                    Value="#FFC66D"/>
                                            <Setter TargetName="GlyphSlash"
                                                    Property="Visibility"
                                                    Value="Collapsed"/>
                                            <Setter TargetName="Label"
                                                    Property="Foreground"
                                                    Value="#FFC66D"/>
                                            <Setter TargetName="StateWord"
                                                    Property="Text"
                                                    Value="on"/>
                                            <Setter TargetName="StateWord"
                                                    Property="Foreground"
                                                    Value="#FFC66D"/>
                                            <Setter TargetName="StateWord"
                                                    Property="FontWeight"
                                                    Value="SemiBold"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Command="{Binding MusicWidget.ToggleMusicIgnoresPushToTalkCommand}"
                                Margin="3,0,0,0"
                                Cursor="Hand"
                                ToolTipService.ShowDuration="60000">
                            <Button.ToolTip>
                                <ToolTip>
                                    <TextBlock Text="Ignore PTT — while ON, the music keeps playing into the mic channel when push-to-talk holds your voice silent. Only relevant while MicMixer's push-to-talk is on."
                                               MaxWidth="260"
                                               TextWrapping="Wrap"/>
                                </ToolTip>
                            </Button.ToolTip>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd"
                                            Background="Transparent"
                                            BorderBrush="#3AFFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="0,4">
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center">
                                            <Grid Width="11"
                                                  Height="11"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,5,0">
                                                <Path x:Name="Glyph"
                                                      Data="{StaticResource MusicIconNote}"
                                                      Stretch="Uniform"
                                                      Fill="#8B9FB5"/>
                                                <Path x:Name="GlyphSlash"
                                                      Data="{StaticResource MusicIconSlash}"
                                                      Stretch="Uniform"
                                                      Fill="#8B9FB5"/>
                                            </Grid>
                                            <TextBlock x:Name="Label"
                                                       Text="Ignore PTT"
                                                       FontSize="10.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="#8B9FB5"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock x:Name="StateWord"
                                                       Text="off"
                                                       FontSize="10.5"
                                                       Foreground="#6B7C90"
                                                       VerticalAlignment="Center"
                                                       Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                Value="True">
                                            <Setter TargetName="Bd"
                                                    Property="Background"
                                                    Value="#2AFFFFFF"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding MusicWidget.MusicIgnoresPushToTalk}"
                                                Value="True">
                                            <Setter TargetName="Bd"
                                                    Property="Background"
                                                    Value="#3A2F63"/>
                                            <Setter TargetName="Bd"
                                                    Property="BorderBrush"
                                                    Value="#C9BEFF"/>
                                            <Setter TargetName="Glyph"
                                                    Property="Fill"
                                                    Value="#C9BEFF"/>
                                            <Setter TargetName="GlyphSlash"
                                                    Property="Visibility"
                                                    Value="Collapsed"/>
                                            <Setter TargetName="Label"
                                                    Property="Foreground"
                                                    Value="#C9BEFF"/>
                                            <Setter TargetName="StateWord"
                                                    Property="Text"
                                                    Value="on"/>
                                            <Setter TargetName="StateWord"
                                                    Property="Foreground"
                                                    Value="#C9BEFF"/>
                                            <Setter TargetName="StateWord"
                                                    Property="FontWeight"
                                                    Value="SemiBold"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </UniformGrid>

                    <TextBlock Text="{Binding MusicWidget.ErrorMessage}"
                               Foreground="#FF9B9B"
                               FontSize="10.5"
                               TextWrapping="Wrap"
                               Margin="0,7,0,0"
                               Visibility="{Binding MusicWidget.ErrorMessage, Converter={StaticResource HasTextVisibility}}"/>
                </StackPanel>

                <!-- Queue + library (hidden in compact mode) -->
                <Grid Grid.Row="3"
                        Visibility="{Binding MusicWidget.ShowPlayerControls, Converter={StaticResource BoolToVisibility}}">
                    <Grid Margin="12,4,12,10"
                            Visibility="{Binding MusicWidgetMinimized, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Queue -->
                        <DockPanel Grid.Row="0"
                                Margin="0,4,0,0"
                                Visibility="{Binding MusicWidget.HasQueue, Converter={StaticResource BoolToVisibility}}">
                            <Button Content="Clear"
                                    DockPanel.Dock="Right"
                                    Command="{Binding MusicWidget.ClearQueueCommand}"
                                    Style="{StaticResource TopMiniButton}"
                                    FontSize="11"
                                    ToolTip="Clear the queue"/>
                            <TextBlock Text="{Binding MusicWidget.QueueCountText}"
                                       Foreground="#B9A8F5"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                        <ScrollViewer Grid.Row="1"
                                      MaxHeight="126"
                                      Margin="0,4,0,2"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Visibility="{Binding MusicWidget.HasQueue, Converter={StaticResource BoolToVisibility}}">
                            <ScrollViewer.Resources>
                                <Style TargetType="ScrollBar"
                                       BasedOn="{StaticResource MusicScrollBar}"/>
                            </ScrollViewer.Resources>
                            <ItemsControl ItemsSource="{Binding MusicWidget.Queue}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1CFFFFFF"
                                                CornerRadius="5"
                                                Padding="6,2"
                                                Margin="0,0,0,3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding NumberText}"
                                                           Foreground="#B9A8F5"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           MinWidth="20"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Name}"
                                                           Foreground="#ECF3FA"
                                                           FontSize="11.5"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           Margin="2,0,6,0"/>
                                                <Button Grid.Column="2"
                                                        Command="{Binding DataContext.MusicWidget.MoveQueueItemUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource TopMiniButton}"
                                                        Padding="4,2"
                                                        ToolTip="Move up">
                                                    <Path Data="{StaticResource MusicIconChevronUp}"
                                                          Width="9"
                                                          Height="9"
                                                          Stretch="Uniform"
                                                          Fill="#DCE7F2"/>
                                                </Button>
                                                <Button Grid.Column="3"
                                                        Command="{Binding DataContext.MusicWidget.MoveQueueItemDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource TopMiniButton}"
                                                        Padding="4,2"
                                                        ToolTip="Move down">
                                                    <Path Data="{StaticResource MusicIconChevronDown}"
                                                          Width="9"
                                                          Height="9"
                                                          Stretch="Uniform"
                                                          Fill="#DCE7F2"/>
                                                </Button>
                                                <Button Grid.Column="4"
                                                        Command="{Binding DataContext.MusicWidget.RemoveQueueItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource TopMiniButton}"
                                                        Padding="4,2"
                                                        ToolTip="Remove from the queue">
                                                    <Path Data="{StaticResource MusicIconClose}"
                                                          Width="8"
                                                          Height="8"
                                                          Stretch="Uniform"
                                                          Fill="#DCE7F2"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Library header -->
                        <DockPanel Grid.Row="2"
                                Margin="0,6,0,0">
                            <Button DockPanel.Dock="Right"
                                    Command="{Binding MusicWidget.RefreshLibraryCommand}"
                                    Style="{StaticResource TopMiniButton}"
                                    Padding="6,2"
                                    ToolTip="Rescan the music library">
                                <Path Data="{StaticResource MusicIconRefresh}"
                                      Width="11"
                                      Height="11"
                                      Stretch="Uniform"
                                      Fill="#DCE7F2"/>
                            </Button>
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding MusicWidget.TrackCountText}"
                                       Foreground="#8B9FB5"
                                       FontSize="10.5"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <TextBlock Text="Library"
                                       Foreground="#EAF2FA"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </DockPanel>

                        <!-- Search -->
                        <Grid Grid.Row="3"
                                Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <TextBox x:Name="MusicLibrarySearchBox"
                                         Text="{Binding MusicWidget.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Foreground="#EFF4FA"
                                         Background="#26000000"
                                         BorderBrush="#3CFFFFFF"
                                         BorderThickness="1"
                                         Padding="8,5"
                                         FontSize="12"
                                         ToolTip="Search the whole library"/>
                                <TextBlock Text="Search the library…"
                                           Foreground="#71859A"
                                           Margin="9,0,0,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MusicWidget.SearchQuery, Converter={StaticResource HasTextVisibility}}"
                                                             Value="Visible">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=MusicLibrarySearchBox}"
                                                             Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <Button Grid.Column="1"
                                    Command="{Binding MusicWidget.ClearSearchCommand}"
                                    Style="{StaticResource TopMiniButton}"
                                    Margin="6,0,0,0"
                                    Visibility="{Binding MusicWidget.SearchQuery, Converter={StaticResource HasTextVisibility}}">
                                <Path Data="{StaticResource MusicIconClose}"
                                      Width="9"
                                      Height="9"
                                      Stretch="Uniform"
                                      Fill="#DCE7F2"/>
                            </Button>
                        </Grid>

                        <!-- Folder filter chips -->
                        <ScrollViewer Grid.Row="4"
                                      Margin="0,8,0,0"
                                      MaxHeight="62"
                                      VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Disabled"
                                      CanContentScroll="False"
                                      Visibility="{Binding MusicWidget.ShowFolderFilter, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl ItemsSource="{Binding MusicWidget.Folders}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Name}"
                                                ToolTip="{Binding Name}"
                                                FontSize="11"
                                                Style="{StaticResource MusicFolderChipButton}"
                                                Command="{Binding DataContext.MusicWidget.SelectFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Track list -->
                        <TextBlock Grid.Row="5"
                                   Text="No tracks matched the current filter or search."
                                   Foreground="#8B9FB5"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   VerticalAlignment="Top"
                                   Margin="0,12,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility"
                                            Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding MusicWidget.HasTracks}"
                                                        Value="False"/>
                                                <Condition Binding="{Binding MusicWidget.IsLoadingTracks}"
                                                        Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility"
                                                    Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl Grid.Row="5"
                                      Margin="0,6,0,0"
                                      ItemsSource="{Binding MusicWidget.Tracks}"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      ScrollViewer.CanContentScroll="True">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  CanContentScroll="True"
                                                  Focusable="False">
                                        <ScrollViewer.Resources>
                                            <Style TargetType="ScrollBar"
                                                   BasedOn="{StaticResource MusicScrollBar}"/>
                                        </ScrollViewer.Resources>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="TrackRow"
                                            Background="#14FFFFFF"
                                            BorderBrush="Transparent"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="7,4"
                                            Margin="0,0,0,4"
                                            Cursor="Hand"
                                            ToolTip="Click to mark for the play and delayed-start buttons · double-click to play"
                                            ToolTipService.InitialShowDelay="900"
                                            MouseLeftButtonDown="MusicTrackRow_MouseLeftButtonDown">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="#ECF3FA"
                                                           FontSize="12"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Name}"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding FolderName}"
                                                               Foreground="#7F8FA2"
                                                               FontSize="10"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding QueueBadgeText}"
                                                               Foreground="#B9A8F5"
                                                               FontSize="10"
                                                               Margin="8,0,0,0"
                                                               Visibility="{Binding QueueBadgeText, Converter={StaticResource HasTextVisibility}}"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Command="{Binding DataContext.MusicWidget.PlayTrackCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource TopMiniButton}"
                                                    VerticalAlignment="Center"
                                                    ToolTip="Play now">
                                                <Path Data="{StaticResource MusicIconPlay}"
                                                      Width="10"
                                                      Height="10"
                                                      Stretch="Uniform"
                                                      Fill="#DCE7F2"/>
                                            </Button>
                                            <Button Grid.Column="2"
                                                    Command="{Binding DataContext.MusicWidget.EnqueueTrackCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource TopMiniButton}"
                                                    Margin="2,0,0,0"
                                                    VerticalAlignment="Center"
                                                    ToolTip="Add to the queue">
                                                <Path Data="{StaticResource MusicIconPlus}"
                                                      Width="10"
                                                      Height="10"
                                                      Stretch="Uniform"
                                                      Fill="#DCE7F2"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}"
                                                Value="True">
                                            <Setter TargetName="TrackRow"
                                                    Property="Background"
                                                    Value="#2E4A6EA0"/>
                                            <Setter TargetName="TrackRow"
                                                    Property="BorderBrush"
                                                    Value="#887FB2E5"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCurrent}"
                                                Value="True">
                                            <Setter TargetName="TrackRow"
                                                    Property="Background"
                                                    Value="#336C5CE7"/>
                                            <Setter TargetName="TrackRow"
                                                    Property="BorderBrush"
                                                    Value="#886C5CE7"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Grid.Row="6"
                                Content="Load more tracks"
                                Command="{Binding MusicWidget.LoadMoreTracksCommand}"
                                Style="{StaticResource TopMiniButton}"
                                FontSize="11"
                                HorizontalAlignment="Center"
                                Margin="0,2,0,0"
                                Visibility="{Binding MusicWidget.HasMoreTracks, Converter={StaticResource BoolToVisibility}}"/>

                        <TextBlock Grid.Row="7"
                                   Text="{Binding MusicWidget.StatusText}"
                                   Foreground="#7F8FA2"
                                   FontSize="10.5"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0"
                                   Visibility="{Binding MusicWidget.StatusText, Converter={StaticResource HasTextVisibility}}"/>
                    </Grid>
                </Grid>

                <!-- Bottom corner resize handles (full mode only) -->
                <Grid Grid.RowSpan="4"
                        Visibility="{Binding MusicWidget.ShowPlayerControls, Converter={StaticResource BoolToVisibility}}">
                    <Border Width="14"
                            Height="14"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Margin="-7,0,0,-7"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="SizeNESW"
                            Panel.ZIndex="20"
                            Visibility="{Binding MusicWidgetMinimized, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"
                            MouseLeftButtonDown="MusicWidgetResizeHandle_MouseLeftButtonDown"
                            MouseMove="MusicWidgetResizeHandle_MouseMove"
                            MouseLeftButtonUp="MusicWidgetResizeHandle_MouseLeftButtonUp"/>
                    <Border Width="14"
                            Height="14"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,0,-7,-7"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="SizeNWSE"
                            Panel.ZIndex="20"
                            Visibility="{Binding MusicWidgetMinimized, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"
                            MouseLeftButtonDown="MusicWidgetResizeRightHandle_MouseLeftButtonDown"
                            MouseMove="MusicWidgetResizeRightHandle_MouseMove"
                            MouseLeftButtonUp="MusicWidgetResizeRightHandle_MouseLeftButtonUp"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Bottom status -->
        <TextBlock VerticalAlignment="Bottom"
                   Foreground="#666666"
                   FontSize="12"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,15">
            <Run Text="Press Esc to close · Drag bar to reposition · "/>
            <Run Text="{Binding HotkeyDisplayText, Mode=OneWay}"
                    FontWeight="Bold"/>
            <Run Text=" to toggle"/>
        </TextBlock>
    </Grid>
</Window>
