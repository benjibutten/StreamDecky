<Window x:Class="StreamDecky.Views.SpeedReaderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StreamDecky speed reader"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <!-- The margin leaves room for the shadow; transparent pixels are click-through. -->
    <Border Margin="28"
            CornerRadius="16"
            Background="#1A1A28"
            BorderBrush="#2EFFFFFF"
            BorderThickness="1">
        <Border.LayoutTransform>
            <ScaleTransform x:Name="RootScale"/>
        </Border.LayoutTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.6" Color="Black"/>
        </Border.Effect>

        <Grid Margin="28,14,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,2">
                <Button DockPanel.Dock="Right"
                        Content="✕"
                        ToolTip="Close (Esc)"
                        Click="Close_Click"
                        Focusable="False"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Width="26" Height="26" CornerRadius="13" Background="Transparent">
                                <TextBlock Text="{TemplateBinding Content}" FontSize="12" Foreground="#8A8AA3"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <TextBlock x:Name="WpmText"
                           DockPanel.Dock="Right"
                           Margin="0,0,10,0"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#9D93F5"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText"
                           FontSize="12"
                           Foreground="#8A8AA3"
                           VerticalAlignment="Center"/>
            </DockPanel>

            <!-- Fixed width: the word's font size is fitted against it before the first layout pass. -->
            <Grid x:Name="Stage"
                  Grid.Row="1"
                  Width="648"
                  Height="150"
                  Margin="0,0,8,0"
                  Background="Transparent"
                  Cursor="Hand"
                  MouseLeftButtonUp="Stage_MouseLeftButtonUp">
                <Border Height="1" VerticalAlignment="Top" Margin="0,16,0,0" Background="#26FFFFFF"/>
                <Border Width="2" Height="16" VerticalAlignment="Top" Margin="0,16,0,0" Background="#55FFFFFF"/>
                <Border Height="1" VerticalAlignment="Bottom" Margin="0,0,0,16" Background="#26FFFFFF"/>
                <Border Width="2" Height="16" VerticalAlignment="Bottom" Margin="0,0,0,16" Background="#55FFFFFF"/>

                <!-- Equal side columns keep the pivot letter at the exact horizontal centre. -->
                <Grid x:Name="WordGrid" VerticalAlignment="Center" TextElement.Foreground="#F4F4F8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="BeforeText" TextAlignment="Right"/>
                    <TextBlock x:Name="PivotText" Grid.Column="1" Foreground="#FF5C6E"/>
                    <TextBlock x:Name="AfterText" Grid.Column="2"/>
                </Grid>

                <TextBlock x:Name="MessageText"
                           Visibility="Collapsed"
                           FontSize="16"
                           Foreground="#B4B4C8"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>

            <Grid x:Name="ProgressRow" Grid.Row="2" Height="3" Margin="0,4,8,10">
                <Border CornerRadius="1.5" Background="#2C2C42"/>
                <Border CornerRadius="1.5" Background="#6C5CE7" RenderTransformOrigin="0,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="ProgressScale" ScaleX="0"/>
                    </Border.RenderTransform>
                </Border>
            </Grid>

            <Grid x:Name="FooterRow" Grid.Row="3" Margin="0,0,8,0" TextElement.FontSize="11.5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PositionText" Foreground="#8A8AA3"/>
                <TextBlock Grid.Column="1"
                           Text="Space  pause   ·   ← →  word   ·   ↑ ↓  speed   ·   Esc  close"
                           Foreground="#5F5F78"/>
                <TextBlock x:Name="RemainingText" Grid.Column="2" Foreground="#8A8AA3" TextAlignment="Right"/>
            </Grid>
        </Grid>
    </Border>
</Window>
