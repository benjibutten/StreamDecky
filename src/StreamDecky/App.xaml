<Application x:Class="StreamDecky.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:StreamDecky"
             xmlns:helpers="clr-namespace:StreamDecky.Helpers">
    <Application.Resources>
        <helpers:BoolToBrushConverter x:Key="BoolToColor"/>
        <!-- Vector geometry keeps the settings icon looking like a cog on every Windows font/theme. -->
