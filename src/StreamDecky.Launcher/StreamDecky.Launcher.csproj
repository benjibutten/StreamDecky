<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Native code, so the .NET runtime variables it removes cannot load anything into it. -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StartupHookSupport>false</StartupHookSupport>
    <!-- NativeAOT writes a .pdb even with DebugType=None; it has no place in a release. -->
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <ApplicationIcon>..\StreamDecky\StreamDecky.ico</ApplicationIcon>
    <Authors>benjibutten</Authors>
    <Company>StreamDecky</Company>
    <Product>StreamDecky</Product>
    <AssemblyTitle>StreamDecky</AssemblyTitle>
    <Description>Starts StreamDecky as administrator.</Description>
    <Version Condition="'$(Version)' == ''">1.0.0-local</Version>
  </PropertyGroup>

</Project>
