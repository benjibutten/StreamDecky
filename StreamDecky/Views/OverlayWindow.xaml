<Window x:Class="StreamDecky.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:StreamDecky.Helpers"
        WindowStyle="None"
        AllowsTransparency="True"
        WindowState="Maximized"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        KeyDown="Window_KeyDown"
        Loaded="Window_Loaded"
        Background="Transparent">

    <Window.Resources>
        <helpers:StringToBrushConverter x:Key="StringToBrush"/>
        <helpers:DoubleToCornerRadiusConverter x:Key="DoubleToCornerRadius"/>
        <helpers:SpacingToThicknessConverter x:Key="SpacingToThickness"/>
        <helpers:HasTextToVisibilityConverter x:Key="HasTextVisibility"/>
        <helpers:PathToImageSourceConverter x:Key="PathToImageSource"/>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <helpers:StringEqualsConverter x:Key="StringEquals"/>
        <helpers:ButtonShapeToGeometryConverter x:Key="ShapeToGeometry"/>
        <helpers:CellImageBrushConverter x:Key="CellImageBrush"/>
        <helpers:AdaptiveButtonSizeConverter x:Key="AdaptiveButtonSize"/>
        <helpers:CellClusterCornerRadiusConverter x:Key="CellClusterCornerRadius"/>

        <Style x:Key="TopMiniButton"
                TargetType="Button">
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Foreground"
                    Value="#F2F2F2"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Padding"
                    Value="6,2"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="#34FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="#46FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                    Value="False">
                                <Setter TargetName="Bd"
                                        Property="Opacity"
                                        Value="0.35"/>
                                <Setter Property="Foreground"
                                        Value="#88F2F2F2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuickFilterChipButton"
                TargetType="Button">
            <Setter Property="Background"
                    Value="#2AFFFFFF"/>
            <Setter Property="Foreground"
                    Value="#E6EEF8"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Padding"
                    Value="10,4"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Margin"
                    Value="0,0,6,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="#3AFFFFFF"/>
                            </Trigger>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{StaticResource StringEquals}">
                                        <Binding Path="Id"/>
                                        <Binding Path="DataContext.SelectedQuickTextCategoryId"
                                                RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="#4A6EA0"/>
                                <Setter Property="Foreground"
                                        Value="White"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Full screen overlay background with slight transparency -->
    <Grid Background="#20808080">

        <!-- Top bar with close button -->
        <DockPanel VerticalAlignment="Top"
                Margin="20,15,20,0"
                Panel.ZIndex="10">
            <Button Content="✕ Close (Esc)"
                    DockPanel.Dock="Right"
                    Click="CloseButton_Click"
                    Background="#44FFFFFF"
                    Foreground="White"
                    BorderThickness="0"
                    Padding="16,8"
                    FontSize="14"
                    Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter Property="Background"
                                        Value="#66FFFFFF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Border DockPanel.Dock="Right"
                    Margin="0,0,8,0"
                    Padding="6,4"
                    Background="#22000000"
                    CornerRadius="6">
                <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">
                    <TextBlock Text="Areas"
                               Foreground="#DCDCDC"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="4,0,8,0"/>
                    <Button Content="◀"
                            Command="{Binding PreviousNotePageCommand}"
                            IsEnabled="{Binding CanGoToPreviousNotePage}"
                            FontSize="12"
                            Style="{StaticResource TopMiniButton}"/>
                    <TextBlock Text="{Binding NotePageIndicator}"
                               Foreground="#ECECEC"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="6,0"/>
                    <Button Content="▶"
                            Command="{Binding NextNotePageCommand}"
                            IsEnabled="{Binding CanGoToNextNotePage}"
                            FontSize="12"
                            Style="{StaticResource TopMiniButton}"/>
                </StackPanel>
            </Border>

            <Button Content="＋ Note"
                    DockPanel.Dock="Right"
                    Command="{Binding AddStickyNoteCommand}"
                    Background="#2F000000"
                    Foreground="#EEEEEE"
                    BorderThickness="0"
                    Padding="12,8"
                    Margin="0,0,8,0"
                    FontSize="13"
                    Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter Property="Background"
                                        Value="#4A000000"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <StackPanel DockPanel.Dock="Right"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="0,0,12,0">
                <Path Data="M1,0 H3 A1,1,0,0,1,4,1 V3 A1,1,0,0,1,3,4 H1 A1,1,0,0,1,0,3 V1 A1,1,0,0,1,1,0 Z M6,0 H8 A1,1,0,0,1,9,1 V3 A1,1,0,0,1,8,4 H6 A1,1,0,0,1,5,3 V1 A1,1,0,0,1,6,0 Z M1,5 H3 A1,1,0,0,1,4,6 V8 A1,1,0,0,1,3,9 H1 A1,1,0,0,1,0,8 V6 A1,1,0,0,1,1,5 Z M6,5 H8 A1,1,0,0,1,9,6 V8 A1,1,0,0,1,8,9 H6 A1,1,0,0,1,5,8 V6 A1,1,0,0,1,6,5 Z"
                      Fill="#AAAAAA"
                        Width="16"
                        Height="16"
                        Stretch="Uniform"
                        Margin="0,0,8,0"/>
                <TextBlock Text="StreamDecky"
                           Foreground="#AAAAAA"
                           FontSize="16"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>
                <TextBlock Text=" • "
                           Foreground="#7F8FA2"
                           FontSize="14"
                           VerticalAlignment="Center"
                           Margin="6,0,4,0"/>
                <TextBlock Text="{Binding ActiveProfileName}"
                           Foreground="#B7C7D8"
                           FontSize="12"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>
            </StackPanel>

            <Border/>
        </DockPanel>

        <!-- Draggable button grid container -->
        <Border x:Name="ButtonGridContainer"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="Transparent"
                Padding="0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="GridTranslate"
                                    X="{Binding GridOffsetX, Mode=TwoWay}"
                                    Y="{Binding GridOffsetY, Mode=TwoWay}"/>
            </Border.RenderTransform>

            <StackPanel>
                <!-- Drag handle (visible only on hover) -->
                <Border x:Name="DragHandle"
                        CornerRadius="6,6,0,0"
                        Padding="0,6"
                        Cursor="SizeAll"
                        MouseLeftButtonDown="DragHandle_MouseLeftButtonDown"
                        MouseMove="DragHandle_MouseMove"
                        MouseLeftButtonUp="DragHandle_MouseLeftButtonUp">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background"
                                    Value="Transparent"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver"
                                        Value="True">
                                    <Setter Property="Background"
                                            Value="#22FFFFFF"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center"
                            Orientation="Horizontal">
                        <Border Width="40"
                                Height="4"
                                CornerRadius="2">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background"
                                            Value="Transparent"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=DragHandle}"
                                                Value="True">
                                            <Setter Property="Background"
                                                    Value="#44FFFFFF"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Deck button grid -->
                <Border x:Name="GridClipBorder"
                        Background="Transparent"
                        CornerRadius="12"
                        Padding="0"
                        Opacity="{Binding ButtonOverlayOpacity}">
                    <Grid>
                        <Grid.OpacityMask>
                            <VisualBrush>
                                <VisualBrush.Visual>
                                    <Border Background="Black"
                                            CornerRadius="12"
                                            Width="{Binding ActualWidth, ElementName=GridClipBorder}"
                                            Height="{Binding ActualHeight, ElementName=GridClipBorder}"/>
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </Grid.OpacityMask>
                        <ItemsControl ItemsSource="{Binding Buttons}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="{Binding Columns}"
                                            Rows="{Binding Rows}"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- CellBg fills the entire UniformGrid cell, slight overlap kills hairline gaps -->
                                    <Border x:Name="CellBg"
                                            Margin="-1"
                                            ClipToBounds="True"
                                            Background="{Binding DataContext.OverlayBackgroundColor, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource StringToBrush}}">
                                        <Border.CornerRadius>
                                            <MultiBinding Converter="{StaticResource CellClusterCornerRadius}"
                                                    ConverterParameter="14">
                                                <Binding Path="Index"/>
                                                <Binding Path="DataContext.Columns"
                                                        RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                <Binding Path="DataContext.Rows"
                                                        RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                <Binding Path="DataContext.Buttons"
                                                        RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                <Binding Path="DataContext.ButtonVisualVersion"
                                                        RelativeSource="{RelativeSource AncestorType=Window}"/>
                                            </MultiBinding>
                                        </Border.CornerRadius>
                                        <Grid>
                                            <!-- Global background image portion for this cell -->
                                            <Border x:Name="BgImageLayer">
                                                <Border.Background>
                                                    <MultiBinding Converter="{StaticResource CellImageBrush}">
                                                        <Binding Path="DataContext.OverlayBackgroundImagePath"
                                                                RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                        <Binding Path="Index"/>
                                                        <Binding Path="DataContext.Columns"
                                                                RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                        <Binding Path="DataContext.Rows"
                                                                RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                        <Binding Path="DataContext.OverlayBackgroundImageVersion"
                                                                RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                    </MultiBinding>
                                                </Border.Background>
                                                <Border.CornerRadius>
                                                    <MultiBinding Converter="{StaticResource CellClusterCornerRadius}"
                                                            ConverterParameter="14">
                                                        <Binding Path="Index"/>
                                                        <Binding Path="DataContext.Columns"
                                                                RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                        <Binding Path="DataContext.Rows"
                                                                RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                        <Binding Path="DataContext.Buttons"
                                                                RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                        <Binding Path="DataContext.ButtonVisualVersion"
                                                                RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                    </MultiBinding>
                                                </Border.CornerRadius>
                                            </Border>
                                            <!-- Button content with spacing margin -->
                                            <Button x:Name="CellButton"
                                                    Margin="{Binding DataContext.ButtonSpacing, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SpacingToThickness}}"
                                                    Click="DeckButton_Click"
                                                    Tag="{Binding}"
                                                    Cursor="Hand">
                                                <Button.Width>
                                                    <MultiBinding Converter="{StaticResource AdaptiveButtonSize}"
                                                            ConverterParameter="180,220,22">
                                                        <Binding Path="DataContext.ButtonSize"
                                                                RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                        <Binding Path="DataContext.ButtonSpacing"
                                                                RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                        <Binding Path="DataContext.Columns"
                                                                RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                        <Binding Path="DataContext.Rows"
                                                                RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                        <Binding Path="ActualWidth"
                                                                RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                        <Binding Path="ActualHeight"
                                                                RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                    </MultiBinding>
                                                </Button.Width>
                                                <Button.Height>
                                                    <MultiBinding Converter="{StaticResource AdaptiveButtonSize}"
                                                            ConverterParameter="180,220,22">
                                                        <Binding Path="DataContext.ButtonSize"
                                                                RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                        <Binding Path="DataContext.ButtonSpacing"
                                                                RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                        <Binding Path="DataContext.Columns"
                                                                RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                        <Binding Path="DataContext.Rows"
                                                                RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                        <Binding Path="ActualWidth"
                                                                RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                        <Binding Path="ActualHeight"
                                                                RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                    </MultiBinding>
                                                </Button.Height>
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Grid>
                                                                        <!-- Regular background (non-shaped) -->
                                                                        <Border x:Name="RegularBg"
                                                                                CornerRadius="{Binding CornerRadius, Converter={StaticResource DoubleToCornerRadius}}"
                                                                                BorderThickness="2"
                                                                                BorderBrush="Transparent"
                                                                                Background="{Binding BackgroundColor, Converter={StaticResource StringToBrush}}">
                                                                            <Grid>
                                                                                <Grid.OpacityMask>
                                                                                    <VisualBrush>
                                                                                        <VisualBrush.Visual>
                                                                                            <Border Background="Black"
                                                                                                    CornerRadius="{Binding CornerRadius, Converter={StaticResource DoubleToCornerRadius}}"
                                                                                                    Width="{Binding ActualWidth, ElementName=RegularBg}"
                                                                                                    Height="{Binding ActualHeight, ElementName=RegularBg}"/>
                                                                                        </VisualBrush.Visual>
                                                                                    </VisualBrush>
                                                                                </Grid.OpacityMask>
                                                                                <Image Source="{Binding ImagePath, Converter={StaticResource PathToImageSource}, ConverterParameter=256}"
                                                                                       Stretch="UniformToFill"
                                                                                       Visibility="{Binding ImagePath, Converter={StaticResource HasTextVisibility}}"/>
                                                                                <StackPanel VerticalAlignment="Center"
                                                                                        HorizontalAlignment="Center">
                                                                                    <TextBlock Text="{Binding IconText}"
                                                                                               FontSize="24"
                                                                                               HorizontalAlignment="Center"
                                                                                               Foreground="{Binding TextColor, Converter={StaticResource StringToBrush}}"
                                                                                               Visibility="{Binding IconText, Converter={StaticResource HasTextVisibility}}"/>
                                                                                    <TextBlock Text="{Binding DisplayTitle}"
                                                                                               FontSize="13"
                                                                                               TextWrapping="Wrap"
                                                                                               TextAlignment="Center"
                                                                                               HorizontalAlignment="Center"
                                                                                               Foreground="{Binding TextColor, Converter={StaticResource StringToBrush}}"
                                                                                               Margin="4,2,4,0"/>
                                                                                </StackPanel>
                                                                            </Grid>
                                                                        </Border>
                                                                        <!-- Shape background (shaped buttons) -->
                                                                        <Grid x:Name="ShapeGrid"
                                                                                Visibility="Collapsed">
                                                                            <Path x:Name="ShapeBg"
                                                                                  Data="{Binding Shape, Converter={StaticResource ShapeToGeometry}}"
                                                                                  Fill="{Binding BackgroundColor, Converter={StaticResource StringToBrush}}"
                                                                                  Stretch="Fill"
                                                                                  StrokeThickness="2"
                                                                                  Stroke="Transparent"/>
                                                                            <StackPanel VerticalAlignment="Center"
                                                                                    HorizontalAlignment="Center"
                                                                                    Margin="15">
                                                                                <TextBlock Text="{Binding IconText}"
                                                                                           FontSize="24"
                                                                                           HorizontalAlignment="Center"
                                                                                           Foreground="{Binding TextColor, Converter={StaticResource StringToBrush}}"
                                                                                           Visibility="{Binding IconText, Converter={StaticResource HasTextVisibility}}"/>
                                                                                <TextBlock Text="{Binding DisplayTitle}"
                                                                                           FontSize="13"
                                                                                           TextWrapping="Wrap"
                                                                                           TextAlignment="Center"
                                                                                           HorizontalAlignment="Center"
                                                                                           Foreground="{Binding TextColor, Converter={StaticResource StringToBrush}}"
                                                                                           Margin="4,2,4,0"/>
                                                                            </StackPanel>
                                                                        </Grid>
                                                                    </Grid>
                                                                    <ControlTemplate.Triggers>
                                                                        <DataTrigger Binding="{Binding HasShape}"
                                                                                Value="True">
                                                                            <Setter TargetName="RegularBg"
                                                                                    Property="Visibility"
                                                                                    Value="Collapsed"/>
                                                                            <Setter TargetName="ShapeGrid"
                                                                                    Property="Visibility"
                                                                                    Value="Visible"/>
                                                                        </DataTrigger>
                                                                        <Trigger Property="IsMouseOver"
                                                                                Value="True">
                                                                            <Setter TargetName="RegularBg"
                                                                                    Property="BorderBrush"
                                                                                    Value="#88FFFFFF"/>
                                                                            <Setter TargetName="ShapeBg"
                                                                                    Property="Stroke"
                                                                                    Value="#88FFFFFF"/>
                                                                        </Trigger>
                                                                        <Trigger Property="IsPressed"
                                                                                Value="True">
                                                                            <Setter TargetName="RegularBg"
                                                                                    Property="Opacity"
                                                                                    Value="0.8"/>
                                                                            <Setter TargetName="ShapeBg"
                                                                                    Property="Opacity"
                                                                                    Value="0.8"/>
                                                                        </Trigger>
                                                                        <DataTrigger Binding="{Binding IsSelected}"
                                                                                Value="True">
                                                                            <Setter TargetName="RegularBg"
                                                                                    Property="BorderBrush"
                                                                                    Value="#6C5CE7"/>
                                                                            <Setter TargetName="RegularBg"
                                                                                    Property="BorderThickness"
                                                                                    Value="3"/>
                                                                            <Setter TargetName="ShapeBg"
                                                                                    Property="Stroke"
                                                                                    Value="#6C5CE7"/>
                                                                            <Setter TargetName="ShapeBg"
                                                                                    Property="StrokeThickness"
                                                                                    Value="3"/>
                                                                        </DataTrigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsConfigured}"
                                                Value="False">
                                            <Setter TargetName="CellBg"
                                                    Property="Background"
                                                    Value="Transparent"/>
                                            <Setter TargetName="BgImageLayer"
                                                    Property="Visibility"
                                                    Value="Collapsed"/>
                                            <Setter TargetName="CellButton"
                                                    Property="Visibility"
                                                    Value="Hidden"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </Grid>
                </Border>

                <!-- Subtle page navigator near buttons -->
                <Border Margin="2,9,0,0"
                        HorizontalAlignment="Left"
                        Padding="8,4"
                        Background="#16000000"
                        CornerRadius="7"
                        Visibility="{Binding HasMultiplePages, Converter={StaticResource BoolToVisibility}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Opacity"
                                    Value="0.58"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver"
                                        Value="True">
                                    <Setter Property="Opacity"
                                            Value="1"/>
                                    <Setter Property="Background"
                                            Value="#34000000"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                        <Button Content="◀"
                                Click="OverlayPrevPage_Click"
                                Background="Transparent"
                                Foreground="#F2F2F2"
                                FontSize="13"
                                Padding="8,3"
                                BorderThickness="0"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="4"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver"
                                                            Value="True">
                                                        <Setter TargetName="Bd"
                                                                Property="Background"
                                                                Value="#48FFFFFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                        <TextBlock Text="{Binding PageIndicator}"
                                Foreground="#F2F2F2"
                                FontSize="12"
                                   VerticalAlignment="Center"
                                Margin="8,0"/>
                        <Button Content="▶"
                                Click="OverlayNextPage_Click"
                                Background="Transparent"
                                Foreground="#F2F2F2"
                                FontSize="13"
                                Padding="8,3"
                                BorderThickness="0"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="4"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver"
                                                            Value="True">
                                                        <Setter TargetName="Bd"
                                                                Property="Background"
                                                                Value="#48FFFFFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Sticky notes layer (per page) -->
        <ItemsControl ItemsSource="{Binding StickyNotes}"
                      Margin="0"
                      Panel.ZIndex="8">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left"
                            Value="{Binding X}"/>
                    <Setter Property="Canvas.Top"
                            Value="{Binding Y}"/>
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Width="{Binding Width}"
                            Height="{Binding DisplayHeight}"
                            Opacity="{Binding DataContext.ButtonOverlayOpacity, RelativeSource={RelativeSource AncestorType=Window}}"
                            Background="{Binding Color, Converter={StaticResource StringToBrush}}"
                            CornerRadius="10"
                            BorderBrush="#20000000"
                            BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14"
                                    ShadowDepth="5"
                                    Opacity="0.3"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="28"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="#17000000"
                                    CornerRadius="10,10,0,0"
                                    Cursor="SizeAll"
                                    MouseLeftButtonDown="StickyNoteHandle_MouseLeftButtonDown"
                                    MouseMove="StickyNoteHandle_MouseMove"
                                    MouseLeftButtonUp="StickyNoteHandle_MouseLeftButtonUp">
                                <DockPanel LastChildFill="True"
                                        Margin="6,0,6,0">
                                    <StackPanel DockPanel.Dock="Right"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                        <Button Tag="#F8E784"
                                                Click="StickyNoteColor_Click"
                                                Background="#F8E784"
                                                BorderBrush="#44000000"
                                                BorderThickness="1"
                                                Width="14"
                                                Height="14"
                                                Margin="0,0,4,0"
                                                Cursor="Hand"/>
                                        <Button Tag="#F7B3A9"
                                                Click="StickyNoteColor_Click"
                                                Background="#F7B3A9"
                                                BorderBrush="#44000000"
                                                BorderThickness="1"
                                                Width="14"
                                                Height="14"
                                                Margin="0,0,4,0"
                                                Cursor="Hand"/>
                                        <Button Tag="#AEE2FF"
                                                Click="StickyNoteColor_Click"
                                                Background="#AEE2FF"
                                                BorderBrush="#44000000"
                                                BorderThickness="1"
                                                Width="14"
                                                Height="14"
                                                Margin="0,0,4,0"
                                                Cursor="Hand"/>
                                        <Button Tag="#D4F7B0"
                                                Click="StickyNoteColor_Click"
                                                Background="#D4F7B0"
                                                BorderBrush="#44000000"
                                                BorderThickness="1"
                                                Width="14"
                                                Height="14"
                                                Margin="0,0,8,0"
                                                Cursor="Hand"/>
                                        <Button Click="StickyNoteMinimize_Click"
                                                Background="Transparent"
                                                Foreground="#4C4C4C"
                                                BorderThickness="0"
                                                FontSize="11"
                                                Padding="0"
                                                Width="18"
                                                Height="18"
                                                Margin="0,0,4,0"
                                                Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Content"
                                                            Value="_"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMinimized}"
                                                                Value="True">
                                                            <Setter Property="Content"
                                                                    Value="[]"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="✕"
                                                Click="StickyNoteRemove_Click"
                                                Background="Transparent"
                                                Foreground="#4C4C4C"
                                                BorderThickness="0"
                                                FontSize="11"
                                                Padding="0"
                                                Width="18"
                                                Height="18"
                                                Cursor="Hand"/>
                                    </StackPanel>
                                    <Grid VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}"
                                                   Foreground="#4A4A4A"
                                                   FontWeight="SemiBold"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding IsEditingTitle, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"/>
                                        <TextBox Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                 Tag="StickyNoteTitleEditor"
                                                 Foreground="#2D2D2D"
                                                 FontSize="11"
                                                 FontWeight="SemiBold"
                                                 BorderThickness="0"
                                                 Padding="2,0"
                                                 Background="#17FFFFFF"
                                                 VerticalContentAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 Visibility="{Binding IsEditingTitle, Converter={StaticResource BoolToVisibility}}"
                                                 LostKeyboardFocus="StickyNoteTitleEditor_LostKeyboardFocus"
                                                 KeyDown="StickyNoteTitleEditor_KeyDown"/>
                                    </Grid>
                                </DockPanel>
                            </Border>

                            <TextBox Grid.Row="1"
                                     Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     MouseDoubleClick="StickyNoteText_MouseDoubleClick"
                                     Visibility="{Binding IsMinimized, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Foreground="#2D2D2D"
                                     Margin="10,8,10,10"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Hidden"
                                     HorizontalScrollBarVisibility="Disabled"
                                     FontSize="{Binding DataContext.StickyNoteFontSize, RelativeSource={RelativeSource AncestorType=Window}}"/>

                            <Border Grid.RowSpan="2"
                                    Width="14"
                                    Height="14"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"
                                    Margin="-7,0,0,-7"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="SizeNESW"
                                    Visibility="{Binding IsMinimized, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"
                                    MouseLeftButtonDown="StickyNoteResizeHandle_MouseLeftButtonDown"
                                    MouseMove="StickyNoteResizeHandle_MouseMove"
                                    MouseLeftButtonUp="StickyNoteResizeHandle_MouseLeftButtonUp">
                                <Grid>
                                    <Line X1="4"
                                            Y1="10"
                                            X2="10"
                                            Y2="4"
                                          Stroke="#264C4C4C"
                                          StrokeThickness="1"
                                          SnapsToDevicePixels="True"/>
                                    <Line X1="6"
                                            Y1="10"
                                            X2="10"
                                            Y2="6"
                                          Stroke="#264C4C4C"
                                          StrokeThickness="1"
                                          SnapsToDevicePixels="True"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border x:Name="QuickTextPanel"
                Width="{Binding QuickTextPanelWidth, Mode=TwoWay}"
            Height="{Binding QuickTextPanelHeight, Mode=TwoWay}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="0"
                Panel.ZIndex="9"
                Visibility="{Binding HasAnyQuickTextItems, Converter={StaticResource BoolToVisibility}}"
                Background="{Binding OverlayBackgroundColor, Converter={StaticResource StringToBrush}}"
                Opacity="{Binding ButtonOverlayOpacity}"
                BorderBrush="#44FFFFFF"
                BorderThickness="1"
                CornerRadius="10">
            <Border.RenderTransform>
                <TranslateTransform X="{Binding QuickTextPanelX, Mode=TwoWay}"
                                    Y="{Binding QuickTextPanelY, Mode=TwoWay}"/>
            </Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Rectangle Grid.RowSpan="2"
                           Opacity="0.78"
                           Visibility="{Binding OverlayBackgroundImagePath, Converter={StaticResource HasTextVisibility}}">
                    <Rectangle.Fill>
                        <ImageBrush ImageSource="{Binding OverlayBackgroundImagePath, Converter={StaticResource PathToImageSource}}"
                                    Stretch="UniformToFill"/>
                    </Rectangle.Fill>
                </Rectangle>

                <Border Grid.RowSpan="2"
                        Background="#A810141D"
                        CornerRadius="10"/>

                <Border Grid.Row="0"
                        Background="#28000000"
                        CornerRadius="10,10,0,0"
                        Cursor="SizeAll"
                        MouseLeftButtonDown="QuickTextPanelHandle_MouseLeftButtonDown"
                        MouseMove="QuickTextPanelHandle_MouseMove"
                        MouseLeftButtonUp="QuickTextPanelHandle_MouseLeftButtonUp">
                    <Grid Margin="10,8,10,8"
                            VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Clipboard List"
                                       Foreground="#EAF2FA"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding QuickTextCategoryIndicator}"
                                       Foreground="#9EB0C4"
                                       FontSize="11"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <ScrollViewer Grid.Row="1"
                                      Margin="0,8,0,0"
                                      MaxHeight="72"
                                      VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Disabled"
                                      CanContentScroll="False">
                            <ItemsControl ItemsSource="{Binding QuickTextCategories}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Name}"
                                                ToolTip="{Binding Name}"
                                                Style="{StaticResource QuickFilterChipButton}"
                                                Command="{Binding DataContext.SetQuickTextCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Grid Grid.Row="1"
                        Margin="10,8,10,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Snabbkopiera text direkt till clipboarden · ✎ = tillfallig redigering (sparas inte)"
                               Foreground="#C4D3E4"
                               FontSize="11"
                               Margin="0,0,0,8"/>

                    <Grid Grid.Row="1"
                            Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding QuickTextSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Foreground="#EFF4FA"
                                 Background="#26000000"
                                 BorderBrush="#3CFFFFFF"
                                 BorderThickness="1"
                                 Padding="8,5"
                                 FontSize="12"
                                 ToolTip="Sok i alla kategorier"/>

                        <Button Grid.Column="1"
                                Command="{Binding ClearQuickTextSearchCommand}"
                                Content="✕"
                                Margin="6,0,0,0"
                                Padding="8,4"
                                Foreground="#DCE7F2"
                                Background="#2A000000"
                                BorderThickness="0"
                                FontSize="11"
                                Cursor="Hand"
                                Visibility="{Binding QuickTextSearchQuery, Converter={StaticResource HasTextVisibility}}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="4"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver"
                                                            Value="True">
                                                        <Setter TargetName="Bd"
                                                                Property="Background"
                                                                Value="#3C000000"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <TextBlock Grid.Row="2"
                               Text="Inga texter matchade filtret eller sokningen."
                               Foreground="#8B9FB5"
                               FontSize="12"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Visibility="{Binding HasQuickTextItems, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"/>

                    <ScrollViewer Grid.Row="2"
                                  MaxHeight="322"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding HasQuickTextItems, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding OverlayQuickTextItems, RelativeSource={RelativeSource AncestorType=Window}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#22000000"
                                            BorderBrush="#38FFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="6"
                                            Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Row="0"
                                                       Grid.Column="0"
                                                       Text="{Binding PreviewText}"
                                                       Foreground="#ECF3FA"
                                                       FontSize="{Binding DataContext.QuickTextFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       LineHeight="{Binding DataContext.QuickTextPreviewLineHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       LineStackingStrategy="BlockLineHeight"
                                                       MaxHeight="{Binding DataContext.QuickTextPreviewHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       Margin="0,0,6,0"
                                                       VerticalAlignment="Top"
                                                       Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"/>

                                            <TextBox Grid.Row="0"
                                                     Grid.Column="0"
                                                     Text="{Binding SessionText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Tag="QuickTextInlineEditor"
                                                     KeyDown="QuickTextInlineEditor_KeyDown"
                                                     Foreground="#EFF4FA"
                                                     Background="#26000000"
                                                     BorderBrush="#3CFFFFFF"
                                                     BorderThickness="1"
                                                     Padding="8,6"
                                                     FontSize="{Binding DataContext.QuickTextFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                     TextWrapping="Wrap"
                                                     AcceptsReturn="True"
                                                     VerticalContentAlignment="Top"
                                                     VerticalScrollBarVisibility="Hidden"
                                                     HorizontalScrollBarVisibility="Disabled"
                                                     Height="{Binding DataContext.QuickTextEditorHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                                     Margin="0,0,6,0"
                                                     Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}"/>
                                            <TextBlock Grid.Row="1"
                                                       Grid.Column="0"
                                                       Text="Tillfallig redigering aktiv for overlaysessionen"
                                                       Foreground="#92A8BF"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       LineHeight="{Binding DataContext.QuickTextHintLineHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       LineStackingStrategy="BlockLineHeight"
                                                       MaxHeight="{Binding DataContext.QuickTextHintMaxHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       FontSize="10"
                                                       Margin="0,4,6,0"
                                                       Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}"/>

                                            <Grid Grid.Row="0"
                                                  Grid.RowSpan="2"
                                                  Grid.Column="1"
                                                  Margin="0,2,0,0"
                                                  VerticalAlignment="Top">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="70"/>
                                                </Grid.ColumnDefinitions>

                                                <Button Click="QuickTextToggleEdit_Click"
                                                    Background="#2B3E50"
                                                        Foreground="#DCE7F2"
                                                        BorderThickness="0"
                                                        Padding="10,5"
                                                        Margin="0,0,4,0"
                                                        MinWidth="28"
                                                        Cursor="Hand"
                                                        VerticalAlignment="Center"
                                                        ToolTip="Tillfallig redigering (sparas inte)">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Content"
                                                                    Value="✎"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="Bd"
                                                                                Background="{TemplateBinding Background}"
                                                                                CornerRadius="4"
                                                                                Padding="{TemplateBinding Padding}">
                                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                                    VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver"
                                                                                    Value="True">
                                                                                <Setter TargetName="Bd"
                                                                                        Property="Background"
                                                                                        Value="#355069"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEditing}"
                                                                        Value="True">
                                                                    <Setter Property="Content"
                                                                            Value="✓"/>
                                                                    <Setter Property="Background"
                                                                        Value="#3E6E4D"/>
                                                                    <Setter Property="Foreground"
                                                                            Value="#F2FFF2"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <Button Grid.Column="1"
                                                        Content="Copy"
                                                        Click="QuickTextCopy_Click"
                                                    Background="#3A5A78"
                                                        Foreground="White"
                                                        BorderThickness="0"
                                                        Padding="0,5"
                                                        Cursor="Hand"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding DataContext.HasQuickTextAction, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="Bd"
                                                                                Background="{TemplateBinding Background}"
                                                                                CornerRadius="4"
                                                                                Padding="{TemplateBinding Padding}">
                                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                                    VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver"
                                                                                    Value="True">
                                                                                <Setter TargetName="Bd"
                                                                                        Property="Background"
                                                                                        Value="#476D91"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <Grid Grid.Column="1"
                                                      Visibility="{Binding DataContext.HasQuickTextAction, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Button Grid.Column="0"
                                                            Content="Copy"
                                                            Click="QuickTextCopy_Click"
                                                            Background="#2E5F93"
                                                            Foreground="White"
                                                            BorderThickness="0"
                                                            Padding="0,5"
                                                            Margin="0,0,1,0"
                                                            Cursor="Hand"
                                                            VerticalAlignment="Center">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="Bd"
                                                                                    Background="{TemplateBinding Background}"
                                                                                    CornerRadius="4"
                                                                                    Padding="{TemplateBinding Padding}">
                                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                        VerticalAlignment="Center"/>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver"
                                                                                        Value="True">
                                                                                    <Setter TargetName="Bd"
                                                                                            Property="Background"
                                                                                            Value="#3E76B0"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>

                                                    <Button Grid.Column="1"
                                                            Content="➜"
                                                            Click="QuickTextAction_Click"
                                                            Background="#3D7A37"
                                                            Foreground="White"
                                                            BorderThickness="0"
                                                            Padding="0,5"
                                                            Margin="1,0,0,0"
                                                            Cursor="Hand"
                                                            VerticalAlignment="Center"
                                                            ToolTip="Korer den delade clipboard-actionen med aktuell radtext">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="Bd"
                                                                                    Background="{TemplateBinding Background}"
                                                                                    CornerRadius="4"
                                                                                    Padding="{TemplateBinding Padding}">
                                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                        VerticalAlignment="Center"/>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver"
                                                                                        Value="True">
                                                                                    <Setter TargetName="Bd"
                                                                                            Property="Background"
                                                                                            Value="#50A046"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- Bottom-left resize handle -->
                <Border Grid.RowSpan="2"
                        Width="14"
                        Height="14"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Margin="-7,0,0,-7"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="SizeNESW"
                        Panel.ZIndex="20"
                        MouseLeftButtonDown="QuickTextPanelResizeHandle_MouseLeftButtonDown"
                        MouseMove="QuickTextPanelResizeHandle_MouseMove"
                        MouseLeftButtonUp="QuickTextPanelResizeHandle_MouseLeftButtonUp">
                    <Grid>
                        <Line X1="4" Y1="10" X2="10" Y2="4"
                              Stroke="#264C4C4C" StrokeThickness="1" SnapsToDevicePixels="True"/>
                        <Line X1="6" Y1="10" X2="10" Y2="6"
                              Stroke="#264C4C4C" StrokeThickness="1" SnapsToDevicePixels="True"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Bottom status -->
        <TextBlock VerticalAlignment="Bottom"
                   Foreground="#666666"
                   FontSize="12"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,15">
            <Run Text="Press Esc to close · Drag bar to reposition · "/>
            <Run Text="{Binding HotkeyDisplayText, Mode=OneWay}"
                    FontWeight="Bold"/>
            <Run Text=" to toggle"/>
        </TextBlock>
    </Grid>
</Window>
