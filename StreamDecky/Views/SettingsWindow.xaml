<Window x:Class="StreamDecky.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:StreamDecky.Helpers"
        Title="Settings"
        Width="420" Height="580"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E2E"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" 
                      ResizeBorderThickness="0" 
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <helpers:StringToBrushConverter x:Key="StringToBrush"/>

        <Style x:Key="ThinScrollBarThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#55FFFFFF" CornerRadius="3" Margin="1"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThinScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ThinScrollBarThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="6"/>
                    <Setter Property="MinHeight" Value="6"/>
                    <Setter Property="Width" Value="Auto"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DarkScrollViewer" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <ScrollContentPresenter/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       HorizontalAlignment="Right"
                                       Style="{StaticResource ThinScrollBar}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                       Margin="0,0,-14,0"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Custom Title Bar -->
        <Border DockPanel.Dock="Top" Background="#16162A" Height="32" MouseLeftButtonDown="SettingsTitleBar_MouseDown">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="⚙ Settings" Foreground="#CCCCCC" FontSize="13" 
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                <Button DockPanel.Dock="Right" Content="✕" Click="SettingsClose_Click"
                        Width="40" Height="32" FontSize="13"
                        Foreground="#999" Background="Transparent" BorderThickness="0" Cursor="Hand"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#C42B1C"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </DockPanel>
        </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource DarkScrollViewer}">
    <StackPanel Margin="24">
        <TextBlock Text="OVERLAY" Foreground="#666" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>

        <TextBlock Text="Background Color" Foreground="#AAA" FontSize="12" Margin="0,0,0,4"/>
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="30"/>
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding OverlayBackgroundColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                     Background="#2D2D44" Foreground="White" FontSize="13" Padding="8,6"
                     BorderBrush="#444" BorderThickness="1"/>
            <Border Grid.Column="1" 
                    Background="{Binding OverlayBackgroundColor, Converter={StaticResource StringToBrush}}"
                    CornerRadius="4" Margin="4,0,0,0"
                    BorderBrush="#444" BorderThickness="1"
                    Cursor="Hand"
                    MouseLeftButtonDown="OverlayBgColorPicker_Click"/>
        </Grid>

        <TextBlock Text="Background Image" Foreground="#AAA" FontSize="12" Margin="0,0,0,4"/>
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Background="#2D2D44" BorderBrush="#444" BorderThickness="1" CornerRadius="4" Padding="8,6">
                <TextBlock Text="{Binding OverlayBackgroundImagePath}" 
                           Foreground="#888" FontSize="12"
                           TextTrimming="CharacterEllipsis"/>
            </Border>
            <Button Grid.Column="1" Content="📂 Browse" 
                    Click="BgImageBrowse_Click"
                    Background="#2D2D44" Foreground="White"
                    FontSize="12" Padding="10,5" Margin="4,0,0,0"
                    BorderThickness="0" Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#3D3D54"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
            <Button Grid.Column="2" Content="✕" 
                    Click="BgImageClear_Click"
                    Background="#2D2D44" Foreground="#888"
                    FontSize="12" Padding="8,5" Margin="4,0,0,0"
                    BorderThickness="0" Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#3D3D54"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <TextBlock Text="Button Size" Foreground="#AAA" FontSize="12" Margin="0,0,0,4"/>
        <DockPanel Margin="0,0,0,14">
            <TextBlock DockPanel.Dock="Right" 
                       Text="{Binding ButtonSize, StringFormat={}{0:0}}" 
                       Foreground="#888" FontSize="12" Width="30" TextAlignment="Right" VerticalAlignment="Center"/>
            <Slider Value="{Binding ButtonSize, Mode=TwoWay}" 
                    Minimum="60" Maximum="200" 
                    TickFrequency="5" IsSnapToTickEnabled="True"/>
        </DockPanel>

        <TextBlock Text="Button Spacing" Foreground="#AAA" FontSize="12" Margin="0,0,0,4"/>
        <DockPanel Margin="0,0,0,14">
            <TextBlock DockPanel.Dock="Right" 
                       Text="{Binding ButtonSpacing, StringFormat={}{0:0}}" 
                       Foreground="#888" FontSize="12" Width="30" TextAlignment="Right" VerticalAlignment="Center"/>
            <Slider Value="{Binding ButtonSpacing, Mode=TwoWay}" 
                    Minimum="2" Maximum="30" 
                    TickFrequency="1" IsSnapToTickEnabled="True"/>
        </DockPanel>

        <TextBlock Text="Button Overlay Opacity" Foreground="#AAA" FontSize="12" Margin="0,0,0,4"/>
        <DockPanel Margin="0,0,0,14">
            <TextBlock DockPanel.Dock="Right"
                   Text="{Binding ButtonOverlayOpacity, StringFormat={}{0:0.00}}"
                   Foreground="#888" FontSize="12" Width="40" TextAlignment="Right" VerticalAlignment="Center"/>
            <Slider Value="{Binding ButtonOverlayOpacity, Mode=TwoWay}"
                Minimum="0.2" Maximum="1"
                TickFrequency="0.05"
                IsSnapToTickEnabled="False"/>
        </DockPanel>

        <Expander Header="Grid Layout (Current Page)"
              IsExpanded="False"
              Margin="0,0,0,14"
              Background="#2D2D44"
              Foreground="White"
              BorderBrush="#444"
              BorderThickness="1"
              Padding="8,6">
            <StackPanel Margin="0,8,0,0">
            <TextBlock Text="{Binding LayoutSummary}" Foreground="#DDD" FontSize="12" FontWeight="SemiBold"/>
            <TextBlock Text="Affects only the currently selected page"
                   Foreground="#888" FontSize="11" Margin="0,2,0,8"/>

            <DockPanel Margin="0,0,0,4">
                <TextBlock Text="Rows" Foreground="#AAA" FontSize="12" VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="-" Command="{Binding DecreaseRowsCommand}"
                    Width="22" Height="22"
                    Background="#1E1E2E" Foreground="#DDD"
                    BorderBrush="#444" BorderThickness="1"
                    Cursor="Hand"/>
                <Border Background="#1E1E2E" BorderBrush="#444" BorderThickness="1"
                    CornerRadius="3" Margin="4,0" MinWidth="34" Height="22">
                    <TextBlock Text="{Binding Rows}" Foreground="#DDD" FontSize="12"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>
                <Button Content="+" Command="{Binding IncreaseRowsCommand}"
                    Width="22" Height="22"
                    Background="#1E1E2E" Foreground="#DDD"
                    BorderBrush="#444" BorderThickness="1"
                    Cursor="Hand"/>
                </StackPanel>
            </DockPanel>
            <Slider Value="{Binding Rows, Mode=TwoWay}"
                Minimum="{Binding MinRows}"
                Maximum="{Binding MaxRows}"
                TickFrequency="1"
                IsSnapToTickEnabled="True"
                Margin="0,0,0,8"/>

            <DockPanel Margin="0,0,0,4">
                <TextBlock Text="Columns" Foreground="#AAA" FontSize="12" VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="-" Command="{Binding DecreaseColumnsCommand}"
                    Width="22" Height="22"
                    Background="#1E1E2E" Foreground="#DDD"
                    BorderBrush="#444" BorderThickness="1"
                    Cursor="Hand"/>
                <Border Background="#1E1E2E" BorderBrush="#444" BorderThickness="1"
                    CornerRadius="3" Margin="4,0" MinWidth="34" Height="22">
                    <TextBlock Text="{Binding Columns}" Foreground="#DDD" FontSize="12"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>
                <Button Content="+" Command="{Binding IncreaseColumnsCommand}"
                    Width="22" Height="22"
                    Background="#1E1E2E" Foreground="#DDD"
                    BorderBrush="#444" BorderThickness="1"
                    Cursor="Hand"/>
                </StackPanel>
            </DockPanel>
            <Slider Value="{Binding Columns, Mode=TwoWay}"
                Minimum="{Binding MinColumns}"
                Maximum="{Binding MaxColumns}"
                TickFrequency="1"
                IsSnapToTickEnabled="True"/>
            </StackPanel>
        </Expander>

        <!-- Separator -->
        <Border Height="1" Background="#333" Margin="0,0,0,16"/>

        <!-- Hotkey Section -->
        <TextBlock Text="HOTKEY" Foreground="#666" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>

        <TextBlock Text="Toggle Overlay" Foreground="#AAA" FontSize="12" Margin="0,0,0,4"/>
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Background="#2D2D44" BorderBrush="#444" BorderThickness="1" CornerRadius="4" Padding="8,6">
                <TextBlock Text="{Binding HotkeyDisplayText}" 
                           Foreground="#6C5CE7" 
                           FontSize="13" 
                           FontWeight="Bold"/>
            </Border>
            <Button x:Name="RecordHotkeyButton" 
                    Grid.Column="1" 
                    Content="⌨ Record" 
                    Click="RecordHotkey_Click"
                    Background="#2D2D44" Foreground="White"
                    FontSize="12" Padding="10,5" Margin="4,0,0,0"
                    BorderThickness="0" Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#3D3D54"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <!-- Separator -->
        <Border Height="1" Background="#333" Margin="0,0,0,16"/>

        <!-- Startup Section -->
        <TextBlock Text="STARTUP" Foreground="#666" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>
        <CheckBox IsChecked="{Binding StartWithWindows, Mode=TwoWay}" 
                  Content="Start with Windows" 
                  Foreground="#CCC" FontSize="13" Margin="0,0,0,10" Cursor="Hand"/>
    </StackPanel>
    </ScrollViewer>
    </DockPanel>
</Window>
