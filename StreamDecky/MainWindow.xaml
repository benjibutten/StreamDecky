<Window x:Class="StreamDecky.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:StreamDecky.Helpers"
        xmlns:models="clr-namespace:StreamDecky.Models"
    x:Name="MainRootWindow"
        Title="StreamDecky" 
        Height="700" Width="1050"
        MinHeight="500" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E"
        WindowStyle="None"
    AllowsTransparency="False"
    PreviewKeyDown="MainWindow_PreviewKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" 
                      ResizeBorderThickness="6" 
                      GlassFrameThickness="0" 
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <helpers:StringToBrushConverter x:Key="StringToBrush"/>
        <helpers:DoubleToCornerRadiusConverter x:Key="DoubleToCornerRadius"/>
        <helpers:SpacingToThicknessConverter x:Key="SpacingToThickness"/>
        <helpers:HasTextToVisibilityConverter x:Key="HasTextVisibility"/>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <helpers:PathToImageSourceConverter x:Key="PathToImageSource"/>
        <helpers:ButtonShapeToGeometryConverter x:Key="ShapeToGeometry"/>
        <helpers:AdaptiveButtonSizeConverter x:Key="AdaptiveButtonSize"/>
        
        <!-- TextMode enum values for ComboBox -->
        <ObjectDataProvider x:Key="TextModeValues" 
                            MethodName="GetValues" 
                            ObjectType="{x:Type models:TextMode}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:TextMode"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        
        <!-- ActionType enum values for ComboBox -->
        <ObjectDataProvider x:Key="ActionTypeValues" 
                            MethodName="GetValues" 
                            ObjectType="{x:Type models:ActionType}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:ActionType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <!-- ActionStepType enum values for ComboBox -->
        <ObjectDataProvider x:Key="ActionStepTypeValues" 
                            MethodName="GetValues" 
                            ObjectType="{x:Type models:ActionStepType}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:ActionStepType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <!-- ButtonShape enum values for ComboBox -->
        <ObjectDataProvider x:Key="ButtonShapeValues" 
                            MethodName="GetValues" 
                            ObjectType="{x:Type models:ButtonShape}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:ButtonShape"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <!-- FormFieldType enum values for ComboBox -->
        <ObjectDataProvider x:Key="FormFieldTypeValues"
                            MethodName="GetValues"
                            ObjectType="{x:Type models:FormFieldType}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:FormFieldType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <!-- Flat rounded button used across the Forms editor -->
        <Style x:Key="FormsFlatButton" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Thin ScrollBar Thumb -->
        <Style x:Key="ThinScrollBarThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#55FFFFFF" CornerRadius="3" Margin="1"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Thin vertical ScrollBar -->
        <Style x:Key="ThinScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ThinScrollBarThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="6"/>
                    <Setter Property="MinHeight" Value="6"/>
                    <Setter Property="Width" Value="Auto"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Dark ScrollViewer with thin scrollbar -->
        <Style x:Key="DarkScrollViewer" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <ScrollContentPresenter/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       HorizontalAlignment="Right"
                                       Style="{StaticResource ThinScrollBar}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                       Margin="0,0,-14,0"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditorPanelGridSplitterStyle" TargetType="GridSplitter">
            <Setter Property="Width" Value="8"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,16,0,16"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBox Toggle Button -->
        <ControlTemplate x:Key="DarkComboBoxToggle" TargetType="ToggleButton">
            <Border x:Name="Border"
                    Background="#1E1E2E"
                    BorderBrush="#444"
                    BorderThickness="1"
                    CornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="24"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="1">
                        <Path Data="M0,0 L4,4 L8,0" 
                              Stroke="#AAA" StrokeThickness="1.5"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#666"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Dark ComboBox Item -->
        <Style x:Key="DarkComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" 
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="3">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3D3D5C"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4D4D6C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBox Style -->
        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Template="{StaticResource DarkComboBoxToggle}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Focusable="False"/>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="10,7,28,7"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Background="#2D2D44"
                                            BorderBrush="#555"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="4"/>
                                    <ScrollViewer Margin="4,6" SnapsToDevicePixels="True"
                                                  Style="{StaticResource DarkScrollViewer}">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Border Grid.Row="0" Background="#16162A" MouseLeftButtonDown="TitleBar_MouseDown">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Path Data="M1,0 H3 A1,1,0,0,1,4,1 V3 A1,1,0,0,1,3,4 H1 A1,1,0,0,1,0,3 V1 A1,1,0,0,1,1,0 Z M6,0 H8 A1,1,0,0,1,9,1 V3 A1,1,0,0,1,8,4 H6 A1,1,0,0,1,5,3 V1 A1,1,0,0,1,6,0 Z M1,5 H3 A1,1,0,0,1,4,6 V8 A1,1,0,0,1,3,9 H1 A1,1,0,0,1,0,8 V6 A1,1,0,0,1,1,5 Z M6,5 H8 A1,1,0,0,1,9,6 V8 A1,1,0,0,1,8,9 H6 A1,1,0,0,1,5,8 V6 A1,1,0,0,1,6,5 Z"
                          Fill="#6C5CE7" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                    <TextBlock Text="StreamDecky" Foreground="#CCCCCC" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="VersionText" Foreground="#55557A" FontSize="11" VerticalAlignment="Center" Margin="8,1,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinimizeBtn" Content="─" Click="MinimizeButton_Click"
                            Width="46" Height="36" FontSize="13"
                            Foreground="#999" Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#2A2A44"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="MaximizeBtn" Content="☐" Click="MaximizeButton_Click"
                            Width="46" Height="36" FontSize="13"
                            Foreground="#999" Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#2A2A44"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="CloseBtn" Content="✕" Click="TitleBarClose_Click"
                            Width="46" Height="36" FontSize="13"
                            Foreground="#999" Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#C42B1C"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main content area -->
        <Grid x:Name="MainContentGrid" Grid.Row="1" ClipToBounds="True" SizeChanged="MainContentGrid_SizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="DeckColumn" Width="*" MinWidth="660"/>
            <ColumnDefinition x:Name="EditorSplitterColumn" Width="Auto"/>
            <ColumnDefinition x:Name="EditorColumn" Width="320" MinWidth="300"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: Deck Grid Preview -->
        <Grid Grid.Column="0" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="Deck" 
                           FontSize="20" 
                           FontWeight="Bold" 
                           Foreground="White"
                           VerticalAlignment="Center"/>
                <Button Content="▶ Open Overlay" 
                        DockPanel.Dock="Right"
                        HorizontalAlignment="Right"
                        Click="OpenOverlay_Click"
                        Background="#6C5CE7"
                        Foreground="White"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Padding="18,8"
                        Cursor="Hand"
                        BorderThickness="0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="6" 
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#7C6CF7"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="⚙ Settings" 
                        DockPanel.Dock="Right"
                        HorizontalAlignment="Right"
                        Click="OpenSettings_Click"
                        Background="#2D2D44"
                        Foreground="#AAAAAA"
                        FontSize="14"
                        Padding="14,8"
                        Cursor="Hand"
                        BorderThickness="0"
                        Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="6" 
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#3D3D54"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button x:Name="NotesAreasButton"
                        Content="🗂 Notes Areas"
                        DockPanel.Dock="Right"
                        HorizontalAlignment="Right"
                        Click="ToggleNotesAreasPopup_Click"
                        Background="#2D2D44"
                        Foreground="#AAAAAA"
                        FontSize="14"
                        Padding="14,8"
                        Cursor="Hand"
                        BorderThickness="0"
                        Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#3D3D54"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Popup x:Name="NotesAreasPopup"
                       DockPanel.Dock="Right"
                       PlacementTarget="{Binding ElementName=NotesAreasButton}"
                       Placement="Bottom"
                       VerticalOffset="8"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Fade">
                    <Border DataContext="{Binding DataContext, ElementName=MainRootWindow}"
                            Background="#2A2A42"
                            BorderBrush="#4C4C70"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12"
                            Width="360">
                        <StackPanel>
                            <TextBlock Text="Notes Areas"
                                       Foreground="White"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10"/>

                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="+ Add" Click="AddNotePage_Click"
                                            Background="#2D5A27" Foreground="White"
                                            FontSize="11" Padding="9,4" Margin="4,0,0,0"
                                            BorderThickness="0" Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <Button Content="− Remove" Click="RemoveNotePage_Click"
                                            IsEnabled="{Binding CanRemoveNotePage}"
                                            Background="#5A2727" Foreground="White"
                                            FontSize="11" Padding="9,4" Margin="4,0,0,0"
                                            BorderThickness="0" Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}"
                                                                    Opacity="{Binding IsEnabled, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static helpers:OpacityConverter.Instance}}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="◀"
                                            Command="{Binding PreviousNotePageCommand}"
                                            IsEnabled="{Binding CanGoToPreviousNotePage}"
                                            Background="#2D2D44" Foreground="White"
                                            FontSize="12" Padding="8,2"
                                            BorderThickness="0" Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}"
                                                                    Opacity="{Binding IsEnabled, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static helpers:OpacityConverter.Instance}}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <TextBlock Text="{Binding NotePageIndicator}"
                                               Foreground="#B9C7D6"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Margin="8,0"/>

                                    <Button Content="▶"
                                            Command="{Binding NextNotePageCommand}"
                                            IsEnabled="{Binding CanGoToNextNotePage}"
                                            Background="#2D2D44" Foreground="White"
                                            FontSize="12" Padding="8,2"
                                            BorderThickness="0" Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}"
                                                                    Opacity="{Binding IsEnabled, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static helpers:OpacityConverter.Instance}}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </DockPanel>

                            <TextBlock Text="Text Size (all notes)"
                                       Foreground="#AAB8CC"
                                       FontSize="11"
                                       Margin="0,10,0,2"/>
                            <DockPanel Margin="0,0,0,2">
                                <TextBlock DockPanel.Dock="Right"
                                           Text="{Binding StickyNoteFontSize, StringFormat={}{0:0}}"
                                           Foreground="#B9C7D6"
                                           FontSize="11"
                                           Width="28"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center"/>
                                <Slider Value="{Binding StickyNoteFontSize, Mode=TwoWay}"
                                        Minimum="10"
                                        Maximum="30"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"/>
                            </DockPanel>

                            <TextBlock Text="The overlay can browse note areas directly, but add/remove lives here to avoid popup issues while the overlay is active."
                                       Foreground="#8D9BAF"
                                       FontSize="10"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </Popup>
            </DockPanel>

            <!-- Page Navigation -->
            <Border Grid.Row="1" Background="#252536" CornerRadius="8" Padding="8,6" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="+ Profile" Click="AddProfile_Click"
                                    Background="#2D5A27" Foreground="White"
                                    FontSize="12" Padding="10,4" Margin="4,0,0,0"
                                    BorderThickness="0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Duplicate" Click="DuplicateProfile_Click"
                                    Background="#2A4D7A" Foreground="White"
                                    FontSize="12" Padding="10,4" Margin="4,0,0,0"
                                    BorderThickness="0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Rename" Click="RenameProfile_Click"
                                    Background="#3F4F86" Foreground="White"
                                    FontSize="12" Padding="10,4" Margin="4,0,0,0"
                                    BorderThickness="0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="− Profile" Click="RemoveProfile_Click"
                                    IsEnabled="{Binding CanRemoveProfile}"
                                    Background="#5A2727" Foreground="White"
                                    FontSize="12" Padding="10,4" Margin="4,0,0,0"
                                    BorderThickness="0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}"
                                                            Opacity="{Binding IsEnabled, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static helpers:OpacityConverter.Instance}}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Profile"
                                       Foreground="#8C93AA"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="2,0,8,0"/>

                            <ComboBox MinWidth="180"
                                      Margin="0,0,8,0"
                                      ItemsSource="{Binding ProfileOptions}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding SelectedProfileId, Mode=TwoWay}"
                                      Style="{StaticResource DarkComboBox}"/>

                            <TextBlock Text="{Binding ProfileIndicator}"
                                       Foreground="#AFC0D4"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>

                            <Border Background="#20263A"
                                    BorderBrush="#313B57"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="6"
                                    VerticalAlignment="Center"
                                    ToolTip="{Binding SaveStatusDetails}">
                                <Grid Width="14" Height="14">
                                    <Ellipse Width="14"
                                             Height="14"
                                             Fill="Transparent"
                                             Stroke="{Binding SaveStatusColor, Converter={StaticResource StringToBrush}}"
                                             StrokeThickness="1.5"/>
                                    <Ellipse Width="6"
                                             Height="6"
                                             Fill="{Binding SaveStatusColor, Converter={StaticResource StringToBrush}}"
                                             VerticalAlignment="Center"
                                             HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </DockPanel>

                    <DockPanel Grid.Row="1">
                        <!-- Right side: Add/Remove page + virtual layout -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="+ Page" Click="AddPage_Click"
                                Background="#2D5A27" Foreground="White"
                                FontSize="12" Padding="10,4" Margin="4,0,0,0"
                                BorderThickness="0" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="− Page" Click="RemovePage_Click"
                                Background="#5A2727" Foreground="White"
                                FontSize="12" Padding="10,4" Margin="4,0,0,0"
                                BorderThickness="0" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="+ Virtual" Click="AddVirtualLayout_Click"
                                Background="#285A74" Foreground="White"
                                FontSize="12" Padding="10,4" Margin="4,0,0,0"
                                BorderThickness="0" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="− Virtual" Click="RemoveVirtualLayout_Click"
                                Background="#744628" Foreground="White"
                                FontSize="12" Padding="10,4" Margin="4,0,0,0"
                                BorderThickness="0" Cursor="Hand"
                                Visibility="{Binding IsViewingVirtualLayout, Converter={StaticResource BoolToVisibility}}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Rename" Click="RenameLayout_Click"
                                Background="#3F4F86" Foreground="White"
                                FontSize="12" Padding="10,4" Margin="4,0,0,0"
                                BorderThickness="0" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                        </StackPanel>

                        <!-- Left side: Navigation -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="◀" Click="PreviousPage_Click"
                                IsEnabled="{Binding CanGoToPreviousPage}"
                                Background="#2D2D44" Foreground="White"
                                FontSize="14" Padding="10,2"
                                BorderThickness="0" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}"
                                                        Opacity="{Binding IsEnabled, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static helpers:OpacityConverter.Instance}}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                        <TextBlock Text="{Binding CurrentPageName}" 
                                   Foreground="White" FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="12,0"/>
                        <TextBlock Text="{Binding PageIndicator}" 
                                   Foreground="#666" FontSize="12"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Border Background="#303048" CornerRadius="4" Padding="7,2" Margin="0,0,10,0">
                            <TextBlock Text="{Binding CurrentLayoutKindLabel}"
                                       Foreground="#D4D4E4"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <Button Content="▶" Click="NextPage_Click"
                                IsEnabled="{Binding CanGoToNextPage}"
                                Background="#2D2D44" Foreground="White"
                                FontSize="14" Padding="10,2"
                                BorderThickness="0" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}"
                                                        Opacity="{Binding IsEnabled, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static helpers:OpacityConverter.Instance}}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                        </StackPanel>
                    </DockPanel>

                    <Grid Grid.Row="2" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Go To Layout"
                                   Foreground="#8C93AA"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="2,0,8,0"/>

                        <ComboBox Grid.Column="1"
                                  MinWidth="140"
                                  Margin="0,0,8,0"
                                  HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding LayoutTargets}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding SelectedLayoutId, Mode=TwoWay}"
                                  Style="{StaticResource DarkComboBox}"/>

                        <Button Content="↩ Main" Click="ExitVirtualLayout_Click"
                                Grid.Column="2"
                                Background="#3E3E5E" Foreground="White"
                                FontSize="12" Padding="10,4"
                                BorderThickness="0" Cursor="Hand"
                                Visibility="{Binding IsViewingVirtualLayout, Converter={StaticResource BoolToVisibility}}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- Button Grid -->
            <Border Grid.Row="2"
                    CornerRadius="12"
                    ClipToBounds="True">
                <Grid>
                    <Border Background="{Binding OverlayBackgroundColor, Converter={StaticResource StringToBrush}}"
                            CornerRadius="12"/>
                    <Rectangle Opacity="0.9"
                               Visibility="{Binding OverlayBackgroundImagePath, Converter={StaticResource HasTextVisibility}}">
                        <Rectangle.Fill>
                            <ImageBrush ImageSource="{Binding OverlayBackgroundImagePath, Converter={StaticResource PathToImageSource}}"
                                        Stretch="UniformToFill"/>
                        </Rectangle.Fill>
                    </Rectangle>

                    <Border Padding="16" Background="#11000000">
                        <Grid x:Name="EditorDeckItemsHost">
                <ItemsControl ItemsSource="{Binding Buttons}"
                              HorizontalAlignment="Stretch" 
                              VerticalAlignment="Stretch">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding Columns}" Rows="{Binding Rows}"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="{Binding DataContext.ButtonSpacing, 
                                        RelativeSource={RelativeSource AncestorType=Window}, 
                                        Converter={StaticResource SpacingToThickness}}"
                                    Command="{Binding DataContext.SelectButtonAndShowEditorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    MouseDoubleClick="DeckEditorButton_MouseDoubleClick"
                                    PreviewMouseLeftButtonDown="DeckEditorButton_PreviewMouseLeftButtonDown"
                                    PreviewMouseMove="DeckEditorButton_PreviewMouseMove"
                                    AllowDrop="True"
                                    DragOver="DeckEditorButton_DragOver"
                                    Drop="DeckEditorButton_Drop"
                                    PreviewMouseRightButtonDown="DeckEditorButton_PreviewMouseRightButtonDown"
                                    Cursor="Hand">
                                <Button.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="Copy button (Ctrl+C)" Click="CopyButtonFromContext_Click"/>
                                        <MenuItem Header="Paste button (Ctrl+V)" Click="PasteButtonFromContext_Click"/>
                                        <Separator/>
                                        <MenuItem Header="Remove button (Del)" Click="RemoveButtonFromContext_Click"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <Button.Width>
                                    <MultiBinding Converter="{StaticResource AdaptiveButtonSize}" ConverterParameter="0,0,24">
                                        <Binding Path="DataContext.ButtonSize" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                        <Binding Path="DataContext.ButtonSpacing" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                        <Binding Path="DataContext.Columns" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                        <Binding Path="DataContext.Rows" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                        <Binding ElementName="EditorDeckItemsHost" Path="ActualWidth"/>
                                        <Binding ElementName="EditorDeckItemsHost" Path="ActualHeight"/>
                                    </MultiBinding>
                                </Button.Width>
                                <Button.Height>
                                    <MultiBinding Converter="{StaticResource AdaptiveButtonSize}" ConverterParameter="0,0,24">
                                        <Binding Path="DataContext.ButtonSize" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                        <Binding Path="DataContext.ButtonSpacing" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                        <Binding Path="DataContext.Columns" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                        <Binding Path="DataContext.Rows" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                        <Binding ElementName="EditorDeckItemsHost" Path="ActualWidth"/>
                                        <Binding ElementName="EditorDeckItemsHost" Path="ActualHeight"/>
                                    </MultiBinding>
                                </Button.Height>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid>
                                                        <!-- Regular background (non-shaped) -->
                                                        <Border x:Name="RegularBg"
                                                                CornerRadius="{Binding CornerRadius, Converter={StaticResource DoubleToCornerRadius}}"
                                                                BorderThickness="2"
                                                                BorderBrush="Transparent"
                                                                Background="{Binding BackgroundColor, Converter={StaticResource StringToBrush}}">
                                                            <Grid>
                                                                <Grid.OpacityMask>
                                                                    <VisualBrush>
                                                                        <VisualBrush.Visual>
                                                                            <Border Background="Black" 
                                                                                    CornerRadius="{Binding CornerRadius, Converter={StaticResource DoubleToCornerRadius}}"
                                                                                    Width="{Binding ActualWidth, ElementName=RegularBg}"
                                                                                    Height="{Binding ActualHeight, ElementName=RegularBg}"/>
                                                                        </VisualBrush.Visual>
                                                                    </VisualBrush>
                                                                </Grid.OpacityMask>
                                                                 <Image Source="{Binding ImagePath, Converter={StaticResource PathToImageSource}, ConverterParameter=256}"
                                                                       Stretch="UniformToFill"
                                                                       Visibility="{Binding ImagePath, Converter={StaticResource HasTextVisibility}}"/>
                                                                 <StackPanel x:Name="ConfiguredContent" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                    <TextBlock Text="{Binding IconText}" 
                                                                               FontSize="22"
                                                                               HorizontalAlignment="Center"
                                                                               Foreground="{Binding TextColor, Converter={StaticResource StringToBrush}}"
                                                                               Visibility="{Binding IconText, Converter={StaticResource HasTextVisibility}}"/>
                                                                    <TextBlock Text="{Binding DisplayTitle}" 
                                                                               FontSize="11"
                                                                               TextWrapping="Wrap"
                                                                               TextAlignment="Center"
                                                                               HorizontalAlignment="Center"
                                                                               Foreground="{Binding TextColor, Converter={StaticResource StringToBrush}}"
                                                                               Margin="4,2,4,0"/>
                                                                </StackPanel>
                                                                <StackPanel x:Name="EmptyContent"
                                                                            VerticalAlignment="Center"
                                                                            HorizontalAlignment="Center"
                                                                            Visibility="Collapsed">
                                                                    <TextBlock Text="+"
                                                                               FontSize="24"
                                                                               FontWeight="Bold"
                                                                               Foreground="#90D0F0"
                                                                               HorizontalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding SlotLabel}"
                                                                               FontSize="11"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="#D7EDF8"
                                                                               HorizontalAlignment="Center"
                                                                               Margin="0,2,0,0"/>
                                                                    <TextBlock Text="Click to configure"
                                                                               FontSize="9"
                                                                               Foreground="#9EB5C4"
                                                                               HorizontalAlignment="Center"
                                                                               Margin="0,2,0,0"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                        <!-- Shape background (shaped buttons) -->
                                                        <Grid x:Name="ShapeGrid" Visibility="Collapsed">
                                                            <Path x:Name="ShapeBg"
                                                                  Data="{Binding Shape, Converter={StaticResource ShapeToGeometry}}"
                                                                  Fill="{Binding BackgroundColor, Converter={StaticResource StringToBrush}}"
                                                                  Stretch="Fill"
                                                                  StrokeThickness="2"
                                                                  Stroke="Transparent"/>
                                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="15">
                                                                <TextBlock Text="{Binding IconText}" 
                                                                           FontSize="22"
                                                                           HorizontalAlignment="Center"
                                                                           Foreground="{Binding TextColor, Converter={StaticResource StringToBrush}}"
                                                                           Visibility="{Binding IconText, Converter={StaticResource HasTextVisibility}}"/>
                                                                <TextBlock Text="{Binding DisplayTitle}" 
                                                                           FontSize="11"
                                                                           TextWrapping="Wrap"
                                                                           TextAlignment="Center"
                                                                           HorizontalAlignment="Center"
                                                                           Foreground="{Binding TextColor, Converter={StaticResource StringToBrush}}"
                                                                           Margin="4,2,4,0"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding HasShape}" Value="True">
                                                            <Setter TargetName="RegularBg" Property="Visibility" Value="Collapsed"/>
                                                            <Setter TargetName="ShapeGrid" Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsConfigured}" Value="False">
                                                            <Setter TargetName="RegularBg" Property="Background" Value="#273445"/>
                                                            <Setter TargetName="RegularBg" Property="BorderBrush" Value="#4A6880"/>
                                                            <Setter TargetName="ConfiguredContent" Property="Visibility" Value="Collapsed"/>
                                                            <Setter TargetName="EmptyContent" Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="RegularBg" Property="BorderBrush" Value="#88FFFFFF"/>
                                                            <Setter TargetName="ShapeBg" Property="Stroke" Value="#88FFFFFF"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="RegularBg" Property="Opacity" Value="0.8"/>
                                                            <Setter TargetName="ShapeBg" Property="Opacity" Value="0.8"/>
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter TargetName="RegularBg" Property="BorderBrush" Value="#6C5CE7"/>
                                                            <Setter TargetName="ShapeBg" Property="Stroke" Value="#6C5CE7"/>
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <GridSplitter x:Name="EditorPanelSplitter"
                  Grid.Column="1"
                      Style="{StaticResource EditorPanelGridSplitterStyle}"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"
                      ShowsPreview="False"
                  DragCompleted="EditorPanelSplitter_DragCompleted"
                      Cursor="SizeWE"/>

        <!-- RIGHT: Editor Panel -->
        <Border Grid.Column="2" Background="#252536" CornerRadius="12,0,0,12" Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource DarkScrollViewer}">
                <StackPanel>
                    <TextBlock Text="Editor" 
                               FontSize="18" 
                               FontWeight="Bold" 
                               Foreground="White"
                               Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="Button"
                                Command="{Binding ShowButtonEditorCommand}"
                                Background="#3A4A6A"
                                Foreground="White"
                                Padding="10,6"
                                BorderThickness="0"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Opacity" Value="0.7"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="6,0,0,6"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsButtonEditorMode}" Value="True">
                                                        <Setter Property="Opacity" Value="1"/>
                                                        <Setter TargetName="Bd" Property="Background" Value="#4A6EA0"/>
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Grid.Column="1"
                                Content="Clipboard"
                                Command="{Binding ShowClipboardEditorCommand}"
                                Background="#3A4A6A"
                                Foreground="White"
                                Padding="10,6"
                                BorderThickness="0"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Opacity" Value="0.7"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="0"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsClipboardEditorMode}" Value="True">
                                                        <Setter Property="Opacity" Value="1"/>
                                                        <Setter TargetName="Bd" Property="Background" Value="#4A6EA0"/>
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Grid.Column="2"
                                Content="Forms"
                                Command="{Binding ShowFormsEditorCommand}"
                                Background="#3A4A6A"
                                Foreground="White"
                                Padding="10,6"
                                BorderThickness="0"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Opacity" Value="0.7"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="0,6,6,0"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsFormsEditorMode}" Value="True">
                                                        <Setter Property="Opacity" Value="1"/>
                                                        <Setter TargetName="Bd" Property="Background" Value="#4A6EA0"/>
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <StackPanel Visibility="{Binding IsButtonEditorMode, Converter={StaticResource BoolToVisibility}}">

                    <!-- No selection state -->
                    <TextBlock Text="Select a button to edit" 
                               Foreground="#666"
                               FontSize="14"
                               Visibility="{Binding IsButtonSelected, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"/>

                    <!-- Editor content when button is selected -->
                    <StackPanel Visibility="{Binding IsButtonSelected, Converter={StaticResource BoolToVisibility}}">
                        
                        <!-- Action Type -->
                        <TextBlock Text="Action Type" Foreground="#AAA" FontSize="12" Margin="0,0,0,4"/>
                        <ComboBox SelectedItem="{Binding SelectedButton.ActionType, Mode=TwoWay}"
                                  ItemsSource="{Binding Source={StaticResource ActionTypeValues}}"
                                  Style="{StaticResource DarkComboBox}"
                                  Margin="0,0,0,12"/>

                        <!-- Quick action buttons -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Button Content="Set Text Input" Click="SetTextInput_Click"
                                    Background="#2D5A27" Foreground="White"
                                    FontSize="12" Padding="10,5" Margin="0,0,8,0"
                                    BorderThickness="0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Duplicate" Click="DuplicateButton_Click"
                                    Background="#2A4D7A" Foreground="White"
                                    FontSize="12" Padding="10,5" Margin="0,0,8,0"
                                    BorderThickness="0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Clear" Click="ClearButton_Click"
                                    Background="#5A2727" Foreground="White"
                                    FontSize="12" Padding="10,5"
                                    BorderThickness="0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
