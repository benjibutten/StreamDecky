                                 FontSize="13" Padding="8,6"
                                 BorderBrush="#444" BorderThickness="1"
                                 Margin="0,0,0,10"/>

                        <TextBlock Text="Icon / Emoji" Foreground="#AAA" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding SelectedButton.IconText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                 Background="#1E1E2E" Foreground="White" 
                                 FontSize="13" Padding="8,6"
                                 BorderBrush="#444" BorderThickness="1"
                                 Margin="0,0,0,10"/>

                        <TextBlock Text="Background Color" Foreground="#AAA" FontSize="12" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding SelectedButton.BackgroundColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="#1E1E2E" Foreground="White" 
                                     FontSize="13" Padding="8,6"
                                     BorderBrush="#444" BorderThickness="1"/>
                            <Border Grid.Column="1" 
                                    Background="{Binding SelectedButton.BackgroundColor, Converter={StaticResource StringToBrush}}"
                                    CornerRadius="4" Margin="4,0,0,0"
                                    BorderBrush="#444" BorderThickness="1"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="BtnBgColorPicker_Click"/>
                        </Grid>

                        <TextBlock Text="Text Color" Foreground="#AAA" FontSize="12" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding SelectedButton.TextColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="#1E1E2E" Foreground="White" 
                                     FontSize="13" Padding="8,6"
                                     BorderBrush="#444" BorderThickness="1"/>
                            <Border Grid.Column="1" 
                                    Background="{Binding SelectedButton.TextColor, Converter={StaticResource StringToBrush}}"
                                    CornerRadius="4" Margin="4,0,0,0"
                                    BorderBrush="#444" BorderThickness="1"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="BtnTextColorPicker_Click"/>
                        </Grid>

                        <TextBlock Text="Corner Radius" Foreground="#AAA" FontSize="12" Margin="0,0,0,4"/>
                        <Slider Value="{Binding SelectedButton.CornerRadius, Mode=TwoWay}" 
                                Minimum="0" Maximum="50" 
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                Margin="0,0,0,10"/>

                        <TextBlock Text="Button Shape" Foreground="#AAA" FontSize="12" Margin="0,0,0,4"/>
                        <ComboBox SelectedItem="{Binding SelectedButton.Shape, Mode=TwoWay}"
                                  ItemsSource="{Binding Source={StaticResource ButtonShapeValues}}"
                                  Style="{StaticResource DarkComboBox}"
                                  Margin="0,0,0,10"/>

                        <TextBlock Text="Image" Foreground="#AAA" FontSize="12" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding SelectedButton.ImagePath, Mode=TwoWay}" 
                                     Background="#1E1E2E" Foreground="#888" 
                                     FontSize="11" Padding="6,5"
                                     BorderBrush="#444" BorderThickness="1"
                                     IsReadOnly="True"
                                     VerticalContentAlignment="Center"/>
                            <Button Grid.Column="1" Content="📁" Click="BrowseImage_Click"
                                    Background="#2D2D44" Foreground="White"
                                    FontSize="13" Padding="8,5" Margin="4,0,0,0"
                                    BorderThickness="0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Grid.Column="2" Content="✕" Click="ClearImage_Click"
                                    Background="#5A2727" Foreground="White"
                                    FontSize="13" Padding="8,5" Margin="4,0,0,0"
                                    BorderThickness="0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                        <!-- Image preview -->
                        <Border Height="60" Margin="0,0,0,16"
                                Background="#1A1A2A" CornerRadius="4"
                                Visibility="{Binding SelectedButton.ImagePath, Converter={StaticResource HasTextVisibility}}">
                            <Image Source="{Binding SelectedButton.ImagePath, Converter={StaticResource PathToImageSource}, ConverterParameter=256}"
                                   Stretch="Uniform" Margin="4"/>
                        </Border>

                        <!-- Separator -->
                        <Border Height="1" Background="#333" Margin="0,0,0,16"/>

                        <!-- Text Input Settings (visible when ActionType is TextInput) -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedButton.ActionType}" Value="TextInput">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Text="TEXT INPUT ACTION" Foreground="#666" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>

                            <TextBlock Text="Text" Foreground="#AAA" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding SelectedButton.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="#1E1E2E" Foreground="White" 
                                     FontSize="13" Padding="8,6"
                                     BorderBrush="#444" BorderThickness="1"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="60"
                                     MaxHeight="120"
                                     VerticalScrollBarVisibility="Auto"
                                     Margin="0,0,0,10"/>

                            <CheckBox IsChecked="{Binding SelectedButton.PressEnterAfter, Mode=TwoWay}" 
                                      Content="Press Enter after message"
                                      Foreground="#CCC" FontSize="13"
                                      Margin="0,0,0,10"/>

                            <TextBlock Text="Text Mode" Foreground="#AAA" FontSize="12" Margin="0,0,0,4"/>
                            <ComboBox SelectedItem="{Binding SelectedButton.TextMode, Mode=TwoWay}"
                                      ItemsSource="{Binding Source={StaticResource TextModeValues}}"
                                      Style="{StaticResource DarkComboBox}"
                                      Margin="0,0,0,10"/>
                        </StackPanel>

                        <!-- Key Press Settings (visible when ActionType is KeyPress) -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedButton.ActionType}" Value="KeyPress">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Text="KEY PRESS ACTION" Foreground="#666" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>

                            <TextBlock Text="Key (SendKeys format)" Foreground="#AAA" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding SelectedButton.KeyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="#1E1E2E" Foreground="White" 
                                     FontSize="13" Padding="8,6"
                                     BorderBrush="#444" BorderThickness="1"
                                     Margin="0,0,0,6"/>
                            <TextBlock Text="Examples: t, {ENTER}, ^c (Ctrl+C), +{TAB} (Shift+Tab)" 
                                       Foreground="#555" FontSize="10" TextWrapping="Wrap"
                                       Margin="0,0,0,10"/>
                        </StackPanel>

                        <!-- Layout Navigation Settings (visible when ActionType is LayoutNavigation) -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedButton.ActionType}" Value="LayoutNavigation">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Text="LAYOUT NAVIGATION" Foreground="#666" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>

                            <TextBlock Text="Target Layout" Foreground="#AAA" FontSize="12" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding LayoutTargets}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding SelectedButton.TargetLayoutId, Mode=TwoWay}"
                                      Style="{StaticResource DarkComboBox}"
                                      Margin="0,0,0,6"/>

                            <TextBlock Text="Tip: choose a Virtual Layout for hidden menus, or a regular Page to jump there directly."
                                       Foreground="#777"
                                       FontSize="10"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,10"/>
                        </StackPanel>

                        <!-- Multi-Action Steps (visible when ActionType is MultiAction) -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedButton.ActionType}" Value="MultiAction">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Text="MULTI-ACTION STEPS" Foreground="#666" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>

                            <ItemsControl ItemsSource="{Binding SelectedButton.Steps}" Margin="0,0,0,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#2D2D44" CornerRadius="6" Padding="10" Margin="0,0,0,6">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,6">
                                                    <Button Content="✕" DockPanel.Dock="Right"
                                                            Command="{Binding DataContext.RemoveStepCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Background="#5A2727" Foreground="White"
                                                            FontSize="11" Padding="6,2" Margin="4,0,0,0"
                                                            BorderThickness="0" Cursor="Hand">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                            </Border>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <Button Content="▲" DockPanel.Dock="Right"
                                                            Command="{Binding DataContext.MoveStepUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Background="#2D2D44" Foreground="#AAA"
                                                            FontSize="10" Padding="6,2" Margin="2,0,0,0"
                                                            BorderThickness="0" Cursor="Hand">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                            </Border>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#3D3D54"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <Button Content="▼" DockPanel.Dock="Right"
                                                            Command="{Binding DataContext.MoveStepDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Background="#2D2D44" Foreground="#AAA"
                                                            FontSize="10" Padding="6,2" Margin="2,0,0,0"
                                                            BorderThickness="0" Cursor="Hand">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                            </Border>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#3D3D54"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <ComboBox SelectedItem="{Binding Type, Mode=TwoWay}"
                                                              ItemsSource="{Binding Source={StaticResource ActionStepTypeValues}}"
                                                              Style="{StaticResource DarkComboBox}"
                                                              Margin="0,0,8,0"/>
                                                </DockPanel>

                                                <!-- KeyPress fields -->
                                                <StackPanel x:Name="StepKeyPress" Margin="0,0,0,4">
                                                    <TextBlock Text="Key (SendKeys format)" Foreground="#888" FontSize="11" Margin="0,0,0,2"/>
                                                    <TextBox Text="{Binding KeyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Background="#1E1E2E" Foreground="White" FontSize="12" Padding="6,4"
                                                             BorderBrush="#444" BorderThickness="1"/>
                                                </StackPanel>

                                                <!-- TextInput fields -->
                                                <StackPanel x:Name="StepTextInput" Visibility="Collapsed" Margin="0,0,0,4">
                                                    <TextBlock Text="Text" Foreground="#888" FontSize="11" Margin="0,0,0,2"/>
                                                    <TextBox Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Background="#1E1E2E" Foreground="White" FontSize="12" Padding="6,4"
                                                             BorderBrush="#444" BorderThickness="1"
                                                             AcceptsReturn="True" TextWrapping="Wrap"
                                                             MinHeight="40" MaxHeight="80"/>
                                                    <ComboBox SelectedItem="{Binding TextMode, Mode=TwoWay}"
                                                              ItemsSource="{Binding Source={StaticResource TextModeValues}}"
                                                              Style="{StaticResource DarkComboBox}"
                                                              Margin="0,4,0,4"/>
                                                    <CheckBox IsChecked="{Binding PressEnterAfter, Mode=TwoWay}"
                                                              Content="Press Enter after"
                                                              Foreground="#CCC" FontSize="12"/>
                                                </StackPanel>

                                                <!-- Delay fields -->
                                                <StackPanel x:Name="StepDelay" Visibility="Collapsed" Margin="0,0,0,4">
                                                    <TextBlock Text="Duration (ms)" Foreground="#888" FontSize="11" Margin="0,0,0,2"/>
                                                    <TextBox Text="{Binding DelayMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Background="#1E1E2E" Foreground="White" FontSize="12" Padding="6,4"
                                                             BorderBrush="#444" BorderThickness="1" Width="80" HorizontalAlignment="Left"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Type}" Value="KeyPress">
                                                <Setter TargetName="StepKeyPress" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="StepTextInput" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="StepDelay" Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="TextInput">
                                                <Setter TargetName="StepKeyPress" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="StepTextInput" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="StepDelay" Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="Delay">
                                                <Setter TargetName="StepKeyPress" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="StepTextInput" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="StepDelay" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Content="+ Add Step" 
                                    Command="{Binding AddStepCommand}"
                                    Background="#2D5A27" Foreground="White"
                                    FontSize="12" Padding="10,5"
                                    BorderThickness="0" Cursor="Hand"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,10">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>

                    </StackPanel>

                    </StackPanel>

                    <StackPanel Visibility="{Binding IsClipboardEditorMode, Converter={StaticResource BoolToVisibility}}">
                        <!-- Clipboard Library header row: title + gear settings button + popup -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Clipboard Library"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>

                            <Button x:Name="ClipboardSettingsButton"
                                    Grid.Column="1"
                                    Content="⋯"
                                    Click="ToggleClipboardSettingsPopup_Click"
                                    Background="Transparent"
                                    Foreground="#888888"
                                    FontSize="20"
                                    Padding="4,0"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    ToolTip="Clipboard options">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="#CCCCCC"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Popup x:Name="ClipboardSettingsPopup"
                                   Grid.Column="1"
                                   PlacementTarget="{Binding ElementName=ClipboardSettingsButton}"
                                   Placement="Bottom"
                                   VerticalOffset="4"
                                   StaysOpen="False"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade">
                                <Border DataContext="{Binding DataContext, ElementName=MainRootWindow}"
                                        Background="#2A2A42"
                                        BorderBrush="#4C4C70"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14"
                                        Width="400">
                                    <StackPanel>
                                        <TextBlock Text="Clipboard Settings"
                                                   Foreground="White"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,12"/>

                                        <!-- Text size -->
                                        <TextBlock Text="Text size in overlay"
                                                   Foreground="#AAB8CC"
                                                   FontSize="11"
                                                   Margin="0,0,0,2"/>
                                        <DockPanel Margin="0,0,0,14">
                                            <TextBlock DockPanel.Dock="Right"
                                                       Text="{Binding QuickTextFontSize, StringFormat={}{0:0}}"
                                                       Foreground="#B9C7D6"
                                                       FontSize="11"
                                                       Width="28"
                                                       TextAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                            <Slider Value="{Binding QuickTextFontSize, Mode=TwoWay}"
                                                    Minimum="9"
                                                    Maximum="24"
                                                    TickFrequency="1"
                                                    IsSnapToTickEnabled="True"/>
                                        </DockPanel>

                                        <!-- Action steps header -->
                                        <TextBlock Text="ACTION STEPS (shared for all clipboard items)"
                                                   Foreground="#666"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Margin="0,0,0,4"/>
                                        <TextBlock Text="TextInput steps can use {{clipboardText}} anywhere in the text. Leave the field empty to use the full clipboard row text automatically."
                                                   Foreground="#7B8FA3"
                                                   FontSize="10"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,10"/>

                                        <ItemsControl ItemsSource="{Binding QuickTextActionSteps}" Margin="0,0,0,8">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#2D2D44" CornerRadius="6" Padding="10" Margin="0,0,0,6">
                                                        <StackPanel>
                                                            <DockPanel Margin="0,0,0,6">
                                                                <Button Content="✕" DockPanel.Dock="Right"
                                                                        Command="{Binding DataContext.RemoveClipboardActionStepCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        Background="#5A2727" Foreground="White"
                                                                        FontSize="11" Padding="6,2" Margin="4,0,0,0"
                                                                        BorderThickness="0" Cursor="Hand">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button">
                                                                            <Setter Property="Template">
                                                                                <Setter.Value>
                                                                                    <ControlTemplate TargetType="Button">
                                                                                        <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                        </Border>
                                                                                    </ControlTemplate>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                        </Style>
                                                                    </Button.Style>
                                                                </Button>
                                                                <Button Content="▲" DockPanel.Dock="Right"
                                                                        Command="{Binding DataContext.MoveClipboardActionStepUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        Background="#2D2D44" Foreground="#AAA"
                                                                        FontSize="10" Padding="6,2" Margin="2,0,0,0"
                                                                        BorderThickness="0" Cursor="Hand">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button">
                                                                            <Setter Property="Template">
                                                                                <Setter.Value>
                                                                                    <ControlTemplate TargetType="Button">
                                                                                        <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                        </Border>
                                                                                    </ControlTemplate>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                            <Style.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter Property="Background" Value="#3D3D54"/>
                                                                                </Trigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                </Button>
                                                                <Button Content="▼" DockPanel.Dock="Right"
                                                                        Command="{Binding DataContext.MoveClipboardActionStepDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        Background="#2D2D44" Foreground="#AAA"
                                                                        FontSize="10" Padding="6,2" Margin="2,0,0,0"
                                                                        BorderThickness="0" Cursor="Hand">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button">
                                                                            <Setter Property="Template">
                                                                                <Setter.Value>
                                                                                    <ControlTemplate TargetType="Button">
                                                                                        <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                        </Border>
                                                                                    </ControlTemplate>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                            <Style.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter Property="Background" Value="#3D3D54"/>
                                                                                </Trigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                </Button>
                                                                <ComboBox SelectedItem="{Binding Type, Mode=TwoWay}"
                                                                          ItemsSource="{Binding Source={StaticResource ActionStepTypeValues}}"
                                                                          Style="{StaticResource DarkComboBox}"
                                                                          Margin="0,0,8,0"/>
                                                            </DockPanel>

                                                            <!-- KeyPress fields -->
                                                            <StackPanel x:Name="ClipStepKeyPress" Margin="0,0,0,4">
                                                                <TextBlock Text="Key (SendKeys format)" Foreground="#888" FontSize="11" Margin="0,0,0,2"/>
                                                                <TextBox Text="{Binding KeyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                         Background="#1E1E2E" Foreground="White" FontSize="12" Padding="6,4"
                                                                         BorderBrush="#444" BorderThickness="1"/>
                                                            </StackPanel>

                                                            <!-- TextInput fields -->
                                                            <StackPanel x:Name="ClipStepTextInput" Visibility="Collapsed" Margin="0,0,0,4">
                                                                <TextBlock Text="Text (leave empty to use the clipboard row text)" Foreground="#888" FontSize="11" Margin="0,0,0,2"/>
                                                                <TextBox Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                         Background="#1E1E2E" Foreground="White" FontSize="12" Padding="6,4"
                                                                         BorderBrush="#444" BorderThickness="1"
                                                                         AcceptsReturn="True" TextWrapping="Wrap"
                                                                         MinHeight="40" MaxHeight="80"/>
                                                                <ComboBox SelectedItem="{Binding TextMode, Mode=TwoWay}"
                                                                          ItemsSource="{Binding Source={StaticResource TextModeValues}}"
                                                                          Style="{StaticResource DarkComboBox}"
                                                                          Margin="0,4,0,4"/>
                                                                <CheckBox IsChecked="{Binding PressEnterAfter, Mode=TwoWay}"
                                                                          Content="Press Enter after"
                                                                          Foreground="#CCC" FontSize="12"/>
                                                            </StackPanel>

                                                            <!-- Delay fields -->
                                                            <StackPanel x:Name="ClipStepDelay" Visibility="Collapsed" Margin="0,0,0,4">
                                                                <TextBlock Text="Duration (ms)" Foreground="#888" FontSize="11" Margin="0,0,0,2"/>
                                                                <TextBox Text="{Binding DelayMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                         Background="#1E1E2E" Foreground="White" FontSize="12" Padding="6,4"
                                                                         BorderBrush="#444" BorderThickness="1" Width="80" HorizontalAlignment="Left"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>

                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Type}" Value="KeyPress">
                                                            <Setter TargetName="ClipStepKeyPress" Property="Visibility" Value="Visible"/>
                                                            <Setter TargetName="ClipStepTextInput" Property="Visibility" Value="Collapsed"/>
                                                            <Setter TargetName="ClipStepDelay" Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="TextInput">
                                                            <Setter TargetName="ClipStepKeyPress" Property="Visibility" Value="Collapsed"/>
                                                            <Setter TargetName="ClipStepTextInput" Property="Visibility" Value="Visible"/>
                                                            <Setter TargetName="ClipStepDelay" Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="Delay">
                                                            <Setter TargetName="ClipStepKeyPress" Property="Visibility" Value="Collapsed"/>
                                                            <Setter TargetName="ClipStepTextInput" Property="Visibility" Value="Collapsed"/>
                                                            <Setter TargetName="ClipStepDelay" Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Button Content="+ Add Step"
                                                Command="{Binding AddClipboardActionStepCommand}"
                                                Background="#2D5A27" Foreground="White"
                                                FontSize="12" Padding="10,5"
                                                BorderThickness="0" Cursor="Hand"
                                                HorizontalAlignment="Left">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#3D7A37"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>

                        <Border Background="#252538" CornerRadius="6" Padding="9" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="COLLECTION"
                                           Foreground="#7F92A8"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           Margin="0,0,0,3"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{Binding QuickTextCollections}"
                                              DisplayMemberPath="Name"
                                              SelectedValuePath="Id"
                                              SelectedValue="{Binding SelectedQuickTextCollectionId, Mode=TwoWay}"
                                              Style="{StaticResource DarkComboBox}"/>
                                    <Button Grid.Column="1" Content="+" Command="{Binding AddQuickTextCollectionCommand}"
                                            ToolTip="Add collection" Background="#2D5A27" Foreground="White" BorderThickness="0" Width="30" Margin="6,0,0,0" Cursor="Hand"/>
                                    <Button Grid.Column="2" Content="✎" Click="RenameQuickTextCollection_Click"
                                            ToolTip="Rename collection" Background="#3F4F86" Foreground="White" BorderThickness="0" Width="30" Margin="5,0,0,0" Cursor="Hand"/>
                                    <Button Grid.Column="3" Content="−" Command="{Binding RemoveQuickTextCollectionCommand}"
                                            IsEnabled="{Binding HasMultipleQuickTextCollections}"
                                            ToolTip="Remove collection; its tags are moved to another collection" Background="#5A2727" Foreground="White" BorderThickness="0" Width="30" Margin="5,0,0,0" Cursor="Hand"/>
                                </Grid>

                                <TextBlock Text="TAG"
                                           Foreground="#7F92A8"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           Margin="0,0,0,3"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{Binding QuickTextCategories}"
                                              DisplayMemberPath="Name"
                                              SelectedValuePath="Id"
                                              SelectedValue="{Binding SelectedQuickTextCategoryId, Mode=TwoWay}"
                                              Style="{StaticResource DarkComboBox}"/>
                                    <Button Grid.Column="1" Content="+" Command="{Binding AddQuickTextCategoryCommand}"
                                            ToolTip="Add tag" Background="#2D5A27" Foreground="White" BorderThickness="0" Width="30" Margin="6,0,0,0" Cursor="Hand"/>
                                    <Button Grid.Column="2" Content="✎" Click="RenameQuickTextCategory_Click"
                                            ToolTip="Rename tag" Background="#3F4F86" Foreground="White" BorderThickness="0" Width="30" Margin="5,0,0,0" Cursor="Hand"/>
                                    <Button Grid.Column="3" Content="−" Command="{Binding RemoveQuickTextCategoryCommand}"
                                            IsEnabled="{Binding HasMultipleQuickTextCategories}"
                                            ToolTip="Remove tag" Background="#5A2727" Foreground="White" BorderThickness="0" Width="30" Margin="5,0,0,0" Cursor="Hand"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Export/Import bar -->
                        <Border Background="#252538" CornerRadius="6" Padding="8,6" Margin="0,0,0,8">
                            <WrapPanel>
                                <!-- Export scope -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                                    <TextBlock Text="Export:" Foreground="#8FA3B8" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <Button Content="Tag"
                                            Command="{Binding SetQuickTextExportScopeCommand}"
                                            CommandParameter="Category"
                                            Background="{Binding IsExportScopeCategory, Converter={StaticResource BoolToColor}, ConverterParameter=#2D5A27}"
                                            Foreground="White"
                                            FontSize="10"
                                            Padding="6,2"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Margin="0,0,2,0">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="All"
                                            Command="{Binding SetQuickTextExportScopeCommand}"
                                            CommandParameter="All"
                                            Background="{Binding IsExportScopeAll, Converter={StaticResource BoolToColor}, ConverterParameter=#3F4F86}"
                                            Foreground="White"
                                            FontSize="10"
                                            Padding="6,2"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Margin="0,0,6,0">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="Copy JSON"
                                            Command="{Binding ExportQuickTextCommand}"
                                            Background="#2D5A27"
                                            Foreground="White"
                                            FontSize="10"
                                            FontWeight="SemiBold"
                                            Padding="8,2"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            ToolTip="Copy JSON to clipboard — paste into LLM">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#3D7A37"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>

                                <!-- Import section -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="Import:" Foreground="#8FA3B8" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <Button Content="Replace"
                                            Command="{Binding SetQuickTextImportModeCommand}"
                                            CommandParameter="Replace"
                                            Background="{Binding IsImportModeReplace, Converter={StaticResource BoolToColor}, ConverterParameter=#5A2727}"
                                            Foreground="White"
                                            FontSize="10"
                                            Padding="6,2"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Margin="0,0,2,0">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="Append"
                                            Command="{Binding SetQuickTextImportModeCommand}"
                                            CommandParameter="Append"
                                            Background="{Binding IsImportModeAppend, Converter={StaticResource BoolToColor}, ConverterParameter=#2D5A27}"
                                            Foreground="White"
                                            FontSize="10"
                                            Padding="6,2"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Margin="0,0,6,0">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="Paste JSON"
                                            Command="{Binding ImportQuickTextCommand}"
                                            Background="#3F4F86"
                                            Foreground="White"
                                            FontSize="10"
                                            FontWeight="SemiBold"
                                            Padding="8,2"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            ToolTip="Read JSON from clipboard and import">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#5A6FA0"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </WrapPanel>
                        </Border>

                        <DockPanel Margin="0,0,0,8" LastChildFill="False">
                            <TextBlock Text="Texter i vald kategori"
                                       Foreground="#8FA3B8"
                                       FontSize="11"
                                       VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Right"
                                    Content="+"
                                    Command="{Binding AddQuickTextItemCommand}"
                                    Background="#2D5A27"
                                    Foreground="White"
                                    FontSize="11"
                                    Width="32"
                                    Height="28"
                                    ToolTip="Add row"
                                    BorderThickness="0"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DockPanel>

                        <TextBlock Text="No texts with this tag yet."
                                   Foreground="#777"
                                   FontSize="12"
                                   Margin="0,2,0,8"
                                   Visibility="{Binding HasQuickTextItems, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"/>

                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Style="{StaticResource DarkScrollViewer}"
                                      Visibility="{Binding HasQuickTextItems, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl ItemsSource="{Binding QuickTextItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#2D2D44"
                                                CornerRadius="6"
                                                BorderBrush="#41415A"
                                                BorderThickness="1"
                                                Padding="8"
                                                Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBox Grid.Column="0"
                                                         Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="#1E1E2E"
                                                         Foreground="White"
                                                         FontSize="12"
                                                         Padding="7,5"
                                                         BorderBrush="#444"
                                                         BorderThickness="1"
                                                         TextWrapping="Wrap"
                                                         AcceptsReturn="True"
                                                         MinHeight="34"
                                                         MaxHeight="56"
                                                         VerticalScrollBarVisibility="Auto"
                                                         Margin="0,0,8,0">
                                                    <TextBox.Resources>
                                                        <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}"/>
                                                    </TextBox.Resources>
                                                </TextBox>

                                                <Button Grid.Column="1"
                                                        Content="Duplicate"
                                                        Command="{Binding DataContext.DuplicateQuickTextItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Background="#2A4D7A"
                                                        Foreground="White"
                                                        FontSize="11"
                                                        Padding="8,5"
                                                        Margin="0,0,6,0"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        VerticalAlignment="Center">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <Button Grid.Column="2"
                                                        Content="✕"
                                                        Command="{Binding DataContext.RemoveQuickTextItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Background="#5A2727"
                                                        Foreground="White"
                                                        FontSize="11"
                                                        Padding="8,5"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        VerticalAlignment="Center">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <Expander Grid.Row="1"
                                                          Grid.ColumnSpan="3"
                                                          Margin="0,7,0,0"
                                                          Foreground="#AFC0D2">
                                                    <Expander.Header>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Organize: " FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding CollectionSummary}"
                                                                       Foreground="#8FA4B9"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       MaxWidth="150"/>
                                                            <TextBlock Text=" · " Foreground="#64788E"/>
                                                            <TextBlock Text="{Binding TagSummary}"
                                                                       Foreground="#8FA4B9"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       MaxWidth="150"/>
                                                        </StackPanel>
                                                    </Expander.Header>
                                                    <Border Background="#222234"
                                                            CornerRadius="4"
                                                            Padding="7"
                                                            Margin="0,5,0,0">
                                                        <StackPanel>
                                                            <TextBlock Text="COLLECTIONS" Foreground="#71869C" FontSize="9" FontWeight="Bold" Margin="0,0,0,5"/>
                                                            <ItemsControl ItemsSource="{Binding CollectionAssignments}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <CheckBox Content="{Binding Collection.Name}"
                                                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                                  Foreground="#D5DFEA"
                                                                                  Margin="0,0,12,6"
                                                                                  Cursor="Hand"/>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>

                                                            <TextBlock Text="TAGS" Foreground="#71869C" FontSize="9" FontWeight="Bold" Margin="0,4,0,5"/>
                                                            <ItemsControl ItemsSource="{Binding TagAssignments}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <CheckBox Content="{Binding Category.Name}"
                                                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                                  Foreground="#D5DFEA"
                                                                                  Margin="0,0,12,6"
                                                                                  Cursor="Hand"/>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Border>
                                                </Expander>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                    <!-- ===================== FORMS EDITOR ===================== -->
                    <StackPanel Visibility="{Binding IsFormsEditorMode, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Forms"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="Design fill-in forms for the overlay. Compose the output with {tokens} from fields, counters, and built-ins like {date}."
                                   Foreground="#7B8FA3"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"/>

                        <CheckBox IsChecked="{Binding FormsHistoryCountsTodayOnly, Mode=TwoWay}"
                                  Content="Count only today's submissions on the overlay history button"
                                  ToolTip="Turn this off to show totals for all stored submissions. The history list itself is never filtered."
                                  Foreground="#CCC"
                                  FontSize="11"
                                  Cursor="Hand"
                                  Margin="0,0,0,10"/>

                        <!-- Form picker -->
                        <TextBlock Text="FORM"
                                   Foreground="#7F92A8"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Margin="0,0,0,3"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding FormTemplates}"
                                      SelectedItem="{Binding SelectedFormTemplate, Mode=TwoWay}"
                                      Style="{StaticResource DarkComboBox}">
                                <!-- Explicit template instead of DisplayMemberPath: the DarkComboBox
                                     ControlTemplate only honors SelectionBoxItemTemplate, so the
                                     closed box would otherwise show ToString(). -->
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="1" Content="+" Command="{Binding AddFormTemplateCommand}"
                                    Style="{StaticResource FormsFlatButton}"
                                    ToolTip="Add form" Background="#2D5A27" Width="30" Margin="6,0,0,0"/>
                            <Button Grid.Column="2" Content="⧉" Command="{Binding DuplicateFormTemplateCommand}"
                                    Style="{StaticResource FormsFlatButton}"
                                    ToolTip="Duplicate form" Background="#2A4D7A" Width="30" Margin="5,0,0,0"/>
                            <Button Grid.Column="3" Content="−" Command="{Binding RemoveFormTemplateCommand}"
                                    Style="{StaticResource FormsFlatButton}"
                                    ToolTip="Delete form" Background="#5A2727" Width="30" Margin="5,0,0,0"/>
                        </Grid>

                        <TextBlock Text="No forms yet. Click + to create your first form."
                                   Foreground="#777"
                                   FontSize="12"
                                   Margin="0,2,0,8"
                                   Visibility="{Binding HasSelectedFormTemplate, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"/>

                        <StackPanel Visibility="{Binding HasSelectedFormTemplate, Converter={StaticResource BoolToVisibility}}">

                            <!-- Name -->
                            <TextBlock Text="Name" Foreground="#AAA" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding SelectedFormTemplate.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Background="#1E1E2E" Foreground="White" FontSize="12" Padding="6,4"
                                     BorderBrush="#444" BorderThickness="1"
                                     Margin="0,0,0,8"/>

                            <CheckBox IsChecked="{Binding SelectedFormTemplate.ShowCopyButton, Mode=TwoWay}"
                                      Content="Show a Copy button in the overlay"
                                      ToolTip="Copy puts the rendered text on the clipboard and saves the submission. Off by default so it cannot be hit instead of Save."
                                      Foreground="#CCC" FontSize="12" Cursor="Hand"
                                      Margin="0,0,0,12"/>

                            <!-- Fields -->
                            <DockPanel Margin="0,0,0,4" LastChildFill="False">
                                <TextBlock Text="FIELDS" Foreground="#7F92A8" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Button DockPanel.Dock="Right" Content="+ Field"
                                        Command="{Binding AddFormFieldCommand}"
                                        Style="{StaticResource FormsFlatButton}"
                                        Background="#2D5A27" FontSize="11" Padding="8,4"/>
                            </DockPanel>
                            <TextBlock Text="Label is shown in the overlay. The token key is the field's variable name — write {key} in the output template to place the value there. For Choice fields, {key_choice} gives the selected option title while {key} gives its editable text. The key follows the label automatically until you set your own. Fields can also reference each other: a default value like 'Payment from {who}' fills in the who-field's value live."
                                       Foreground="#7B8FA3" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,6"/>

                            <ItemsControl ItemsSource="{Binding SelectedFormTemplate.Fields}" Margin="0,0,0,6">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#2D2D44" CornerRadius="6" BorderBrush="#41415A" BorderThickness="1" Padding="9" Margin="0,0,0,7">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,6">
                                                    <Button Content="✕" DockPanel.Dock="Right"
                                                            Command="{Binding DataContext.RemoveFormFieldCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource FormsFlatButton}"
                                                            Background="#5A2727" FontSize="11" Padding="6,2" Margin="4,0,0,0"/>
                                                    <Button Content="▼" DockPanel.Dock="Right"
                                                            Command="{Binding DataContext.MoveFormFieldDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource FormsFlatButton}"
                                                            Background="#3D3D54" FontSize="10" Padding="6,2" Margin="2,0,0,0"/>
                                                    <Button Content="▲" DockPanel.Dock="Right"
                                                            Command="{Binding DataContext.MoveFormFieldUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource FormsFlatButton}"
                                                            Background="#3D3D54" FontSize="10" Padding="6,2" Margin="2,0,0,0"/>
                                                    <ComboBox SelectedItem="{Binding Type, Mode=TwoWay}"
                                                              ItemsSource="{Binding Source={StaticResource FormFieldTypeValues}}"
                                                              Style="{StaticResource DarkComboBox}"
                                                              Width="90"
                                                              HorizontalAlignment="Left"/>
                                                </DockPanel>

                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Label" Foreground="#888" FontSize="11" Margin="0,0,0,2"/>
                                                        <TextBox Text="{Binding Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Background="#1E1E2E" Foreground="White" FontSize="12" Padding="6,4"
                                                                 BorderBrush="#444" BorderThickness="1"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Token key" Foreground="#888" FontSize="11" Margin="0,0,0,2"/>
                                                        <TextBox Text="{Binding Key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Background="#1E1E2E" Foreground="#A6E3A1" FontSize="12" Padding="6,4"
                                                                 BorderBrush="#444" BorderThickness="1"
                                                                 ToolTip="Use as {key} in the output template"/>
                                                    </StackPanel>
                                                </Grid>

                                                <TextBlock Text="Default value (supports counter and date tokens)" Foreground="#888" FontSize="11" Margin="0,0,0,2"/>
                                                <TextBox Text="{Binding DefaultValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="#1E1E2E" Foreground="White" FontSize="12" Padding="6,4"
                                                         BorderBrush="#444" BorderThickness="1"
                                                         Margin="0,0,0,6"/>

                                                <WrapPanel Margin="0,0,0,2">
                                                    <CheckBox IsChecked="{Binding IsMultiline, Mode=TwoWay}"
                                                              Content="Multiline"
                                                              Foreground="#CCC" FontSize="12" Margin="0,0,14,0" Cursor="Hand"/>
                                                    <CheckBox IsChecked="{Binding RememberHistory, Mode=TwoWay}"
                                                              Content="Suggest previous entries"
                                                              ToolTip="Stores submitted values and offers them as autocomplete suggestions in the overlay"
                                                              Foreground="#CCC" FontSize="12" Margin="0,0,14,0" Cursor="Hand"/>
                                                    <CheckBox IsChecked="{Binding AllowHistoryEditing, Mode=TwoWay}"
                                                              Content="Allow quick edit in history"
                                                              ToolTip="Allows this field to be corrected by double-clicking its value in the overlay history"
                                                              Foreground="#CCC" FontSize="12" Cursor="Hand"/>
                                                </WrapPanel>

                                                <!-- Choice options -->
                                                <StackPanel x:Name="FormFieldOptionsPanel" Visibility="Collapsed" Margin="0,6,0,0">
                                                    <TextBlock Text="OPTIONS (selecting one prefills the editable text)" Foreground="#71869C" FontSize="9" FontWeight="Bold" Margin="0,0,0,4"/>
                                                    <ItemsControl ItemsSource="{Binding Options}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,0,0,5">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="110"/>
                                                                        <ColumnDefinition Width="6"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBox Text="{Binding Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                             ToolTip="Shown in the dropdown"
                                                                             Background="#1E1E2E" Foreground="White" FontSize="11" Padding="5,4"
                                                                             BorderBrush="#444" BorderThickness="1"/>
                                                                    <TextBox Grid.Column="2"
                                                                             Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                             ToolTip="Prefilled text when this option is chosen"
                                                                             Background="#1E1E2E" Foreground="White" FontSize="11" Padding="5,4"
                                                                             BorderBrush="#444" BorderThickness="1"
                                                                             AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="60"/>
                                                                    <Button Grid.Column="3" Content="✕"
                                                                            Command="{Binding DataContext.RemoveFormFieldOptionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}"
                                                                            Style="{StaticResource FormsFlatButton}"
                                                                            Background="#5A2727" FontSize="11" Padding="6,2" Margin="5,0,0,0"
                                                                            VerticalAlignment="Top"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <Button Content="+ Option"
                                                            Command="{Binding DataContext.AddFormFieldOptionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource FormsFlatButton}"
                                                            Background="#2D5A27" FontSize="11" Padding="8,3"
                                                            HorizontalAlignment="Left"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Type}" Value="Choice">
                                                <Setter TargetName="FormFieldOptionsPanel" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Counters -->
                            <DockPanel Margin="0,6,0,6" LastChildFill="False">
                                <TextBlock Text="COUNTERS" Foreground="#7F92A8" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Button DockPanel.Dock="Right" Content="+ Counter"
                                        Command="{Binding AddFormCounterCommand}"
                                        Style="{StaticResource FormsFlatButton}"
                                        Background="#2D5A27" FontSize="11" Padding="8,4"/>
                            </DockPanel>
                            <TextBlock Text="A counter is an automatic number, e.g. an invoice number. It increases by 1 every time the form is saved. Use it as {name} in a field default or the output template. Digits 3 makes it 001, 002, 003 …"
                                       Foreground="#7B8FA3" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="27"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="TOKEN NAME" Foreground="#71869C" FontSize="9" FontWeight="Bold"/>
                                <TextBlock Grid.Column="2" Text="NEXT VALUE" Foreground="#71869C" FontSize="9" FontWeight="Bold"/>
                                <TextBlock Grid.Column="4" Text="DIGITS" Foreground="#71869C" FontSize="9" FontWeight="Bold"/>
                                <TextBlock Grid.Column="6" Text="SHOWS AS" Foreground="#71869C" FontSize="9" FontWeight="Bold"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding SelectedFormTemplate.Counters}" Margin="0,0,0,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="Token name — use as {name} in templates"
                                                     Background="#1E1E2E" Foreground="#A6E3A1" FontSize="12" Padding="6,4"
                                                     BorderBrush="#444" BorderThickness="1"/>
                                            <TextBox Grid.Column="2"
                                                     Text="{Binding NextValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="The number the next submission will get"
                                                     Background="#1E1E2E" Foreground="White" FontSize="12" Padding="6,4"
                                                     BorderBrush="#444" BorderThickness="1"/>
                                            <TextBox Grid.Column="4"
                                                     Text="{Binding PadWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="Minimum number of digits, filled with zeros: 3 gives 001, 002 … (0 = plain number)"
                                                     Background="#1E1E2E" Foreground="White" FontSize="12" Padding="6,4"
                                                     BorderBrush="#444" BorderThickness="1"/>
                                            <Border Grid.Column="6"
                                                    Background="#222234" CornerRadius="4" Padding="6,4">
                                                <TextBlock Text="{Binding FormattedPreview}"
                                                           Foreground="#B9C7D6" FontSize="12" FontFamily="Consolas"
                                                           HorizontalAlignment="Center"/>
                                            </Border>
                                            <Button Grid.Column="7" Content="✕"
                                                    Command="{Binding DataContext.RemoveFormCounterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource FormsFlatButton}"
                                                    Background="#5A2727" FontSize="11" Padding="6,2" Margin="5,0,0,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Output template -->
                            <TextBlock Text="OUTPUT TEMPLATE" Foreground="#7F92A8" FontSize="9" FontWeight="Bold" Margin="0,4,0,4"/>
                            <TextBlock Text="The final text produced when the form is saved — what lands on the clipboard or gets typed into the game. Write anything and drop in {tokens} where field values should go. Leave empty to get one 'Label: value' line per field."
                                       Foreground="#7B8FA3" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <TextBox x:Name="FormOutputTemplateBox"
                                     Text="{Binding SelectedFormTemplate.OutputTemplate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Background="#1E1E2E" Foreground="White" FontSize="12" Padding="6,5"
                                     BorderBrush="#444" BorderThickness="1"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="64" MaxHeight="140"
                                     VerticalScrollBarVisibility="Auto"
                                     Margin="0,0,0,6"/>
                            <TextBlock Text="Click to insert at cursor:" Foreground="#7B8FA3" FontSize="10" Margin="0,0,0,3"/>
                            <ItemsControl ItemsSource="{Binding FormTokenSuggestions}" Margin="0,0,0,6">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding}"
                                                ContentStringFormat="{}{{{0}}}"
                                                Click="InsertFormToken_Click"
                                                Style="{StaticResource FormsFlatButton}"
                                                Background="#33415C" Foreground="#C6D4E4"
                                                FontSize="10" Padding="7,3" Margin="0,0,5,5"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding FormTemplateWarningText}"
                                       Foreground="#F38BA8"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,6"
                                       Visibility="{Binding HasFormTemplateWarning, Converter={StaticResource BoolToVisibility}}"/>

                            <!-- Preview -->
                            <TextBlock Text="PREVIEW" Foreground="#7F92A8" FontSize="9" FontWeight="Bold" Margin="0,4,0,4"/>
                            <Border Background="#222234" CornerRadius="6" BorderBrush="#41415A" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                                <TextBlock Text="{Binding FormEditorPreviewText}"
                                           Foreground="#B9C7D6"
                                           FontSize="12"
                                           FontFamily="Consolas"
                                           TextWrapping="Wrap"/>
                            </Border>

                            <!-- Send pipeline -->
                            <Expander Foreground="#AFC0D2" Margin="0,0,0,10">
                                <Expander.Header>
                                    <TextBlock Text="Send action (optional)" FontWeight="SemiBold"/>
                                </Expander.Header>
                                <Border Background="#222234" CornerRadius="4" Padding="8" Margin="0,5,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Steps run against the previously focused window when you press Send in the overlay. TextInput steps can use {{clipboardText}} for the rendered form text; an empty text uses it automatically. Without steps, only Copy is available."
                                                   Foreground="#7B8FA3" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        <ItemsControl ItemsSource="{Binding SelectedFormTemplate.ActionSteps}" Margin="0,0,0,8">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#2D2D44" CornerRadius="6" Padding="10" Margin="0,0,0,6">
                                                        <StackPanel>
                                                            <DockPanel Margin="0,0,0,6">
                                                                <Button Content="✕" DockPanel.Dock="Right"
                                                                        Command="{Binding DataContext.RemoveFormActionStepCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        Style="{StaticResource FormsFlatButton}"
                                                                        Background="#5A2727" FontSize="11" Padding="6,2" Margin="4,0,0,0"/>
                                                                <Button Content="▲" DockPanel.Dock="Right"
                                                                        Command="{Binding DataContext.MoveFormActionStepUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        Style="{StaticResource FormsFlatButton}"
                                                                        Background="#3D3D54" FontSize="10" Padding="6,2" Margin="2,0,0,0"/>
                                                                <Button Content="▼" DockPanel.Dock="Right"
                                                                        Command="{Binding DataContext.MoveFormActionStepDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        Style="{StaticResource FormsFlatButton}"
                                                                        Background="#3D3D54" FontSize="10" Padding="6,2" Margin="2,0,0,0"/>
                                                                <ComboBox SelectedItem="{Binding Type, Mode=TwoWay}"
                                                                          ItemsSource="{Binding Source={StaticResource ActionStepTypeValues}}"
                                                                          Style="{StaticResource DarkComboBox}"
                                                                          Margin="0,0,8,0"/>
                                                            </DockPanel>

                                                            <StackPanel x:Name="FormStepKeyPress" Margin="0,0,0,4">
                                                                <TextBlock Text="Key (SendKeys format)" Foreground="#888" FontSize="11" Margin="0,0,0,2"/>
                                                                <TextBox Text="{Binding KeyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                         Background="#1E1E2E" Foreground="White" FontSize="12" Padding="6,4"
                                                                         BorderBrush="#444" BorderThickness="1"/>
                                                            </StackPanel>

                                                            <StackPanel x:Name="FormStepTextInput" Visibility="Collapsed" Margin="0,0,0,4">
                                                                <TextBlock Text="Text (leave empty to use the rendered form text)" Foreground="#888" FontSize="11" Margin="0,0,0,2"/>
                                                                <TextBox Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                         Background="#1E1E2E" Foreground="White" FontSize="12" Padding="6,4"
                                                                         BorderBrush="#444" BorderThickness="1"
                                                                         AcceptsReturn="True" TextWrapping="Wrap"
                                                                         MinHeight="40" MaxHeight="80"/>
                                                                <ComboBox SelectedItem="{Binding TextMode, Mode=TwoWay}"
                                                                          ItemsSource="{Binding Source={StaticResource TextModeValues}}"
                                                                          Style="{StaticResource DarkComboBox}"
                                                                          Margin="0,4,0,4"/>
                                                                <CheckBox IsChecked="{Binding PressEnterAfter, Mode=TwoWay}"
                                                                          Content="Press Enter after"
                                                                          Foreground="#CCC" FontSize="12"/>
                                                            </StackPanel>

                                                            <StackPanel x:Name="FormStepDelay" Visibility="Collapsed" Margin="0,0,0,4">
                                                                <TextBlock Text="Duration (ms)" Foreground="#888" FontSize="11" Margin="0,0,0,2"/>
                                                                <TextBox Text="{Binding DelayMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                         Background="#1E1E2E" Foreground="White" FontSize="12" Padding="6,4"
                                                                         BorderBrush="#444" BorderThickness="1" Width="80" HorizontalAlignment="Left"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Type}" Value="KeyPress">
                                                            <Setter TargetName="FormStepKeyPress" Property="Visibility" Value="Visible"/>
                                                            <Setter TargetName="FormStepTextInput" Property="Visibility" Value="Collapsed"/>
                                                            <Setter TargetName="FormStepDelay" Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="TextInput">
                                                            <Setter TargetName="FormStepKeyPress" Property="Visibility" Value="Collapsed"/>
                                                            <Setter TargetName="FormStepTextInput" Property="Visibility" Value="Visible"/>
                                                            <Setter TargetName="FormStepDelay" Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="Delay">
                                                            <Setter TargetName="FormStepKeyPress" Property="Visibility" Value="Collapsed"/>
                                                            <Setter TargetName="FormStepTextInput" Property="Visibility" Value="Collapsed"/>
                                                            <Setter TargetName="FormStepDelay" Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Content="+ Add Step"
                                                Command="{Binding AddFormActionStepCommand}"
                                                Style="{StaticResource FormsFlatButton}"
                                                Background="#2D5A27" FontSize="12" Padding="10,5"
                                                HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Border>
                            </Expander>
                        </StackPanel>

                        <!-- Submission history -->
                        <Expander Foreground="#AFC0D2" Margin="0,0,0,10">
                            <Expander.Header>
                                <TextBlock Text="History (submitted forms)" FontWeight="SemiBold"/>
                            </Expander.Header>
                            <Border Background="#222234" CornerRadius="4" Padding="8" Margin="0,5,0,0">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8" LastChildFill="False">
                                        <TextBlock Text="Stored locally in form-data.json, outside the profile."
                                                   Foreground="#7B8FA3" FontSize="10" VerticalAlignment="Center"/>
                                        <Button DockPanel.Dock="Right" Content="Clear all"
                                                Command="{Binding ClearFormSubmissionsCommand}"
                                                Style="{StaticResource FormsFlatButton}"
                                                Background="#5A2727" FontSize="10" Padding="8,3"
                                                Visibility="{Binding HasFormSubmissions, Converter={StaticResource BoolToVisibility}}"/>
                                    </DockPanel>
                                    <TextBlock Text="No submissions yet."
                                               Foreground="#777" FontSize="12"
                                               Visibility="{Binding HasFormSubmissions, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"/>
                                    <ItemsControl ItemsSource="{Binding FormSubmissions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#2D2D44" CornerRadius="6" BorderBrush="#41415A" BorderThickness="1" Padding="8" Margin="0,0,0,6">
                                                    <StackPanel>
                                                        <DockPanel Margin="0,0,0,4">
                                                            <Button Content="✕" DockPanel.Dock="Right"
                                                                    Command="{Binding DataContext.DeleteFormSubmissionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource FormsFlatButton}"
                                                                    Background="#5A2727" FontSize="10" Padding="6,2" Margin="4,0,0,0"/>
                                                            <Button Content="Copy" DockPanel.Dock="Right"
                                                                    Command="{Binding DataContext.CopyFormSubmissionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource FormsFlatButton}"
                                                                    Background="#2A4D7A" FontSize="10" Padding="8,2" Margin="4,0,0,0"/>
                                                            <TextBlock Text="{Binding TemplateName}" Foreground="#EAF2FA" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding CreatedText}" Foreground="#71859A" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                            <TextBlock Text="✓ done" Foreground="#A6E3A1" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"
                                                                       Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisibility}}"/>
                                                        </DockPanel>
                                                        <TextBlock Text="{Binding RenderedText}"
                                                                   Foreground="#B9C7D6" FontSize="11" FontFamily="Consolas"
                                                                   TextWrapping="Wrap" MaxHeight="80" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Expander>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
    </Grid>
</Window>
